    async function cargarPlantasAsignadas(usuarioId) {
        try {
            const select = document.getElementById("_plantaAsignada");
            if (!select) return;

            // limpiar y poner opción por defecto
            select.innerHTML = '<option value="">Seleccione una planta</option>';

            if (!usuarioId || isNaN(usuarioId)) {
                console.warn("usuarioId inválido:", usuarioId);
                return;
            }

            const res = await fetch(`/User/GetPlantasAsignadas?userId=${encodeURIComponent(usuarioId)}`, {
                credentials: "same-origin"
            });
            if (!res.ok) throw new Error("Error al obtener plantas asignadas");

            const data = await res.json();

            // Normaliza: admite [1,2,3] o [{PlantaID, Descripcion}]
            const items = (data || []).map(x => {
                if (typeof x === "number") return { id: x, text: `Planta ${x}` };
                const id = x.PlantaID ?? x.Id ?? x.plantaId ?? x.plantaID;
                const text = x.Descripcion ?? x.Nombre ?? `Planta ${id}`;
                return { id: Number(id), text };
            }).filter(it => Number.isInteger(it.id));

            // Rellenar select
            items.forEach(p => {
                const opt = document.createElement("option");
                opt.value = p.id;
                opt.textContent = p.text;
                select.appendChild(opt);
            });

        } catch (err) {
            console.error("Error cargando plantas asignadas", err);
        }
    }

    // Cargar al iniciar con el usuario real del hidden
    document.addEventListener("DOMContentLoaded", function () {
        const hidden = document.getElementById("usuarioId");
        const userId = parseInt(hidden?.value, 10);
        cargarPlantasAsignadas(userId);
    });

