    function cerrarReporte() {
    const fecha = document.getElementById('fechaReporte').value;
    const boton = document.getElementById('btnCerrarReporte');

    if (!fecha) {
        alert("Por favor selecciona una fecha.");
        return;
    }

    // Desactivar el botón para evitar múltiples clics
    boton.disabled = true;

    const url = '@Url.Action("CerrarReporte", "Downtime")';

    fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ fecha: fecha })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Cambiar ícono del candado
            document.getElementById("candado").innerHTML = `<i class="bi bi-lock-fill text-warning ms-2"></i>`;

            // Mostrar alerta
            const alerta = document.getElementById("alertsuccesclose");
            alerta.style.display = "block";

            // Guardar bandera para mostrar botón después de recargar
            localStorage.setItem('mostrarFlecha', 'true');

            // Esperar 3 segundos y recargar
            setTimeout(() => {
                alerta.style.display = "none";
                location.reload();
            }, 3000);
        } else {
            alert(data.message || "No se pudo cerrar el reporte.");
            boton.disabled = false;
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert("Ocurrió un error al intentar cerrar el reporte.");
        boton.disabled = false;
    });
}


