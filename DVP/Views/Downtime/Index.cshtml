    function formatearFecha(fechaDotNet) {
        const timestamp = parseInt(fechaDotNet.match(/\d+/)[0]);
        const fecha = new Date(timestamp);
        const opciones = {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false
        };
        return fecha.toLocaleString('es-ES', opciones).replace(',', '');
    }


    let equipoSeleccionadoId = null;
    function filtrarPorEquipo(equipoId) {
        equipoSeleccionadoId = equipoId;

        // Filtrar filas por equipo
        const todasFilas = document.querySelectorAll('#downtimeTableBody tr, #downtimeTableBodyInactiveList tr');
        let contadorVisibles = 0;

        todasFilas.forEach(fila => {
            const filaEquipoId = fila.getAttribute('data-equipo-id');
            if (filaEquipoId === equipoId.toString()) {
                fila.style.display = '';
                contadorVisibles++;
            } else {
                fila.style.display = 'none';
            }
        });

        // Restaurar estilos originales a todos los botones
        const botonesEquipo = document.querySelectorAll('.equipo-btn');
        botonesEquipo.forEach(btn => {
            btn.className = 'btn btn-outline-dark m-1 equipo-btn';
        });

        // Aplicar estilo sombreado al botón seleccionado
        const botonSeleccionado = document.querySelector(`.equipo-btn[value="${equipoId}"]`);
        if (botonSeleccionado) {
            botonSeleccionado.className = 'btn btn-dark m-1 equipo-btn';
        }

        // Actualizar el contador si existe el contenedor
        const countWrap = document.getElementById("downtimeCountContainer");
        const countSpan = document.getElementById("countEventosRelacionados");
        if (countWrap && countSpan) {
            countSpan.textContent = contadorVisibles;
            countWrap.style.display = 'block';
        }
    }




    function filtrarPorFecha() {
    const fecha = document.getElementById("fechaReporte").value;

    if (fecha) {
        fetch('@Url.Action("GetDowntimesByDate", "Downtime")?fecha=' + fecha)
            .then(response => response.json())
            .then(data => {
                const activeTbody = document.getElementById("downtimeTableBody");
                const inactiveTbody = document.getElementById("downtimeTableBodyInactiveList");

                if (!activeTbody || !inactiveTbody) {
                    console.error("No se encontraron los TBODYs en el DOM.");
                    return;
                }

                // Limpiar ambos TBODYs
                activeTbody.innerHTML = "";
                inactiveTbody.innerHTML = "";

                // Reiniciar contador al cambiar la fecha
                const countWrap = document.getElementById("downtimeCountContainer");
                const countSpan = document.getElementById("countEventosRelacionados");
                if (countWrap && countSpan) {
                    countSpan.textContent = "0";
                    countWrap.style.display = "none";
                }

                // Poblar con los datos recibidos
                data.forEach(item => {
                    if (item._tipoEventoId === 1) {
                        const rowHtmlInactivo = `
                            <tr data-equipo-id="${item._equipoId}" data-paro-id="${item._paroId}">
                                <td>
                                    <button type="button"
                                            class="btn btn-outline-dark m-1 tipo-evento-btn"
                                            onclick="loadRelatedDowntimes(${item._paroId})"
                                            data-paro-id="${item._paroId}"
                                            data-paro-rel="${item._paroRelacionadoId}">
                                        Details
                                    </button>
                                </td>
                                <td class="horas-cell text-center"></td>
                            </tr>`;
                        inactiveTbody.insertAdjacentHTML("beforeend", rowHtmlInactivo);
                    }
                });

                // Si ya había un equipo seleccionado, reaplicar el filtro
                if (equipoSeleccionadoId !== null) {
                    filtrarPorEquipo(equipoSeleccionadoId);
                }
            })
            .catch(error => {
                console.error("Error al obtener los paros:", error);
            });
    }
}






    function loadRelatedDowntimes(paroId) {
    if (!equipoSeleccionadoId) {
        alert("Debe seleccionar un equipo antes de continuar.");
        return;
    }

    cargando();

    fetch('@Url.Action("GetDowntimesByInactive", "Downtime")?paroId=' + paroId)
        .then(response => {
            if (!response.ok) throw new Error("Error al obtener eventos.");
            return response.json();
        })
        .then(data => {
            const downtimeTbody = document.getElementById('downtimeTableBody');
            downtimeTbody.innerHTML = ''; // limpiar tabla

            // filtrar y ordenar
            const eventosValidos = (data || [])
                .filter(item => item._statusDelete !== true)
                .sort((a, b) => {
                    const aMatch = (a._fechaEvento || "").toString().match(/\d+/);
                    const bMatch = (b._fechaEvento || "").toString().match(/\d+/);
                    const aTicks = aMatch ? parseInt(aMatch[0]) : 0;
                    const bTicks = bMatch ? parseInt(bMatch[0]) : 0;
                    return aTicks - bTicks;
                });

            // helper para armar el display de clasificacion
            const buildClasificacionDisplay = (item) => {
                // prioridad: campo ya listo del backend
                if (item._clasificacionDisplay && item._clasificacionDisplay.toString().trim().length > 0) {
                    return item._clasificacionDisplay;
                }
                // fallback: armar con nombre de clasificacion y tipo paro si viene
                const clas = (item._clasificacionName || "").toString().trim();
                const tipoParo = (item._tipoParoDescripcion || "").toString().trim();
                if (clas && tipoParo) return `${clas} (${tipoParo})`;
                if (clas) return clas;
                return ""; // vacio => se mostrara "Evento Activo"
            };

            // pintar filas
            eventosValidos.forEach(item => {
                const clasDisplay = buildClasificacionDisplay(item);
                const badgeClass = clasDisplay ? 'bg-success' : 'bg-warning';
                const badgeText  = clasDisplay || 'Evento Activo';

                const rowHtmlActivo = `
                <tr data-equipo-id="${item._equipoId}">
                    <td class="text-center bg-white">
                        <span class="d-inline-flex align-items-center gap-1">
                            ${item._cerrado === true
                                ? '<i class="bi bi-lock-fill text-warning fs-5" title="Paro cerrado"></i>'
                                : '<i class="bi bi-unlock-fill text-warning fs-5" title="Paro abierto"></i>'}
                            ${item._statusValidate
                                ? '<i class="fas fa-check-circle text-success fs-4" title="Validado"></i>'
                                : '<i class="fas fa-times-circle text-danger fs-4" title="No validado"></i>'}
                        </span>
                    </td>
                    <td class="text-center bg-white"><strong>${item._tipoEventoName || ''}</strong></td>
                    <td class="text-center bg-white">${formatearFecha(item._fechaEvento)}</td>
                    <td class="text-center bg-white">
                        <span class="badge rounded-pill px-3 py-2 ${badgeClass}">
                            ${badgeText}
                        </span>
                    </td>
                    <td class="text-center bg-white">
                        <div class="dropdown">
                            <button class="btn btn-outline-dark dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    data-id="${item._paroId}">
                                <i class="fas fa-bars"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="javascript:void(0)" onclick="openEditModal(${item._paroId})"><i class="bi bi-pencil me-2"></i> Editar evento</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0)" onclick="newActiveEvent(${item._paroId})"><i class="ti ti-calendar me-2"></i> Agregar arranque</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0)" onclick="openReclasificationModal(${item._paroId})"><i class="ti ti-exchange me-2"></i> Reclasificar evento</a></li>
                                <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="opendeleteDowntime(${item._paroId})"><i class="ti ti-trash me-2"></i> Eliminar evento</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0)" onclick="openDaydelayModal(${item._paroId})"><i class="ti ti-hourglass-empty me-2"></i> Agregar day delay</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>`;
                downtimeTbody.insertAdjacentHTML('beforeend', rowHtmlActivo);
            });

            // sombrear boton activo
            const botonesDowntime = document.querySelectorAll('.tipo-evento-btn');
            botonesDowntime.forEach(btn => { btn.className = 'btn btn-outline-dark m-1 tipo-evento-btn'; });

            const botonActivo = Array.from(botonesDowntime).find(b => b.getAttribute('data-paro-id') == paroId);
            if (botonActivo) botonActivo.className = 'btn btn-dark m-1 tipo-evento-btn';

            // mostrar diferencia en horas en la fila inactiva origen
            const eventoBase = (data || []).find(item => item._paroId === paroId);
            if (eventoBase && typeof eventoBase._diferenciaEnHoras !== 'undefined' && eventoBase._diferenciaEnHoras !== null) {
                const filaInactiva = document.querySelector(`#downtimeTableBodyInactiveList tr[data-paro-id="${paroId}"]`);
                if (filaInactiva) {
                    const celdaHoras = filaInactiva.querySelector('.horas-cell');
                    if (celdaHoras) {
                        try {
                            celdaHoras.textContent = Number(eventoBase._diferenciaEnHoras / 60).toFixed(2);
                        } catch (e) {
                            // si viene en minutos y quieres mostrar minutos, usa:
                            // celdaHoras.textContent = Number(eventoBase._diferenciaEnHoras).toFixed(2);
                            celdaHoras.textContent = eventoBase._diferenciaEnHoras;
                        }
                    }
                }
            }
        })
        .catch(error => {
            console.error('Error al cargar eventos relacionados:', error);
        })
        .finally(() => {
            // ocultar modal de carga
            document.getElementById("loadingModal").style.display = "none";
        });
}





    //****************************************************** Funciones para crear active event ****************************************/


    function newActiveEvent(paroId) {
        fetch(`${getParoByIdUrl}?paroId=${paroId}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const paro = data.data;

                    // Convertir fecha .NET a objeto Date
                    const match = paro._fechaEvento.match(/\/Date\((\d+)\)\//);
                    const timestamp = match ? parseInt(match[1], 10) : null;

                    if (!timestamp) {
                        alert("Fecha del paro inválida.");
                        return;
                    }

                    const fecha = new Date(timestamp);
                    const fechaStr = fecha.toISOString().split('T')[0]; // yyyy-MM-dd
                    const horaStr = fecha.toTimeString().split(' ')[0]; // HH:mm:ss

                    // Asignar valores al formulario del modal
                    document.getElementById('paroIdtoAddActiveEventHidden').value = paro._paroId;

                    const fechaInput = document.getElementById('_fechaActiveEvent');
                    fechaInput.value = fechaStr;

                    // Fijar límites para solo el mes actual
                    const primerDiaMes = new Date(fecha.getFullYear(), fecha.getMonth(), 1);
                    const ultimoDiaMes = new Date(fecha.getFullYear(), fecha.getMonth() + 1, 0);
                    fechaInput.min = primerDiaMes.toISOString().split('T')[0];
                    fechaInput.max = ultimoDiaMes.toISOString().split('T')[0];

                    // Mostrar modal
                    const modal = new bootstrap.Modal(document.getElementById('activeModal'));
                    modal.show();
                } else {
                    alert(data.message);
                }
            })
            .catch(error => {
                console.error("Error al obtener el paro:", error);
                alert("Ocurrió un error al obtener el paro.");
            });
    }



    document.getElementById('createActiveEvent').addEventListener('click', () => {

    const button = document.getElementById('createActiveEvent');
    button.disabled = true;
    button.textContent = "Procesando...";

    const paroId = document.getElementById('paroIdtoAddActiveEventHidden').value;
    const _commentActiveEvent = document.getElementById('_commentActiveEvent').value;
    const _usuarioCreadorID = document.getElementById('usuarioId').value;
    const fecha = document.getElementById('_fechaActiveEvent').value;
    const hora = document.getElementById('_horaActiveEvent').value;


    if (!fecha || !hora) {
        alert("Todos los campos son obligatorios.");
        button.disabled = false;
        button.textContent = "Validate ✔";
        return;
    }

    // Validar segundos
    const partesHora = hora.split(':');
    if (partesHora.length === 3) {
        const segundos = parseInt(partesHora[2], 10);
        if (segundos > 59) {
            alert("Los segundos no pueden ser mayores a 59.");
            button.disabled = false;
            button.textContent = "Validate ✔";
            return;
        }
    }

    const fechaEvento = new Date(`${fecha}T${hora}`);

    const payload = {
        _paroId: parseInt(paroId),
        _fechaEvento: fechaEvento.toISOString(),
        _comment: _commentActiveEvent,
        _usuarioCreadorID: _usuarioCreadorID

    };

    cargando();

    fetch('@Url.Action("AddActiveEvent", "Downtime")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            document.getElementById('alertValidateactiveEvent').style.display = 'block';
            const modal = bootstrap.Modal.getInstance(document.getElementById('activeModal'));
            modal.hide();

            setTimeout(() => {
                location.reload();
            }, 3000);
        } else {
            alert(result.message || "Ocurrió un error.");
            button.disabled = false;
            button.textContent = "Validate ✔";
            document.getElementById("loadingModal").style.display = "none";
        }
    })
    .catch(error => {
        console.error("Error al enviar el paro activo:", error);
        alert("Ocurrió un error al enviar el paro activo.");
        button.disabled = false;
        button.textContent = "Validate ✔";
        document.getElementById("loadingModal").style.display = "none";
    });
});









