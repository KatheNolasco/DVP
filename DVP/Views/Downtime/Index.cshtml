    //________________________________________________________________________ Llamar el script de python para descargar paros _____________________________________//

    document.addEventListener("DOMContentLoaded", function () {
        const btn = document.getElementById("btnDescargarDowntime");
        const fechaInput = document.getElementById("fechaReporte");
        const alertaOk = document.getElementById("alertsuccesclose");

        btn.addEventListener("click", async function () {
            // Tomar fecha o usar hoy
            let fecha = fechaInput?.value;
            if (!fecha) {
                const hoy = new Date();
                const yyyy = hoy.getFullYear();
                const mm = String(hoy.getMonth() + 1).padStart(2, '0');
                const dd = String(hoy.getDate()).padStart(2, '0');
                fecha = `${yyyy}-${mm}-${dd}`;
            }

            const url = `/Downtime/EjecutarScript?fecha=${encodeURIComponent(fecha)}`;

            // Mostrar cargando
            cargando();
            btn.disabled = true;

            try {
                const resp = await fetch(url, {
                    method: "GET",
                    headers: { "Accept": "application/json" }
                });
                if (!resp.ok) throw new Error(`Status ${resp.status}`);

                const data = await resp.json();
                if (!data?.success) throw new Error(data?.error || "Fallo al ejecutar el script.");

                // ÉXITO: mostrar alerta y recargar
                alertaOk.style.display = "block";
                setTimeout(() => {
                    location.reload();
                }, 1200);
            } catch (err) {
                console.error(err);
                alert("Ocurrió un error al ejecutar el script. Revisa la consola.");
            } finally {
                // Ocultar cargando en el mismo bloque
                document.getElementById("loadingModal").style.display = "none";
                btn.disabled = false;
            }
        });
    });




