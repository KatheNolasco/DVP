    async function guardarDesdeCreateOverlay(keepOpen){
        const btn      = createEl.querySelector('#cr_guardar');
        const btnKeep  = createEl.querySelector('#cr_guardar_keep');
        btn.disabled = true; btnKeep.disabled = true;

        try{
            const matProdId = Number(createEl.querySelector('#cr_matProd')?.value||0);
            const factorVal = createEl.querySelector('#cr_factor')?.value;
            const factor = (factorVal==='')?0:Number(factorVal);

            const equipoSel = createEl.querySelector('#cr_equipoSel');
            const equipoIds = Array.from((equipoSel?.options||[])).filter(o=>o.selected && o.value).map(o=>Number(o.value));

            const matSel = createEl.querySelector('#cr_matConsSel');
            const matConsIds = Array.from((matSel?.options||[])).filter(o=>o.selected && o.value).map(o=>Number(o.value));

            const prodSeca = !!createEl.querySelector('#cr_prodSeca')?.checked;
            const prodHum  = !!createEl.querySelector('#cr_prodHum')?.checked;

            const conSeco = !!createEl.querySelector('#cr_conSeco')?.checked;
            const conHum  = !!createEl.querySelector('#cr_conHum')?.checked;

            if(!matProdId || !equipoIds.length || !matConsIds.length){
                alert('Completa: Material Producción, al menos un Equipo y al menos un Material de Consumo.');
                return;
            }
            if(prodSeca && prodHum){
                alert('Prod Seca y Prod Húmeda no pueden estar ambos activos.');
                return;
            }
            if(conSeco && conHum){
                alert('Cons Seco y Cons Húmedo no pueden estar ambos activos.');
                return;
            }

            // Importante: NO enviar _tipoMovimientoSAPID
            const calls = equipoIds.map(eqId=>{
                const payload={
                    _materialProduccionIDs:[matProdId],
                    _materialConsumoIDs:   matConsIds,
                    _equipoID:             eqId,
                    _factorConsumo:        Number.isFinite(factor)?factor:0,
                    _produccionSeca:       prodSeca,
                    _produccionHumeda:     prodHum,
                    _consumoSeco:          conSeco,
                    _consumoHumedo:        conHum
                };
                return fetch(URL_CREATE_BOM, {
                    method:'POST',
                    headers:{'Content-Type':'application/json'},
                    body:JSON.stringify(payload)
                }).then(r=>r.json());
            });

            const results = await Promise.allSettled(calls);
            const oks   = results.filter(x=>x.status==='fulfilled' && x.value && x.value.success);
            const fails = results.filter(x=>x.status!=='fulfilled' || !x.value || !x.value.success);

            if(oks.length){
                recargarTablaActual(matProdId);
                if(!keepOpen) hideCreateOverlay();
            }
            if(fails.length){
                const msg = fails.map(x=> (x.value && x.value.message) ? x.value.message : 'Fallo al crear').join('\n');
                alert(`Algunas inserciones fallaron (${fails.length}/${results.length}).\n${msg}`);
            }
        }catch(e){
            console.error(e);
            alert('Error al crear BOM.');
        }finally{
            btn.disabled = false; btnKeep.disabled = false;
        }
    }

