@model DVP.Models.BillOfMaterialViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Downtime Page";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<style>
    /* Estilo para el contenedor de la fecha y hora */
    .container {
        font-family: Arial, sans-serif;
        display: flex; /* Usamos flex para alinearlos horizontalmente */
        justify-content: center; /* Centra los elementos horizontalmente */
        align-items: center; /* Centra los elementos verticalmente */
        gap: 20px; /* Espacio entre los divs */
        margin-top: 20px;
    }
    /* Estilo para los divs de fecha y hora */
    .input-container {
        font-size: 18px;
        display: flex;
        flex-direction: column; /* Los inputs se alinean de arriba hacia abajo */
        align-items: center;
    }

    input {
        padding: 10px;
        font-size: 16px;
        margin-top: 10px;
        border: 2px solid #ccc;
        border-radius: 8px;
        background-color: #f0f0f0;
    }

    .scrollable-table {
        max-height: 400px;
        overflow-y: auto;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa; /* color fondo header */
        z-index: 2;
        text-align: center;
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
        text-align: center;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 45px;
        height: 24px;
        margin-right: 8px;
        vertical-align: middle;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .switch .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 34px;
        }

            .switch .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 3px;
                bottom: 3px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        .switch input:checked + .slider {
            background-color: #13DEB9; /* Verde menta */
        }

            .switch input:checked + .slider:before {
                transform: translateX(21px);
            }

    .switch-label {
        font-size: 14px;
        color: #555;
        vertical-align: middle;
    }
</style>




<body>
    <div class="container-fluid" style="padding-left: 200px;">
        <br /><br /><br />
        <div class="card">
            <div class="container-fluid">
                <div class="container-fluid">
                    <div class="card">
                        <div class="card-body">
                            <div id="alertsuccesclose" class="alert alert-success" role="alert" style="display: none;">
                                Agregado correctamente!
                            </div>
                            <h5 class="card-title fw-semibold mb-4">BOMs</h5>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">List</label>
                        <div class="d-flex">
                            <select class="form-select" id="selectListado"></select>
                            <button id="agregar" class="btn btn-sm btn-primary ms-2">Agregar</button>
                            <button id="agregarparaequipo" class="btn btn-sm btn-primary ms-2">Agregar para Equipo</button>
                        </div>
                    </div>
                    <div id="filtrosListado" class="row g-3 mb-2"></div>
                    <div id="contenedorListado" class="mt-3"></div>

                </div>
            </div>
        </div>
    </div>


    @*___________________________________________________________________Modal Cargando__________________________________________________*@
    <div id="loadingModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; background-color: rgba(0, 0, 0, 0.5);">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background-color: white; padding: 25px 35px; border-radius: 10px; box-shadow: 0 0 15px rgba(0,0,0,0.3); min-width: 250px;">
            <div style="display: flex; align-items: center; justify-content: center;">
                <img src="/Content/loading-green-loading.gif" alt="Cargando..." style="width: 40px; height: 40px; margin-right: 15px;" />
                <span style="color: black; font-size: 16px;">Cargando...</span>
            </div>
        </div>
    </div>
</body>



<script>
document.addEventListener('DOMContentLoaded', function () {
    'use strict';

    const selectListado = document.getElementById('selectListado');
    const contenedorListado = document.getElementById('contenedorListado');
    const btnAgregar = document.getElementById('agregar'); // debe existir un botón con id="agregar"
    const filtrosListado = document.getElementById('filtrosListado'); // contenedor de filtros (opcional)

    // endpoints
    const URL_MATERIALES         = '@Url.Action("GetMaterialProducido","Material")';
    const URL_BOMS_MATERIAL      = '@Url.Action("GetBOMsByMaterial","BillOfMaterial")';
    const URL_UPDATE_BOM         = '@Url.Action("EditBOM", "BillOfMaterial")';
    const URL_CREATE_BOM         = '@Url.Action("CreateBOM","BillOfMaterial")';
    const URL_EQUIPOS_USER       = '@Url.Action("GetEquiposporPaislogguedUser","Equipo")';
    const URL_MATERIAL_CONSUMIDO = '@Url.Action("GetMaterialConsumido","Material")';
    const URL_DELETE_BOM         = '@Url.Action("DeleteBOM","BillOfMaterial")'; // NUEVO

    let cacheMateriales = null;

    // Estado para filtro y datos en memoria
    let currentRows = [];            // última respuesta de /GetBOMsByMaterial
    let equipoFilterValue = '';      // EquipoID seleccionado en el filtro

    // ================= Helpers =================
    function option(el, value, text) {
        const o = document.createElement('option');
        o.value = value; o.textContent = text;
        el.appendChild(o);
    }
    function escapeHtml(str) {
        return String(str).replace(/[&<>"']/g, m => ({
            '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
        }[m]));
    }
    function fmtFechaISO(d) {
        if (!d) return '';
        const m = /\/Date\((\d+)\)\//.exec(String(d));
        if (m) {
            const millis = parseInt(m[1],10);
            if (!Number.isNaN(millis)) return new Date(millis).toISOString().split('T')[0];
        }
        if (typeof d === 'string' && d.includes('T')) return d.split('T')[0];
        return String(d);
    }
    function renderCheck(v){return v?'<i class="bi bi-check-circle-fill text-success"></i>':'<i class="bi bi-x-circle-fill text-danger"></i>';}
    function showMsg(msg,type='info'){
        contenedorListado.innerHTML = `<div class="alert alert-${type}" role="alert" style="margin-top:8px;">${escapeHtml(msg)}</div>`;
    }
    function normalize(s){ return String(s||'').normalize('NFD').replace(/\p{Diacritic}/gu,'').toLowerCase(); }

    // Validación requerida: debe existir material de producción seleccionado
    function requireMaterialSeleccionado(){
        if (!selectListado.value) {
            alert('Primero seleccione un Material de Producción en el filtro.');
            selectListado.focus();
            return false;
        }
        return true;
    }
    // Habilitar/deshabilitar botón Agregar según selección
    function updateAgregarState(){
        if (btnAgregar) btnAgregar.disabled = !selectListado.value;
    }

    // Llenar selects desde array
    function fillSelectFromArray(selectEl, list, valueField, textField, withEmpty=false, placeholder='Seleccione...'){
        if (!selectEl) return;
        selectEl.innerHTML=''; if(withEmpty) option(selectEl,'',placeholder);
        (list||[]).forEach(item=>{
            const val=item?.[valueField], txt=item?.[textField];
            if(val!==undefined && txt!==undefined) option(selectEl,val,txt);
        });
    }

    // Catálogos (SELECT normales)
    function fetchEquiposUserInto(selectEl){
        if(!selectEl) return;
        selectEl.disabled=true; selectEl.innerHTML='<option value="">Cargando...</option>';
        fetch(URL_EQUIPOS_USER,{headers:{'Accept':'application/json'}})
        .then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);return r.json();})
        .then(data=>{
            const list = Array.isArray(data)?data:(data && Array.isArray(data.data)?data.data:[]);
            fillSelectFromArray(selectEl,list,'EquipoID','Descripcion',true,'Seleccione equipo');
            selectEl.disabled=false;
        })
        .catch(err=>{
            console.error('[Equipos] ',err);
            selectEl.innerHTML='<option value="">Error</option>';
            selectEl.disabled=false;
        });
    }
    function fetchMaterialConsumidoInto(selectEl){
        if(!selectEl) return;
        selectEl.disabled=true; selectEl.innerHTML='<option value="">Cargando...</option>';
        fetch(URL_MATERIAL_CONSUMIDO,{headers:{'Accept':'application/json'}})
        .then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);return r.json();})
        .then(raw=>{
            const arr = Array.isArray(raw)?raw:(raw && Array.isArray(raw.data)?raw.data:(raw?.items||[]));
            const list = (arr||[]).map(x=>({ MaterialID:x.MaterialID, Descripcion:x.Descripcion })).filter(x=>x.MaterialID && x.Descripcion);
            fillSelectFromArray(selectEl,list,'MaterialID','Descripcion',true,'Seleccione material');
            selectEl.disabled=false;
        })
        .catch(err=>{
            console.error('[MaterialConsumido] ',err);
            selectEl.innerHTML='<option value="">Error</option>';
            selectEl.disabled=false;
        });
    }

    // ========== Filtro por Equipo (UI) ==========
    function ensureEquipoFilter(){
        if(!filtrosListado) return;                       // si no hay contenedor, no lo dibujamos
        if(document.getElementById('filterEquipo')) return;

        const col = document.createElement('div');
        col.className = 'col-md-4';
        col.innerHTML = `
            <label class="form-label">Equipo</label>
            <select id="filterEquipo" class="form-select">
                <option value="">Todos los equipos</option>
            </select>
        `;
        filtrosListado.appendChild(col);

        const sel = col.querySelector('#filterEquipo');
        sel.disabled = true;
        fetch(URL_EQUIPOS_USER,{headers:{'Accept':'application/json'}})
        .then(r=>{if(!r.ok) throw new Error('HTTP '+r.status); return r.json();})
        .then(data=>{
            const list = Array.isArray(data)?data:(data && Array.isArray(data.data)?data.data:[]);
            fillSelectFromArray(sel, list, 'EquipoID', 'Descripcion', true, 'Todos los equipos');
            sel.disabled = false;
        })
        .catch(err=>{
            console.error('[Filtro Equipo] ', err);
            sel.innerHTML = '<option value="">(error)</option>';
            sel.disabled = false;
        });

        sel.addEventListener('change', ()=>{
            equipoFilterValue = sel.value || '';
            renderTablaBOM(currentRows);                  // re-render con filtro aplicado
        });
    }

    // ========== Filtro lógico ==========
    function aplicarFiltros(rows){
        const eqVal = String(equipoFilterValue || '');
        return (rows||[]).filter(r=>{
            const eqId = String(r._equipoID ?? r.EquipoID ?? '');
            const byEq = !eqVal || eqId === eqVal;
            return byEq;
        });
    }

    // ========== Tabla ==========
    function collapseColumnDuplicates(table, colIndex) {
        const tbody = table.tBodies[0]; if (!tbody) return;
        let lastCell=null, span=1;
        for (let i=0;i<tbody.rows.length;i++){
            const cell = tbody.rows[i].cells[colIndex]; if(!cell) continue;
            const curr = cell.textContent.trim();
            if (lastCell && curr!=='' && curr===lastCell.textContent.trim()){
                span++; lastCell.rowSpan=span; cell.style.display='none';
            } else { lastCell=cell; span=1; }
        }
    }
    function collapseDuplicates(table, colIndices){
        [...colIndices].sort((a,b)=>b-a).forEach(i=>collapseColumnDuplicates(table,i));
    }
    function buildTheadHtml(){
        return `<thead><tr>
            <th class="text-center">Material Prod</th>
            <th class="text-center">Tipo Operación</th>
            <th class="text-center">Tipo Mov SAP</th>
            <th class="text-center">Factor</th>
            <th class="text-center">Equipo</th>
            <th class="text-center">Prod Seca</th>
            <th class="text-center">Prod Húmeda</th>
            <th class="text-center">Cons Seco</th>
            <th class="text-center">Cons Húmedo</th>
            <th class="text-center">Fecha BOM</th>
            <th class="text-center">Material Consumo</th>
            <th class="text-center">Status</th>
            <th class="text-center">Acciones</th>
        </tr></thead>`;
    }
    function ensureTableSkeleton(){
        let table=document.getElementById('tablaBOM');
        if(!table){
            contenedorListado.innerHTML = `
            <div class="table-responsive w-100" style="max-height:420px; overflow-y:auto; background-color:#fff; padding:10px; border-radius:10px;">
                <table id="tablaBOM" class="table table-bordered table-sm table-striped mb-0" style="background-color:#fff;">
                    ${buildTheadHtml()}<tbody></tbody>
                </table>
            </div>`;
            table=document.getElementById('tablaBOM');
        }
        return table;
    }
    function renderTablaBOM(rows){
        const data = aplicarFiltros(rows);
        if(!data || !data.length){
            showMsg('No hay registros para los filtros aplicados','warning');
            return;
        }

        let tbody='<tbody>';
        data.forEach(r=>{
            const prodSec = !!r._produccionSeca;
            const prodHum = !!r._produccionHumeda;
            const sec     = !!r._consumoSeco;
            const hum     = !!r._consumoHumedo;

            tbody+=`<tr
                data-bomid="${r._billOfMaterialID}"
                data-materialprodid="${r.dataset?.materialprodid || r._materialProduccionID || ''}"
                data-tipoopeid="${r._tipoOperacionID}"
                data-tipomovid="${r._tipoMovimientoSAPID ?? ''}"
                data-equipoid="${r._equipoID}"
                data-matconsid="${r._materialConsumoID}"
                data-factor="${r._factorConsumo ?? ''}"
                data-prosec="${prodSec?1:0}"
                data-prohum="${prodHum?1:0}"
                data-conssec="${sec?1:0}"
                data-conshum="${hum?1:0}"
                data-fecha="${fmtFechaISO(r._fechaBOM)}"
                data-active="${r._active?1:0}">
                <td class="text-center">${escapeHtml(r._materialProduccionDescripcion ?? '')}</td>
                <td class="text-center">${escapeHtml(r._tipoOperacionDescripcion ?? '')}</td>
                <td class="text-center">${r._tipoMovimientoSAPDescripcion?escapeHtml(r._tipoMovimientoSAPDescripcion):'-'}</td>
                <td class="text-center">${r._factorConsumo ?? ''}</td>
                <td class="text-center">${escapeHtml(r._equipoDescripcion ?? '')}</td>
                <td class="text-center prod-seca">${renderCheck(prodSec)}</td>
                <td class="text-center prod-hum">${renderCheck(prodHum)}</td>
                <td class="text-center consumo-seco">${renderCheck(sec)}</td>
                <td class="text-center consumo-hum">${renderCheck(hum)}</td>
                <td class="text-center">${fmtFechaISO(r._fechaBOM)}</td>
                <td class="text-center">${escapeHtml(r._materialConsumoDescripcion ?? '')}</td>
                <td class="text-center estatus">${renderCheck(!!r._active)}</td>
                <td class="text-center acciones">
                    <div class="btn-group btn-group-sm" role="group">
                        <button class="btn btn-primary btn-editar">Editar</button>
                        <button class="btn btn-outline-danger btn-eliminar">Eliminar</button>
                    </div>
                </td>
            </tr>`;
        });
        tbody+='</tbody>';
        contenedorListado.innerHTML = `
        <div class="table-responsive w-100" style="max-height:420px; overflow-y:auto; background-color:#fff; padding:10px; border-radius:10px;">
            <table id="tablaBOM" class="table table-bordered table-sm table-striped mb-0" style="background-color:#fff;">
                ${buildTheadHtml()}${tbody}
            </table>
        </div>`;
        const table=document.getElementById('tablaBOM');

        // seguir agrupando primeras columnas si lo usas
        collapseDuplicates(table,[0,1]);

        // Editar
        table.querySelectorAll('.btn-editar').forEach(btn=>{
            btn.addEventListener('click',()=>openEditOverlayFromRow(btn.closest('tr')));
        });
        // Eliminar
        table.querySelectorAll('.btn-eliminar').forEach(btn=>{
            btn.addEventListener('click',()=>handleDeleteClick(btn.closest('tr')));
        });
    }

    // ========== Eliminar ==========
    function handleDeleteClick(tr){
        if(!tr) return;
        const bomId  = Number(tr.dataset.bomid || 0);
        const matId  = tr.dataset.materialprodid || selectListado.value || '';

        if(!bomId){
            alert('No se pudo identificar el registro a eliminar.');
            return;
        }

        // Doble confirmacion
        const c1 = confirm('¿Seguro que quieres ELIMINAR este BOM? Esta accion no se puede deshacer.');
        if(!c1) return;
        const c2 = prompt('Para confirmar escribe: ELIMINAR');
        if((c2 || '').trim().toUpperCase() !== 'ELIMINAR'){
            alert('Confirmacion cancelada. No se elimino el registro.');
            return;
        }

        // POST al backend
        fetch(URL_DELETE_BOM, {
            method: 'POST',
            headers: { 'Content-Type':'application/json' },
            body: JSON.stringify({ id: bomId })
        })
        .then(r=>r.json())
        .then(res=>{
            if(res && res.success){
                recargarTablaActual(matId);
            }else{
                alert('No se pudo eliminar: ' + (res?.message || 'Error desconocido'));
            }
        })
        .catch(err=>{
            console.error(err);
            alert('Error al eliminar el BOM.');
        });
    }

    function recargarTablaActual(materialIdOverride){ const matId=materialIdOverride||selectListado.value; if(matId) cargarBOMPorMaterial(matId); }
    function cargarBOMPorMaterial(materialProduccionId){
        if(!materialProduccionId){ contenedorListado.innerHTML=''; return; }
        showMsg('Cargando...','secondary');
        fetch(`${URL_BOMS_MATERIAL}?materialProduccionId=${encodeURIComponent(materialProduccionId)}`,{headers:{'Accept':'application/json'}})
        .then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);return r.json();})
        .then(res=>{
            const rows = Array.isArray(res)?res:(res && res.success && Array.isArray(res.data)?res.data:[]);
            currentRows = rows;             // guardamos para filtros
            renderTablaBOM(currentRows);    // dibuja respetando filtro de equipo
        })
        .catch(err=>{console.error(err);showMsg('No se pudo cargar los datos','danger');});
    }

    // ========== Dropdown multiple generico (para CREAR)
    function montarDropdownMultiple(wrapperEl, hiddenSelectEl, placeholder, fetcher){
        wrapperEl.innerHTML = `
            <div class="msel" style="position:relative; width:100%;">
                <button type="button" class="msel-btn form-select text-start d-flex align-items-center justify-content-between">
                    <span class="msel-label text-truncate">${escapeHtml(placeholder)}</span>
                    <span class="ms-2">&#9662;</span>
                </button>
                <div class="msel-menu" style="display:none; position:absolute; left:0; right:0; z-index:1051; background:#fff; border:1px solid #ced4da; border-radius:.375rem; padding:.5rem; max-height:320px; overflow:auto; box-shadow:0 4px 14px rgba(0,0,0,.08);">
                    <input type="text" class="form-control form-control-sm mb-2 msel-search" placeholder="Buscar...">
                    <div class="small text-muted mb-2 msel-hint">Cargando...</div>
                    <div class="msel-items"></div>
                    <div class="d-flex gap-2 mt-2 justify-content-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary msel-clear">Limpiar</button>
                        <button type="button" class="btn btn-sm btn-primary msel-ok">OK</button>
                    </div>
                </div>
            </div>`;
        const btn       = wrapperEl.querySelector('.msel-btn');
        const menu      = wrapperEl.querySelector('.msel-menu');
        const label     = wrapperEl.querySelector('.msel-label');
        const itemsBox  = wrapperEl.querySelector('.msel-items');
        const hint      = wrapperEl.querySelector('.msel-hint');
        const searchInp = wrapperEl.querySelector('.msel-search');
        const clearBtn  = wrapperEl.querySelector('.msel-clear');
        const okBtn     = wrapperEl.querySelector('.msel-ok');

        let cache=null; const selected=new Set(); let isOpen=false; let loading=false; let outsideHandler=null;

        function openMenu(){
            if(isOpen) return; isOpen=true; menu.style.display='block';
            if(!cache && !loading){
                loading=true; hint.textContent='Cargando...';
                fetcher().then(list=>{ cache=list||[]; renderList(''); })
                .catch(e=>{ console.error(e); itemsBox.innerHTML='<div class="text-danger small">Error al cargar</div>'; hint.textContent=''; })
                .finally(()=>loading=false);
            }else{
                renderList(searchInp.value);
            }
            searchInp.focus({preventScroll:true});
            outsideHandler=(ev)=>{ if(!wrapperEl.contains(ev.target)) closeMenu(); };
            document.addEventListener('click',outsideHandler);
            document.addEventListener('keydown',escCloser);
        }
        function closeMenu(){
            if(!isOpen) return; isOpen=false; menu.style.display='none';
            if(outsideHandler){ document.removeEventListener('click',outsideHandler); outsideHandler=null; }
            document.removeEventListener('keydown',escCloser);
        }
        function escCloser(e){ if(e.key==='Escape') closeMenu(); }
        btn.addEventListener('click',(e)=>{ e.preventDefault(); isOpen?closeMenu():openMenu(); });
        okBtn.addEventListener('click',()=>closeMenu());
        clearBtn.addEventListener('click',()=>{ selected.clear(); renderList(searchInp.value); syncHidden(); });

        function syncHidden(){
            hiddenSelectEl.innerHTML=''; const names=[];
            (cache||[]).forEach(x=>{
                if(selected.has(x.id)){
                    const o=document.createElement('option'); o.value=x.id; o.text=x.text; o.selected=true;
                    hiddenSelectEl.appendChild(o); names.push(x.text);
                }
            });
            if(names.length===0) label.textContent=placeholder;
            else if(names.length<=2) label.textContent=names.join(', ');
            else label.textContent=`${names.length} seleccionados`;
        }
        function renderList(filter=''){
            itemsBox.innerHTML=''; const f=normalize(filter);
            const vis=(cache||[]).filter(it=>!f || normalize(it.text).includes(f));
            hint.textContent=`${vis.length} resultado(s)`;
            if(!vis.length){ itemsBox.innerHTML='<div class="text-muted small">Sin opciones</div>'; return; }
            vis.forEach(it=>{
                const id=it.id;
                const row=document.createElement('div'); row.className='form-check mb-1';
                const cb=document.createElement('input'); cb.type='checkbox'; cb.className='form-check-input'; cb.id=`ms_${id}`; cb.value=id; cb.checked=selected.has(id);
                const lb=document.createElement('label'); lb.className='form-check-label text-truncate'; lb.setAttribute('for',cb.id); lb.title=it.text; lb.textContent=it.text;
                cb.addEventListener('change',()=>{ cb.checked?selected.add(id):selected.delete(id); syncHidden(); });
                row.appendChild(cb); row.appendChild(lb); itemsBox.appendChild(row);
            });
        }
        searchInp.addEventListener('input',()=>renderList(searchInp.value));
        // inicia
        syncHidden();
    }
    function montarMatConsDropdown(wrapperEl, hiddenSelectEl, placeholder='Material Consumo'){
        return montarDropdownMultiple(
            wrapperEl,
            hiddenSelectEl,
            placeholder,
            async () => {
                const r = await fetch(URL_MATERIAL_CONSUMIDO,{headers:{'Accept':'application/json'}});
                if(!r.ok) throw new Error('HTTP '+r.status);
                const raw = await r.json();
                const arr = Array.isArray(raw)?raw:(raw?.data??raw?.items??[]);
                return (arr||[])
                    .map(x=>({ id:String(x.MaterialID), text:String(x.Descripcion||'') }))
                    .filter(x=>x.id && x.text.trim()!=='');
            }
        );
    }
    function montarEquipoDropdownMulti(wrapperEl, hiddenSelectEl, placeholder='Equipo(s)'){
        return montarDropdownMultiple(
            wrapperEl,
            hiddenSelectEl,
            placeholder,
            async () => {
                const r = await fetch(URL_EQUIPOS_USER,{headers:{'Accept':'application/json'}});
                if(!r.ok) throw new Error('HTTP '+r.status);
                const raw = await r.json();
                const arr = Array.isArray(raw)?raw:(raw?.data??raw?.items??[]);
                return (arr||[])
                    .map(x=>({ id:String(x.EquipoID), text:String(x.Descripcion||'') }))
                    .filter(x=>x.id && x.text.trim()!=='');
            }
        );
    }

