    function openEditOverlayFromRow(tr){
        if(!tr) return;
        ensureEditOverlay();

        editEl.querySelector('#ed_bomid').value = tr.dataset.bomid || '';

        // Material producción (bloqueado)
        const prodSel = editEl.querySelector('#ed_matProd');
        const matId   = tr.dataset.materialprodid || '';
        prodSel.innerHTML = '';
        const fillProd = () => {
            (cacheMateriales||[]).forEach(x=>option(prodSel,x.MaterialID,x.Descripcion));
            if (matId) prodSel.value = String(matId);
        };
        if (Array.isArray(cacheMateriales) && cacheMateriales.length) fillProd();
        else {
            fetch(URL_MATERIALES,{headers:{'Accept':'application/json'}})
            .then(r=>r.json()).then(lista=>{
                cacheMateriales = Array.isArray(lista)?lista:(lista && Array.isArray(lista.data)?lista.data:[]);
                fillProd();
            }).catch(()=>{ option(prodSel,'','(error)'); });
        }

        // Equipo (select simple)
        const eqSel = editEl.querySelector('#ed_equipo');
        fetchEquiposUserInto(eqSel);
        const desiredEq = tr.dataset.equipoid || '';
        const eqObs = new MutationObserver(()=>{
            if (desiredEq && eqSel.options.length) eqSel.value = desiredEq;
        });
        eqObs.observe(eqSel, { childList:true }); setTimeout(()=>eqObs.disconnect(), 1200);

        // Material Consumo (select simple)
        const mcSel = editEl.querySelector('#ed_matCons');
        fetchMaterialConsumidoInto(mcSel);
        const desiredMc = tr.dataset.matconsid || '';
        const mcObs = new MutationObserver(()=>{
            if (desiredMc && mcSel.options.length) mcSel.value = desiredMc;
        });
        mcObs.observe(mcSel, { childList:true }); setTimeout(()=>mcObs.disconnect(), 1200);

        // Factor, producción, consumos, fecha, activo
        editEl.querySelector('#ed_factor').value = tr.dataset.factor || '';
        editEl.querySelector('#ed_prodSeca').checked = tr.dataset.prosec === '1';
        editEl.querySelector('#ed_prodHum').checked  = tr.dataset.prohum === '1';
        editEl.querySelector('#ed_conSeco').checked  = tr.dataset.conssec === '1';
        editEl.querySelector('#ed_conHum').checked   = tr.dataset.conshum === '1';
        editEl.querySelector('#ed_fecha').value = tr.dataset.fecha || new Date().toISOString().split('T')[0];
        editEl.querySelector('#ed_activo').checked = tr.dataset.active === '1';

        editBg.style.display = 'block';
        editEl.style.display = 'block';
