@model DVP.Models.BillOfMaterialViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "BOM Page";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<style>
    .container {
        font-family: Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        margin-top: 20px;
    }

    .input-container {
        font-size: 18px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    input, select {
        padding: 10px;
        font-size: 16px;
        margin-top: 10px;
        border: 2px solid #ccc;
        border-radius: 8px;
        background-color: #f0f0f0;
    }

    .scrollable-table {
        max-height: 400px;
        overflow-y: auto;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa;
        z-index: 2;
        text-align: center;
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
        text-align: center;
    }

    .form-check-input:checked {
        background-color: #13DEB9 !important;
        border-color: #13DEB9 !important;
    }

    .form-check-label {
        font-weight: 500;
    }



</style>

<body>
    <div class="container-fluid" style="padding-left: 200px;">
        <br />
        <br />
        <br />
        <div class="card">
            <div class="container-fluid">
                <div class="container-fluid">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title fw-semibold mb-4 text-end"></h5>

                            <div id="alertsuccesnewbom" class="alert alert-success" role="alert" style="display: none;">
                                BOM agregado correctamente
                            </div>

                            <h5 class="card-title fw-semibold mb-4">BOM Configuration</h5>
                        </div>

                        <div class="card w-100">
                            <div class="card-body p-4">
                                <div class="text-end mb-3">
                                    <div class="d-flex justify-content-end align-items-center gap-2 mb-3">
                                        <i class="bi bi-binoculars-fill text-success"></i>
                                        <input type="text" class="form-control form-control-sm w-25" id="_buscar" placeholder="Buscar...">
                                        <button type="button" onclick="newBOM()" class="btn btn-outline-dark btn-sm">
                                            Add new
                                        </button>
                                    </div>
                                </div>

                                <div class="d-flex gap-3">
                                    <div class="table-responsive w-100" style="max-height: 400px; overflow-y: auto; background-color: #ffffff; padding: 10px; border-radius: 10px;">
                                        <table class="table table-bordered mb-0" style="background-color: #ffffff;">
                                            <thead style="position: sticky; top: 0; background-color: #ffffff; z-index: 2;">
                                                <tr>
                                                    <th class="text-center">Produced Material</th>
                                                    <th class="text-center">Operation Type</th>
                                                    <th class="text-center">SAP Movement Type</th>
                                                    <th class="text-center">Factor</th>
                                                    <th class="text-center">Equipment</th>
                                                    <th class="text-center">Dry Cons.</th>
                                                    <th class="text-center">Wet Cons.</th>
                                                    <th class="text-center">BOM Date</th>
                                                    <th class="text-center">Consumption Material</th>
                                                    <th class="text-center">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="bomTableBody">
                                                <tr></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div> <!-- card-body -->
                        </div> <!-- card -->
                    </div> <!-- card -->
                </div>
            </div>
        </div>

        <!-- Modal cargando -->
        <div id="loadingModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; background-color: rgba(0, 0, 0, 0.5);">
            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background-color: white; padding: 25px 35px; border-radius: 10px; box-shadow: 0 0 15px rgba(0,0,0,0.3); min-width: 250px;">
                <div style="display: flex; align-items: center; justify-content: center;">
                    <img src="/Content/loading-green-loading.gif" alt="Cargando..." style="width: 40px; height: 40px; margin-right: 15px;" />
                    <span style="color: black; font-size: 16px;">Cargando...</span>
                </div>
            </div>
        </div>

        <!-- Modal crear BOM -->
        <div class="modal fade" id="newBOM" tabindex="-1" aria-labelledby="modalLabelBOM" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="card-body">
                            <div class="card">
                                <form>
                                    <div class="card-body">
                                        <h4 class="card-title fw-semibold mb-2">Add New BOM</h4>
                                        <br />
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label class="form-label">Material Producción</label>
                                                <select class="form-select" id="_materialProduccionID" required>
                                                    <option value="">Seleccione un material de producción</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Material Consumo</label>
                                                <select class="form-select" id="_materialConsumoID">
                                                    <option value="">Seleccione un material de consumo</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Material Consumo Energía o Combustión</label>
                                                <select class="form-select" id="_materialConsumoCombustibleID" required>
                                                    <option value="">Seleccione un material combustible</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Material Alterno</label>
                                                <select class="form-select" id="_materialAlternoID" required>
                                                    <option value="">Seleccione un material alterno</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Tipo Movimiento SAP</label>
                                                <select class="form-select" id="_tipoMovimientoSAPID">
                                                    <option value="">Seleccione un tipo de movimiento SAP</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label class="form-label">Factor Consumo</label>
                                                <input type="number" step="0.0001" class="form-control" id="_factorConsumo">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Equipo</label>
                                                <select class="form-select" id="_equipoID" required>
                                                    <option value="">Seleccione un equipo</option>
                                                </select>
                                            </div>
                                            <div class="form-check form-switch mb-3">
                                                <input class="form-check-input" type="checkbox" id="_consumoSeco">
                                                <label class="form-check-label" for="_consumoSeco">Consumo Seco</label>
                                            </div>
                                            <div class="form-check form-switch mb-3">
                                                <input class="form-check-input" type="checkbox" id="_consumoHumedo">
                                                <label class="form-check-label" for="_consumoHumedo">Consumo Húmedo</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="text-end mt-3">
                                        <button type="button" id="crearBOM" class="btn btn-outline-success m-1"
                                                data-url="@Url.Action("CreateBOM", "BillOfMaterial")">
                                            Crear <span class="text-success ms-2">&#10004;</span>
                                        </button>
                                    </div>

                                    <div id="alertSuccessBOM" class="alert alert-success mt-3" role="alert" style="display: none;">
                                        Creado exitosamente
                                    </div>
                                </form>
                            </div> <!-- card -->
                        </div> <!-- card-body -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal editar BOM -->
        <div class="modal fade" id="editarBOM" tabindex="-1" aria-labelledby="modalLabelBOMEdit" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalLabelBOMEdit">BOM Edit</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="card-body">
                            <div class="card">
                                <div class="card-body">
                                    <form>
                                        <div class="card-body">
                                            <h4 class="card-title fw-semibold mb-2">Edit BOM</h4>
                                            <br />
                                            <input type="hidden" id="bomidhidden" value="" />
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label class="form-label">Material Producción</label>
                                                    <select class="form-select" id="_materialProduccionIDeditar">
                                                        <option value="">Seleccione un material de producción</option>
                                                    </select>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label">Tipo Operación</label>
                                                    <select class="form-select" id="_tipoOperacionIDeditar">
                                                        <option value="">Seleccione un tipo de operación</option>
                                                    </select>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label">TipoMovimiento SAP</label>
                                                    <select class="form-select" id="_tipoMovimientoSAPIDeditar">
                                                        <option value="">Seleccione un tipo de movimiento SAP</option>
                                                    </select>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label">Factor Consumo</label>
                                                    <input type="number" step="0.0001" class="form-control" id="_factorConsumoeditar">
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Equipo</label>
                                                    <select class="form-select" id="_equipoIDeditar">
                                                        <option value="">Seleccione un equipo</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label class="form-label">TagProduccion</label>
                                                    <input type="text" class="form-control" id="_tagProduccioneditar">
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">TagHumedad</label>
                                                    <input type="text" class="form-control" id="_tagHumedadeditar">
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">ConsumoSeco</label>
                                                    <input type="number" step="0.0001" class="form-control" id="_consumoSecoeditar">
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">ConsumoHumedo</label>
                                                    <input type="number" step="0.0001" class="form-control" id="_consumoHumedoeditar">
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Material Consumo</label>
                                                    <input type="number" class="form-control" id="_materialConsumoIDeditar">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="text-end mt-3">
                                            <button type="button" id="editar"
                                                    class="btn btn-outline-success m-1"
                                                    data-url="@Url.Action("EditBOM", "BillOfMaterial")"
                                                    onclick="submitEditBOM()">
                                                Editar <span class="text-success ms-2">&#10004;</span>
                                            </button>
                                        </div>
                                    </form>

                                    <div id="alertEditSuccessBOM" class="alert alert-success" role="alert" style="display: none;">
                                        Editado
                                    </div>
                                </div> <!-- card-body -->
                            </div> <!-- card -->
                        </div> <!-- card-body -->
                    </div> <!-- modal-body -->
                </div>
            </div>
        </div>
    </div>
</body>

@section scripts{
    <script src="~/Content/Modernize-1.0.0/src/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/js/sidebarmenu.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/js/app.min.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/libs/simplebar/dist/simplebar.js"></script>
}

<script>



    function cargando() {
        const m = document.getElementById("loadingModal");
        if (m && m.style) m.style.display = "block";
    }
    function cargandoOff() {
        const m = document.getElementById("loadingModal");
        if (m && m.style) m.style.display = "none";
    }

//___________________________________________________________________ Crear BOM __________________________________________________________________//
function newBOM() {
    const modalElement = document.getElementById('newBOM');
    const modal = new bootstrap.Modal(modalElement);
    modal.show();

    const form = document.querySelector('#newBOM form');
    if (form) form.reset();

    // clean selects
    limpiarSelect('_materialProduccionID');
    limpiarSelect('_tipoMovimientoSAPID');
    limpiarSelect('_equipoID');
    limpiarSelect('_materialConsumoID');
    limpiarSelect('_materialConsumoCombustibleID');
    limpiarSelect('_materialAlternoID');

    // load combos
    cargarCombosBOM();
}

// ===================================================================
// Load static combos and init multiselect dropdowns
// ===================================================================
function cargarCombosBOM() {
    // normal selects
    const fetchTipoMovSAP = fetch('@Url.Action("GetTipoMovimientoSAP", "DatosOperacion")', { headers: { 'Accept': 'application/json' } }).then(r => r.json());
    const fetchEquipos    = fetch('@Url.Action("GetEquiposporPaislogguedUser", "Equipo")', { headers: { 'Accept': 'application/json' } }).then(r => r.json());

    Promise.all([fetchTipoMovSAP, fetchEquipos])
        .then(([tiposMov, equipos]) => {
            const norm = (x) => Array.isArray(x) ? x : (x?.data ?? x?.items ?? []);
            llenarSelect('_tipoMovimientoSAPID', norm(tiposMov),'TipoMovimientoSAPID', 'Descripcion');
            llenarSelect('_equipoID',            norm(equipos), 'EquipoID',            'Descripcion');
        })
        .catch(err => {
            console.error(err);
            alert('No se pudieron cargar los catalogos.');
        });

    // multiselects with search
    // Material Produccion -> limit to 1
    initMultiSelectDropdown(
        '_materialProduccionID',
        '@Url.Action("GetMaterialProducidoOConsumido", "Material")',
        'MaterialID',
        'Descripcion',
        { minChars: 2, pageSize: 30, placeholder: 'Seleccione material de produccion', maxSelected: 1 }
    );

    // The rest can be multiple
    initMultiSelectDropdown(
        '_materialConsumoID',
        '@Url.Action("GetMaterialProducidoOConsumido", "Material")',
        'MaterialID',
        'Descripcion',
        { minChars: 2, pageSize: 30, placeholder: 'Seleccione material de consumo' }
    );

    initMultiSelectDropdown(
        '_materialConsumoCombustibleID',
        '@Url.Action("GetMaterialCombustible", "Material")',
        'MaterialID',
        'Descripcion',
        { minChars: 2, pageSize: 30, placeholder: 'Seleccione material combustible' }
    );

    initMultiSelectDropdown(
        '_materialAlternoID',
        '@Url.Action("GetMaterialCombustible", "Material")',
        'MaterialID',
        'Descripcion',
        { minChars: 2, pageSize: 30, placeholder: 'Seleccione material alterno' }
    );
}

// ===================================================================
// Helpers for regular selects
// ===================================================================
function llenarSelect(selectId, data, valueField, textField) {
    const select = document.getElementById(selectId);
    if (!select) return;
    data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item[valueField]);
        opt.text  = item[textField];
        select.appendChild(opt);
    });
}

function limpiarSelect(selectId) {
    const select = document.getElementById(selectId);
    if (!select) return;

    // placeholder
    select.innerHTML = '<option value="" disabled hidden>Seleccione una opcion</option>';

    // decide which are multiselects
    const multiIds = new Set([
        '_materialProduccionID',
        '_materialConsumoID',
        '_materialConsumoCombustibleID',
        '_materialAlternoID'
    ]);

    if (multiIds.has(selectId)) {
        select.setAttribute('multiple', 'multiple');
        select.classList.add('d-none'); // hidden, UI is custom dropdown
    } else {
        select.removeAttribute('multiple');
        select.classList.remove('d-none');
    }

    // remove previous wrapper if any
    const wrap = document.getElementById(selectId + '__mswrap');
    if (wrap && wrap.parentNode) wrap.parentNode.removeChild(wrap);
}

// ===================================================================
// Multiselect with search (single file, no deps)
// Supports: minChars, pageSize, placeholder, maxSelected
// ===================================================================
function initMultiSelectDropdown(selectId, fetchUrl, valueField, textField, opts = {}) {
    const { minChars = 2, pageSize = 25, placeholder = 'Seleccione una opcion', maxSelected = 0 } = opts;

    const select = document.getElementById(selectId);
    if (!select) return;

    // store limit in dataset for later use
    if (maxSelected && maxSelected > 0) {
        select.dataset.maxSelected = String(maxSelected);
    } else {
        delete select.dataset.maxSelected;
    }

    select.setAttribute('multiple', 'multiple');
    select.classList.add('d-none');

    let wrap = document.getElementById(selectId + '__mswrap');
    if (wrap && wrap.parentNode) wrap.parentNode.removeChild(wrap);

    wrap = document.createElement('div');
    wrap.className = 'dropdown w-100';
    wrap.id = selectId + '__mswrap';

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'form-select text-start d-flex align-items-center justify-content-between';
    btn.setAttribute('data-bs-toggle', 'dropdown');
    btn.setAttribute('data-bs-auto-close', 'outside');
    btn.setAttribute('data-bs-display', 'static');
    btn.setAttribute('aria-expanded', 'false');
    btn.id = selectId + '__btn';

    const btnText = document.createElement('span');
    btnText.id = selectId + '__btntext';
    btnText.textContent = placeholder;

    const caret = document.createElement('span');
    caret.className = 'ms-2';
    caret.innerHTML = '&#9662;';

    btn.appendChild(btnText);
    btn.appendChild(caret);

    const menu = document.createElement('div');
    menu.className = 'dropdown-menu p-2 w-100';
    menu.style.maxHeight = '320px';
    menu.style.overflow = 'auto';
    menu.id = selectId + '__menu';

    const input = document.createElement('input');
    input.type = 'text';
    input.className = 'form-control mb-2';
    input.placeholder = 'Buscar...';
    input.id = selectId + '__search';

    const hint = document.createElement('div');
    hint.className = 'small text-muted mb-2';
    hint.id = selectId + '__hint';
    hint.textContent = 'Escribe al menos ' + minChars + ' letras';

    const list = document.createElement('div');
    list.id = selectId + '__list';

    menu.appendChild(input);
    menu.appendChild(hint);
    menu.appendChild(list);

    select.insertAdjacentElement('afterend', wrap);
    wrap.appendChild(btn);
    wrap.appendChild(menu);

    const debounced = debounce(() =>
        runSearch(input, hint, list, select, fetchUrl, valueField, textField, pageSize, updateButtonText, applyLimitState)
    );

    input.addEventListener('input', () => {
        if (input.value.trim().length < minChars) {
            renderSelectedList(list, select, valueField, textField, /*quietIfEmpty=*/true, applyLimitState);
            const n = Array.from(select.options).filter(o => o.selected && o.value).length;
            hint.textContent = n > 0
                ? `Seleccionados (${n}). Escribe al menos ${minChars} letras para buscar`
                : `Escribe al menos ${minChars} letras`;
            applyLimitState();
            return;
        }
        hint.textContent = 'Buscando...';
        debounced();
    });

    btn.addEventListener('shown.bs.dropdown', () => {
        input.focus();
        if (input.value.trim().length < minChars) {
            renderSelectedList(list, select, valueField, textField, /*quietIfEmpty=*/true, applyLimitState);
            const n = Array.from(select.options).filter(o => o.selected && o.value).length;
            hint.textContent = n > 0
                ? `Seleccionados (${n}). Escribe al menos ${minChars} letras para buscar`
                : `Escribe al menos ${minChars} letras`;
            applyLimitState();
        } else {
            hint.textContent = 'Buscando...';
            debounced.flush && debounced.flush();
        }
    });

    function updateButtonText() {
        const btnTextEl = document.getElementById(selectId + '__btntext');
        const selected = Array.from(select.options).filter(o => o.selected && o.value);
        if (selected.length === 0) btnTextEl.textContent = placeholder;
        else if (selected.length === 1) btnTextEl.textContent = selected[0].text;
        else btnTextEl.textContent = selected.length + ' seleccionados';
    }

    function getMaxSelected() {
        const raw = parseInt(select.dataset.maxSelected || '0', 10);
        return (Number.isNaN(raw) || raw <= 0) ? Infinity : raw;
    }

    function applyLimitState() {
        const maxSel = getMaxSelected();
        const selectedCount = Array.from(select.options).filter(o => o.selected && o.value).length;
        const reached = selectedCount >= maxSel;

        // disable unchecked boxes when limit reached
        const boxes = list.querySelectorAll('input.msitem[type="checkbox"]');
        boxes.forEach(cb => {
            if (reached && !cb.checked) cb.disabled = true;
            else cb.disabled = false;
        });
    }

    wrap._updateButtonText = updateButtonText;
    updateButtonText();
    renderIdleList(list);
}

// ===================================================================
// Remote search + client filter
// ===================================================================
async function runSearch(input, hint, list, select, fetchUrl, valueField, textField, pageSize, afterRenderBtnText, afterRenderLimitState) {
    const term = input.value.trim();
    if (!term) return;

    try {
        const url = `${fetchUrl}?q=${encodeURIComponent(term)}&pageSize=${pageSize}`;
        const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
        if (!res.ok) {
            hint.textContent = '';
            renderNoResults(list);
            return;
        }
        const raw = await res.json();
        const arr = Array.isArray(raw) ? raw : (raw?.data ?? raw?.items ?? raw?.results ?? []);

        // case/diacritics insensitive filter
        const t = normStr(term);
        const filtered = (arr || []).filter(it => normStr(it[textField]).includes(t));

        if (filtered.length) {
            hint.textContent = filtered.length + ' resultado(s)';
            renderResults(list, filtered, select, valueField, textField);
            afterRenderBtnText && afterRenderBtnText();
            afterRenderLimitState && afterRenderLimitState();

            // enforce maxSelected on change
            enforceMaxSelected(list, select);
        } else {
            hint.textContent = '';
            renderNoResults(list);
        }
    } catch (e) {
        console.error(e);
        hint.textContent = '';
        renderNoResults(list);
    }
}

// ===================================================================
// Show selected list if any (or idle)
// ===================================================================
function renderSelectedList(list, select, valueField, textField, quietIfEmpty = false, afterRenderLimitState) {
    const selected = Array.from(select.options).filter(o => o.selected && o.value);
    if (selected.length === 0) {
        if (quietIfEmpty) renderIdleList(list); else renderNoResults(list);
        return false;
    }
    const items = selected.map(o => ({ [valueField]: o.value, [textField]: o.text }));
    renderResults(list, items, select, valueField, textField);
    afterRenderLimitState && afterRenderLimitState();
    enforceMaxSelected(list, select);
    return true;
}

// ===================================================================
// Render check list
// ===================================================================
function renderResults(list, items, select, valueField, textField) {
    list._showingEmpty = false;
    list.innerHTML = '';

    const filtered = (items || []).filter(it => {
        const v = String(it?.[valueField] ?? '');
        const t = String(it?.[textField] ?? '').trim().toLowerCase();
        if (!v) return false;
        if (t === 'seleccione una opcion' || t === 'seleccione una opción') return false;
        return true;
    });

    if (!filtered.length) {
        renderNoResults(list);
        return;
    }

    const selectedValues = new Set(Array.from(select.options).filter(o => o.selected).map(o => o.value));

    filtered.forEach(item => {
        const val = String(item[valueField]);
        const txt = item[textField];

        const row = document.createElement('div');
        row.className = 'form-check mb-1';

        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.className = 'form-check-input msitem';
        cb.id = select.id + '__opt__' + val;
        cb.value = val;
        cb.checked = selectedValues.has(val);

        const lb = document.createElement('label');
        lb.className = 'form-check-label';
        lb.setAttribute('for', cb.id);
        lb.textContent = txt;

        cb.addEventListener('change', () => {
            // try to enforce selection limit
            const maxSelRaw = parseInt(select.dataset.maxSelected || '0', 10);
            const maxSel = (Number.isNaN(maxSelRaw) || maxSelRaw <= 0) ? Infinity : maxSelRaw;

            if (cb.checked) {
                const currentCount = Array.from(select.options).filter(o => o.selected && o.value).length;
                // we will select now via syncSelectOption; check future count
                if (currentCount >= maxSel) {
                    // revert check
                    cb.checked = false;
                    // show quick hint
                    const hintEl = document.getElementById(select.id + '__hint');
                    if (hintEl) {
                        const prev = hintEl.textContent;
                        hintEl.textContent = `Solo puede seleccionar ${maxSel}`;
                        setTimeout(() => { hintEl.textContent = prev; }, 1200);
                    }
                    return;
                }
            }

            // sync hidden select
            syncSelectOption(select, val, txt, cb.checked);

            // update button text
            const wrap = document.getElementById(select.id + '__mswrap');
            if (wrap && typeof wrap._updateButtonText === 'function') wrap._updateButtonText();

            // disable others if needed
            enforceMaxSelected(list, select);
        });

        row.appendChild(cb);
        row.appendChild(lb);
        list.appendChild(row);
    });
}

// enforce maxSelected by disabling unchecked boxes when reached
function enforceMaxSelected(list, select) {
    const maxSelRaw = parseInt(select.dataset.maxSelected || '0', 10);
    const maxSel = (Number.isNaN(maxSelRaw) || maxSelRaw <= 0) ? Infinity : maxSelRaw;
    const selectedCount = Array.from(select.options).filter(o => o.selected && o.value).length;
    const reached = selectedCount >= maxSel;

    const boxes = list.querySelectorAll('input.msitem[type="checkbox"]');
    boxes.forEach(cb => {
        if (reached && !cb.checked) cb.disabled = true;
        else cb.disabled = false;
    });

    // update button text if available
    const wrap = document.getElementById(select.id + '__mswrap');
    if (wrap && typeof wrap._updateButtonText === 'function') wrap._updateButtonText();
}

// ===================================================================
// Empty / idle states
// ===================================================================
function renderNoResults(list) {
    if (list._showingEmpty) return;
    list._showingEmpty = true;
    list.innerHTML = '';
    const div = document.createElement('div');
    div.className = 'text-muted small';
    div.textContent = 'Sin resultados';
    list.appendChild(div);
}

function renderIdleList(list) {
    list._showingEmpty = false;
    list.innerHTML = '';
}

// ===================================================================
// Sync <select> hidden option
// ===================================================================
function syncSelectOption(select, value, text, selected) {
    if (!value) return;
    let opt = Array.from(select.options).find(o => o.value === value);
    if (!opt) {
        opt = document.createElement('option');
        opt.value = value;
        opt.text  = text;
        select.appendChild(opt);
    }
    opt.selected = !!selected;
}

// ===================================================================
// Utils
// ===================================================================
function normStr(s) {
    return (s ?? '')
        .toString()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
}

function debounce(fn, wait = 300) {
    let t, lastArgs, lastThis;
    const wrapped = function(...args) {
        lastArgs = args; lastThis = this;
        clearTimeout(t);
        t = setTimeout(() => {
            fn.apply(lastThis, lastArgs);
            lastArgs = lastThis = undefined;
        }, wait);
    };
    wrapped.flush = function() {
        clearTimeout(t);
        if (lastArgs) {
            fn.apply(lastThis, lastArgs);
            lastArgs = lastThis = undefined;
        }
    };
    return wrapped;
}

// ===================================================================
// Submit: create BOM
// - requires exactly 1 production material
// - merges consumo + combustible + alterno into one array
// ===================================================================
document.addEventListener('DOMContentLoaded', () => {
    const btnCrear = document.getElementById('crearBOM');
    if (!btnCrear) return;

    btnCrear.addEventListener('click', async () => {
        const url = btnCrear.getAttribute('data-url');
        if (!url) { alert('No se encontro la URL de creacion.'); return; }

        btnCrear.disabled = true;
        try { cargando(); } catch (_) {}

        // read helpers
        const getSelectedInts = (selectId) => {
            const el = document.getElementById(selectId);
            if (!el) return [];
            return Array.from(el.options)
                .filter(o => o.selected && o.value)
                .map(o => parseInt(o.value, 10))
                .filter(n => !Number.isNaN(n));
        };
        const getInt = (id) => {
            const el = document.getElementById(id); if (!el) return null;
            const v = parseInt(el.value, 10); return Number.isNaN(v) ? null : v;
        };
        const getDec = (id) => {
            const el = document.getElementById(id); if (!el) return null;
            const v = parseFloat(el.value); return Number.isNaN(v) ? null : v;
        };
        const getBool = (id) => !!document.getElementById(id)?.checked;

        // read values
        const prodIds = getSelectedInts('_materialProduccionID'); // must be exactly 1
        const consIds = getSelectedInts('_materialConsumoID');
        const combIds = getSelectedInts('_materialConsumoCombustibleID');
        const altIds  = getSelectedInts('_materialAlternoID');

        const consumoAllIds = Array.from(new Set([ ...consIds, ...combIds, ...altIds ]));

        const tipoMovId = getInt('_tipoMovimientoSAPID'); // optional
        const equipoId  = getInt('_equipoID');            // required
        const factor    = getDec('_factorConsumo');       // optional -> backend normalizes to 0
        const seco      = getBool('_consumoSeco');
        const humedo    = getBool('_consumoHumedo');

        // validations
        if (prodIds.length !== 1) {
            alert('Debe seleccionar exactamente un (1) material de produccion.');
            btnCrear.disabled = false;
            document.getElementById('_materialProduccionID__btn')?.focus();
            cargandoOff();
            return;
        }
        if (!equipoId) {
            alert('Debe seleccionar un equipo.');
            btnCrear.disabled = false;
            document.getElementById('_equipoID')?.focus();
            cargandoOff();
            return;
        }
        if (!consumoAllIds.length) {
            alert('Debe seleccionar al menos un material de consumo (incluye combustible/alterno).');
            btnCrear.disabled = false;
            document.getElementById('_materialConsumoID__btn')?.focus();
            cargandoOff();
            return;
        }

        const payload = {
            _materialProduccionIDs: prodIds,       // exactly one
            _materialConsumoIDs: consumoAllIds,    // unified
            _tipoMovimientoSAPID: tipoMovId,       // can be null
            _equipoID: equipoId,
            _factorConsumo: factor,                // can be null
            _consumoSeco: seco,
            _consumoHumedo: humedo
        };

        try {
            const resp = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json; charset=utf-8' },
                body: JSON.stringify(payload)
            });
            if (!resp.ok) throw new Error('HTTP ' + resp.status);

            const data = await resp.json();
            if (data && data.success) {
                // reset UI
                document.querySelector('#newBOM form')?.reset();
                ['_materialProduccionID','_materialConsumoID','_materialConsumoCombustibleID','_materialAlternoID','_tipoMovimientoSAPID','_equipoID']
                    .forEach(id => limpiarSelect(id));

                // success alert
                const alertEl = document.getElementById('alertSuccessBOM');
                if (alertEl) {
                    alertEl.textContent = data.message || 'Creado exitosamente';
                    alertEl.style.display = 'block';
                    setTimeout(() => { alertEl.style.display = 'none'; }, 3500);
                }

                // close modal
                const modalEl = document.getElementById('newBOM');
                (bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl)).hide();

                // refresh table if present
                if (typeof loadTable === 'function') loadTable();
            } else {
                alert((data && data.message) ? data.message : 'No se pudo crear la BOM.');
            }
        } catch (err) {
            console.error(err);
            alert('Error inesperado al crear la BOM.');
        } finally {
            btnCrear.disabled = false;
            cargandoOff();
        }
    });
});


    //___________________________________________________________________ Mostrar BOM __________________________________________________________________//


    function loadTable() {
    const tbody = document.getElementById('bomTableBody');
    tbody.innerHTML = ''; // limpiar contenido anterior

    cargando();

    fetch('@Url.Action("GetBOMs", "BillOfMaterial")')
        .then(response => {
            if (!response.ok) throw new Error("Error al obtener los datos.");
            return response.json();
        })
        .then(data => {
            if (!data.success || !Array.isArray(data.data)) {
                alert("La respuesta del servidor no es válida.");
                return;
            }

            const boms = data.data;

            // guardamos ultimo valor impreso por columna
            let lastProd = null;
            let lastOp   = null;
            let lastMov  = null;
            let lastFactor = null;
            let lastEq   = null;
            let lastFecha = null;

            boms.forEach(item => {
                const row = document.createElement('tr');

                // si es igual al anterior -> cadena vacía
                const prod  = (item._materialProduccionDescripcion === lastProd) ? '' : item._materialProduccionDescripcion || '';
                const op    = (item._tipoOperacionDescripcion === lastOp) ? '' : item._tipoOperacionDescripcion || '';
                const mov   = (item._tipoMovimientoSAPDescripcion === lastMov) ? '' : item._tipoMovimientoSAPDescripcion || '';
                const fact  = (item._factorConsumo === lastFactor) ? '' : (item._factorConsumo ?? '');
                const eq    = (item._equipoDescripcion === lastEq) ? '' : item._equipoDescripcion || '';
                const fecha = (item._fechaBOM === lastFecha) ? '' : (item._fechaBOM ? new Date(item._fechaBOM).toLocaleDateString() : '');

                row.innerHTML = `
                    <td class="text-center">${prod}</td>
                    <td class="text-center">${op}</td>
                    <td class="text-center">${mov}</td>
                    <td class="text-center">${fact}</td>
                    <td class="text-center">${eq}</td>
                    <td class="text-center">
                        ${item._consumoSeco ? '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-x-circle-fill text-danger"></i>'}
                    </td>
                    <td class="text-center">
                        ${item._consumoHumedo ? '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-x-circle-fill text-danger"></i>'}
                    </td>
                    <td class="text-center">${fecha}</td>
                    <td class="text-center">${item._materialConsumoDescripcion || ''}</td>
                    <td class="text-center bg-white">
                        <a class="dropdown-item" href="javascript:void(0)" onclick="abrirModalEditar(${item._billOfMaterialID})">
                            <i class="bi bi-pencil me-2"></i>
                        </a>
                    </td>
                `;

                tbody.appendChild(row);

                // actualizar ultimos valores
                lastProd   = item._materialProduccionDescripcion;
                lastOp     = item._tipoOperacionDescripcion;
                lastMov    = item._tipoMovimientoSAPDescripcion;
                lastFactor = item._factorConsumo;
                lastEq     = item._equipoDescripcion;
                lastFecha  = item._fechaBOM;
            });
        })
        .catch(error => {
            console.error("Error cargando la tabla BOM:", error);
            alert("Ocurrió un error al cargar la BOM.");
        })
        .finally(() => {
            const lm = document.getElementById("loadingModal");
            if (lm) lm.style.display = "none";
        });
}

document.addEventListener('DOMContentLoaded', loadTable);


</script>

