

@model DVP.Models.MaterialViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Downtime Page";

}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<style>
    /* Estilo para el contenedor de la fecha y hora */
    .container {
        font-family: Arial, sans-serif;
        display: flex; /* Usamos flex para alinearlos horizontalmente */
        justify-content: center; /* Centra los elementos horizontalmente */
        align-items: center; /* Centra los elementos verticalmente */
        gap: 20px; /* Espacio entre los divs */
        margin-top: 20px;
    }
    /* Estilo para los divs de fecha y hora */
    .input-container {
        font-size: 18px;
        display: flex;
        flex-direction: column; /* Los inputs se alinean de arriba hacia abajo */
        align-items: center;
    }

    input {
        padding: 10px;
        font-size: 16px;
        margin-top: 10px;
        border: 2px solid #ccc;
        border-radius: 8px;
        background-color: #f0f0f0;
    }

    .scrollable-table {
        max-height: 400px;
        overflow-y: auto;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa; /* color fondo header */
        z-index: 2;
        text-align: center;
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
        text-align: center;
    }

    .form-check-input:checked {
        background-color: #13DEB9 !important; /* bg-success */
        border-color: #13DEB9 !important;
    }

    /* Opcional: cambiar el texto también */
    .form-check-label {
        font-weight: 500;
    }
</style>

<body>
    <div class="container-fluid" style="padding-left: 200px;">
        <br />
        <br />
        <br />
        <div class="card">
            <div class="container-fluid">
                <div class="container-fluid">
                    <div class="card">
                        <div class="card-body">
                            <!-- Fecha de validación -->
                            <h5 class="card-title fw-semibold mb-4 text-end">
                            </h5>
                            <div id="alertsuccesnewmaterial" class="alert alert-success" role="alert" style="display: none;">
                                Material agregado correctamente!
                            </div>
                            <!-- Equipos -->
                            <h5 class="card-title fw-semibold mb-4">Material Configuration</h5>
                        </div>
                        <!-- Sección de Listas -->
                        <div class="card w-100">
                            <div class="card-body p-4">
                                <div class="text-end mb-3">
                                    <div class="d-flex justify-content-end align-items-center gap-2 mb-3">
                                        <i class="bi bi-binoculars-fill text-success"></i>
                                        <input type="text" class="form-control form-control-sm w-25" id="_buscar" placeholder="Buscar...">
                                        <button type="button" onclick="newMaterial()" class="btn btn-outline-dark btn-sm">
                                            Add new
                                        </button>
                                    </div>
                                </div>
                                <div class="d-flex gap-3">
                                    <!-- Tabla más ancha (downtimes activos) -->
                                    <div class="table-responsive w-100" style="max-height: 400px; overflow-y: auto; background-color: #ffffff; padding: 10px; border-radius: 10px;">
                                        <table class="table table-bordered mb-0" style="background-color: #ffffff;">
                                            <thead style="position: sticky; top: 0; background-color: #ffffff; z-index: 2;">
                                                <tr>
                                                    <th class="text-center">Status</th>
                                                    <th class="text-center">Description</th>
                                                    <th class="text-center">New SAP code</th>
                                                    <th class="text-center">ID Stock</th>
                                                    <th class="text-center">Unidad Medida</th>
                                                    <th class="text-center">Producido</th>
                                                    <th class="text-center">Consumido</th>
                                                    <th class="text-center">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="downtimeTableBody">
                                                <tr>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>



        @*___________________________________________________________________Modal Cargando__________________________________________________*@
        <div id="loadingModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; background-color: rgba(0, 0, 0, 0.5);">
            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background-color: white; padding: 25px 35px; border-radius: 10px; box-shadow: 0 0 15px rgba(0,0,0,0.3); min-width: 250px;">
                <div style="display: flex; align-items: center; justify-content: center;">
                    <img src="/Content/loading-green-loading.gif" alt="Cargando..." style="width: 40px; height: 40px; margin-right: 15px;" />
                    <span style="color: black; font-size: 16px;">Cargando...</span>
                </div>
            </div>
        </div>

        @*______________________________________________________________________Modal crear  _________________________________________________________________________*@

         <div class="modal fade" id="newMaterial" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
           <div class="modal-dialog modal-lg">
              <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="card-body">
                        <div class="card">
                            <!-- Formulario con validación -->
                            <form id="formNewMaterial" novalidate>
                                <div class="card-body">
                                    <h4 class="card-title fw-semibold mb-2">Add New Material</h4>
                                    <br />
                                </div>
                                <div class="row">
                                    <!-- Columna izquierda -->
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Descripción</label>
                                            <input type="text" class="form-control" id="_descripcion" name="Descripcion" required>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Código SAP Nuevo</label>
                                            <input type="text" class="form-control" id="_codSAPNuevo" name="CodSAPNuevo" required>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Código SAP Antiguo</label>
                                            <input type="text" class="form-control" id="_codOldSAP" name="CodOldSAP" required>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">ID STOCK</label>
                                            <input type="text" class="form-control" id="_idStock" name="IDStock" required>
                                        </div>
                                    </div>

                                    <!-- Columna derecha -->
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Clasificación Material</label>
                                            <select class="form-select" id="_clasificacionMaterialID" name="ClasificacionMaterialID" required>
                                                <option value="">Seleccione una clasificación</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Planta</label>
                                            <select class="form-select" id="_plantaId" name="PlantaID" required>
                                                <option value="">Seleccione una Planta</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Unidad Medida</label>
                                            <select class="form-select" id="_unidadMedidaId" name="UnidadMedidaID" required>
                                                <option value="">Seleccione una Unidad Medida</option>
                                            </select>
                                        </div>
                                        <!-- Switches -->
                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" id="_producido" name="Producido">
                                            <label class="form-check-label" for="_producido">Producido</label>
                                        </div>
                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" id="_consumido" name="Consumido">
                                            <label class="form-check-label" for="_consumido">Consumido</label>
                                        </div>
                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" id="_alterno" name="Alterno">
                                            <label class="form-check-label" for="_alterno">Alterno</label>
                                        </div>
                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" id="_afectaInventario" name="AfectaInventario">
                                            <label class="form-check-label" for="_afectaInventario">Afecta Inventario</label>
                                        </div>
                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" id="_activo" name="Activo">
                                            <label class="form-check-label" for="_activo">Activo</label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Botón y alerta -->
                                <div class="text-end mt-3">
                                    <button type="submit" id="crear" class="btn btn-outline-success m-1"
                                            data-url="@Url.Action("Create", "Material")">
                                        Crear <span class="text-success ms-2">&#10004;</span>
                                    </button>
                                </div>

                                <div id="alertSuccess" class="alert alert-success mt-3" role="alert" style="display: none;">
                                    ¡Creado exitosamente!
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

        @*_____________________________________________________________________________ Modal para Editar  ___________________________________________________________________*@
        <div class="modal fade" id="editar" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalLabel">Downtime Validation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="card-body">
                            <div class="card">
                                <div class="card-body">
                                    <form>
                                        <div class="card-body">
                                            <h4 class="card-title fw-semibold mb-2">Edit New Equipment</h4>
                                            <br />
                                            <input type="hidden" id="materialidhidden" value="" />
                                        </div>
                                        <div class="row">
                                            <!-- Columna izquierda -->
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label class="form-label">Descripción</label>
                                                    <input type="text" class="form-control" id="_descripcioneditar" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Código SAP Nuevo</label>
                                                    <input type="text" class="form-control" id="_codSAPNuevoeditar" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Código SAP Viejo</label>
                                                    <input type="text" class="form-control" id="_codOldSAPeditar" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">ID Stock</label>
                                                    <input type="text" class="form-control" id="_idStockeditar" required>
                                                </div>
                                            </div>

                                            <!-- Columna derecha -->
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label class="form-label">Clasificación Material</label>
                                                    <select class="form-select" id="_clasificacionMaterialIdeditar">
                                                        <option value="">Seleccione una clasificación</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Planta</label>
                                                    <select class="form-select" id="_plantaIdeditar">
                                                        <option value="">Seleccione una Planta</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Unidad Medida</label>
                                                    <select class="form-select" id="_unidadMedidaIdeditar">
                                                        <option value="">Seleccione una Planta</option>
                                                    </select>
                                                </div>
                                                <div class="form-check form-switch mb-3">
                                                    <input class="form-check-input" type="checkbox" id="_activoedit">
                                                    <label class="form-check-label" for="_activoedit">Activo</label>
                                                </div>

                                                <div class="form-check form-switch mb-3">
                                                    <input class="form-check-input" type="checkbox" id="_alternoeditar">
                                                    <label class="form-check-label" for="_alternoeditar">Alterno</label>
                                                </div>
                                                <div class="form-check form-switch mb-3">
                                                    <input class="form-check-input" type="checkbox" id="_afectaInventarioeditar">
                                                    <label class="form-check-label" for="_afectaInventarioeditar">Afecta Inventario</label>
                                                </div>
                                                <div class="form-check form-switch mb-3">
                                                    <input class="form-check-input" type="checkbox" id="_producidoeditar">
                                                    <label class="form-check-label" for="_producidoeditar">Producido</label>
                                                </div>
                                                <div class="form-check form-switch mb-3">
                                                    <input class="form-check-input" type="checkbox" id="_consumidoeditar">
                                                    <label class="form-check-label" for="_consumidoeditar">Consumido</label>
                                                </div>
                                            </div>
                                        </div>


                                        <!-- Botón y alerta -->
                                        <div class="text-end mt-3">
                                            <button type="button" id="editar"
                                                    class="btn btn-outline-success m-1"
                                                    data-url="@Url.Action("Edit", "Material")"
                                                    onclick="submitEditForm()">
                                                Editar <span class="text-success ms-2">&#10004;</span>
                                            </button>
                                        </div>
                                    </form>
                                    <div id="alertEditSuccess" class="alert alert-success" role="alert" style="display: none;">
                                        ¡Editado!
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</body>


@section scripts{
    <script src="~/Content/Modernize-1.0.0/src/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/js/sidebarmenu.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/js/app.min.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/libs/simplebar/dist/simplebar.js"></script>
}


<script>

    document.addEventListener("DOMContentLoaded", function () {
        loadTable();
    });

    function cargando() {
        document.getElementById("loadingModal").style.display = "block";
    }

    //___________________________________________________________________ Crear Material __________________________________________________________________//

    function newMaterial() {
    // Mostrar el modal
    const modalElement = document.getElementById("newMaterial");
    const modal = new bootstrap.Modal(modalElement);
    modal.show();

    // Cargar los combos al abrir
    cargarCombos();
}

    function cargarCombos() {
    // Limpiar selects
        limpiarSelect("_clasificacionMaterialID");
        limpiarSelect("_plantaId");


    // Llamadas AJAX a cada endpoint
    fetch('@Url.Action("GetClasificacionMaterial", "Material")')
        .then(response => response.json())
            .then(data => llenarSelect("_clasificacionMaterialID", data, "ClasificacionMaterialID", "Descripcion"));
    fetch('@Url.Action("GetPlanta", "Equipo")')
    .then(response => response.json())
            .then(data => llenarSelect("_plantaId", data, "PlantaID", "Descripcion"));
    fetch('@Url.Action("GetUnidadMedida", "DatosOperacion")')
         .then(response => response.json())
        .then(data => llenarSelect("_unidadMedidaId", data, "UnidadMedidaID", "Descripcion"));
}

    function llenarSelect(selectId, data, valueField, textField) {
    const select = document.getElementById(selectId);
    data.forEach(item => {
        const option = document.createElement("option");
        option.value = item[valueField];
        option.text = item[textField];
        select.appendChild(option);
    });
}

    function limpiarSelect(selectId) {
    const select = document.getElementById(selectId);
    select.innerHTML = '<option value="">Seleccione una opción</option>';
}



    document.getElementById("crear").addEventListener("click", crearNuevo);

    function crearNuevo() {
        // Obtener valores del formulario
        const descripcion = document.getElementById("_descripcion").value.trim();
        const codSAPNuevo = document.getElementById("_codSAPNuevo").value.trim();
        const codOldSAP = document.getElementById("_codOldSAP").value.trim();
        const idStock = document.getElementById("_idStock").value.trim();
        const clasificacionMaterialID = document.getElementById("_clasificacionMaterialID").value;
        const plantaId = document.getElementById("_plantaId").value;
        const unidadMedidaId = document.getElementById("_unidadMedidaId").value;
        const producido = document.getElementById("_producido").checked;
        const consumido = document.getElementById("_consumido").checked;
        const alterno = document.getElementById("_alterno").checked;
        const afectaInventario = document.getElementById("_afectaInventario").checked;
        const activo = document.getElementById("_activo").checked;

        const url = document.getElementById("crear").getAttribute("data-url");

        // Construir el objeto que será enviado al controlador
        const data = {
            _descripcion: descripcion,
            _codSAPNuevo: codSAPNuevo,
            _codOldSAP: codOldSAP,
            _idStock: idStock,
            _clasificacionMaterialID: parseInt(clasificacionMaterialID),
            _plantaId: parseInt(plantaId),
            _producido: producido,
            _alterno: alterno,
            _afectaInventario: afectaInventario,
            _activo: activo,
            _unidadMedidaId: unidadMedidaId,
            _consumido: consumido
        };

        // Enviar al backend vía fetch
        fetch(url, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(data)
        })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    // Mostrar alerta
                    document.getElementById("alertSuccess").style.display = "block";

                    // Ocultar modal y limpiar formulario después de unos segundos
                    setTimeout(() => {
                        document.getElementById("alertSuccess").style.display = "none";
                        var modal = bootstrap.Modal.getInstance(document.getElementById("newMaterial"));
                        modal.hide();
                        document.querySelector("#newMaterial form").reset();

                        //recargar la tabla
                        loadTable();
                    }, 1500);
                } else {
                    alert(result.message || "Ocurrió un error al crear el material.");
                }
            })
            .catch(error => {
                console.error("Error al enviar el formulario:", error);
                alert("Ocurrió un error al enviar los datos.");
            });
    }

    document.getElementById('formNewMaterial').addEventListener('submit', function (e) {
        if (!this.checkValidity()) {
            e.preventDefault();
            e.stopPropagation();
        }
        this.classList.add('was-validated'); // estilos bootstrap
    });
    //____________________________________________________________________ Mostrar datatable_______________________________________________//



    function loadTable() {
    const tbody = document.getElementById('downtimeTableBody');
    tbody.innerHTML = ''; // Limpiar contenido anterior

    cargando(); // Mostrar modal de carga

    fetch('@Url.Action("GetMateriales", "Material")')
        .then(response => {
            if (!response.ok) throw new Error("Error al obtener los datos.");
            return response.json();
        })
        .then(data => {
            if (!data.success || !Array.isArray(data.data)) {
                alert("La respuesta del servidor no es válida.");
                return;
            }

            // 👉 Mostrar TODOS (sin filtrar por _activo)
            const materiales = data.data;

            materiales.forEach(item => {
                const row = document.createElement('tr');

                const iconActivo = item._activo
                    ? '<i class="bi bi-check-circle-fill text-success"></i>'
                    : '<i class="bi bi-x-circle-fill text-danger"></i>';

                const Producido = item._producido
                    ? '<i class="bi bi-check-circle-fill text-success"></i>'
                    : '<i class="bi bi-x-circle-fill text-danger"></i>';

                const Consumido = item._consumido
                    ? '<i class="bi bi-check-circle-fill text-success"></i>'
                    : '<i class="bi bi-x-circle-fill text-danger"></i>';

                row.innerHTML = `
                    <td class="text-center">
                        ${iconActivo}
                    </td>
                    <td class="text-center">${item._descripcion || ''}</td>
                    <td class="text-center">${item._codSAPNuevo || ''}</td>
                    <td class="text-center">${item._idStock || ''}</td>
                    <td class="text-center">${item._unidadDescripcion || ''}</td>
                    <td class="text-center">
                       ${Producido}
                    </td>
                    <td class="text-center">
                       ${Consumido}
                    </td>
                    <td class="text-center bg-white">
                        <a class="dropdown-item" href="javascript:void(0)" onclick="abrirModalEditar(${item._materialID})">
                            <i class="bi bi-pencil me-2"></i>
                        </a>
                    </td>
                `;

                tbody.appendChild(row);
            });
        })
        .catch(error => {
            console.error("Error cargando la tabla de materiales:", error);
            alert("Ocurrió un error al cargar los materiales.");
        })
        .finally(() => {
            // Ocultar modal de carga
            const lm = document.getElementById("loadingModal");
            if (lm) lm.style.display = "none";
        });
}





    //____________________________________________________________________ Editar _________________________________________________________________//


  function abrirModalEditar(materialId) {
  document.getElementById("loadingModal").style.display = "block";

  const urlClasif   = '@Url.Action("GetClasificacionMaterial", "Material")';
  const urlPlantas  = '@Url.Action("GetPlanta", "Equipo")';
  const urlUnidades = '@Url.Action("GetUnidadMedida", "DatosOperacion")';
  const urlMaterial = '@Url.Action("GetMaterialId", "Material")' + '?materialId=' + encodeURIComponent(materialId);

  const cargarClasificaciones = fetch(urlClasif).then(r => r.json());
  const cargarPlantas        = fetch(urlPlantas).then(r => r.json());
  const cargarUnidades       = fetch(urlUnidades).then(r => r.json());

  Promise.all([cargarClasificaciones, cargarPlantas, cargarUnidades])
    .then(([clasificaciones, plantas, unidades]) => {
      // Clasificación
      const selClas = document.getElementById('_clasificacionMaterialIdeditar');
      selClas.innerHTML = '<option value="">Seleccione una clasificacion</option>';
      (clasificaciones || []).forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.ClasificacionMaterialID);
        opt.textContent = item.Descripcion;
        selClas.appendChild(opt);
      });

      // Plantas
      const selPlanta = document.getElementById('_plantaIdeditar');
      selPlanta.innerHTML = '<option value="">Seleccione una Planta</option>';
      (plantas || []).forEach(p => {
        const opt = document.createElement('option');
        opt.value = String(p.PlantaID);
        opt.textContent = (p.Descripcion && p.Descripcion.trim()) ? p.Descripcion.trim() : ('Planta ' + p.PlantaID);
        selPlanta.appendChild(opt);
      });

      // Unidades de Medida
      const selUnidad = document.getElementById('_unidadMedidaIdeditar');
      if (selUnidad) {
        selUnidad.innerHTML = '<option value="">Seleccione una unidad</option>';
        (unidades || []).forEach(u => {
          const opt = document.createElement('option');
          opt.value = String(u.UnidadMedidaID);
          opt.textContent = u.Descripcion;
          selUnidad.appendChild(opt);
        });
      }

      // Ahora obtener el material
      return fetch(urlMaterial);
    })
    .then(res => res.json())
    .then(result => {
      if (!result || !result.success) {
        alert("No se encontro el material.");
        return;
      }

      const data = result.data || {};

      // Campos base
      document.getElementById("materialidhidden").value = data._materialID ?? '';
      document.getElementById("_descripcioneditar").value = data._descripcion || "";
      document.getElementById("_codSAPNuevoeditar").value = data._codSAPNuevo || "";
      document.getElementById("_codOldSAPeditar").value = data._codOldSAP || "";
      document.getElementById("_producidoeditar").checked = !!data._producido;
      document.getElementById("_clasificacionMaterialIdeditar").value = (data._clasificacionMaterialID ?? "").toString();
      document.getElementById("_activoedit").checked = !!data._activo;
      document.getElementById("_alternoeditar").checked = !!data._alterno;
      document.getElementById("_afectaInventarioeditar").checked = !!data._afectaInventario;
      document.getElementById("_idStockeditar").value = data._idStock || "";
      document.getElementById("_consumidoeditar").checked = !!data._consumido;


      // Planta
      const plantaFromData = data._plantaId;
      if (plantaFromData !== null && plantaFromData !== undefined) {
        const selPlanta = document.getElementById('_plantaIdeditar');
        const v = String(plantaFromData).trim();
        selPlanta.value = v;
        if (selPlanta.value !== v) {
          const opt = document.createElement('option');
          opt.value = v;
          const desc = data._plantaDescripcion || data.PlantaDescripcion || `Planta ${v}`;
          opt.textContent = String(desc);
          selPlanta.appendChild(opt);
          selPlanta.value = v;
        }
      }

      // Unidad de Medida (soporta _unidadMedidaID o _unidadMedidaId)
      const unidadFromData = (data._unidadMedidaID ?? data._unidadMedidaId ?? data.UnidadMedidaID ?? data.UnidadMedidaId);
      const selUnidad = document.getElementById('_unidadMedidaIdeditar');
      if (selUnidad) {
        if (unidadFromData !== null && unidadFromData !== undefined && String(unidadFromData) !== "") {
          const vUM = String(unidadFromData).trim();
          selUnidad.value = vUM;

          // Si no existe en el combo, agregarlo on-the-fly
          if (selUnidad.value !== vUM) {
            const opt = document.createElement('option');
            opt.value = vUM;
            const descUM = data._unidadMedidaDescripcion || data.UnidadMedidaDescripcion || `UM ${vUM}`;
            opt.textContent = String(descUM);
            selUnidad.appendChild(opt);
            selUnidad.value = vUM;
          }
        } else {
          if (!selUnidad.querySelector('option[value=""]')) {
            const opt = document.createElement('option');
            opt.value = "";
            opt.textContent = "Seleccione una unidad";
            selUnidad.insertBefore(opt, selUnidad.firstChild);
          }
          selUnidad.value = "";
        }
      }

      // Mostrar modal
      const modalElement = document.getElementById("editar");
      const modal = new bootstrap.Modal(modalElement);
      modal.show();
    })
    .catch(err => {
      console.error("Error al cargar datos:", err);
      alert("Ocurrio un error al cargar los datos.");
    })
    .finally(() => {
      document.getElementById("loadingModal").style.display = "none";
    });
}

  function submitEditForm() {
  cargando();

  const plantaVal = document.getElementById('_plantaIdeditar')?.value || '';
  const plantaID = plantaVal === '' ? null : parseInt(plantaVal, 10);

  const clasifVal = document.getElementById('_clasificacionMaterialIdeditar')?.value || '';
  const materialIdVal = document.getElementById('materialidhidden')?.value || '';

  // Unidad de Medida
  const umVal = document.getElementById('_unidadMedidaIdeditar')?.value || '';
  const unidadMedidaID = umVal === '' ? null : parseInt(umVal, 10);

  const data = {
    _materialId: materialIdVal === '' ? null : parseInt(materialIdVal, 10),
    _descripcion: (document.getElementById('_descripcioneditar').value || '').trim(),
    _codSAPNuevo: (document.getElementById('_codSAPNuevoeditar').value || '').trim(),
    _codOldSAP: (document.getElementById('_codOldSAPeditar').value || '').trim(),
    _producido: document.getElementById('_producidoeditar').checked,
    _consumido: document.getElementById('_consumidoeditar').checked,
    _clasificacionMaterialID: clasifVal === '' ? null : parseInt(clasifVal, 10),
    _activo: document.getElementById('_activoedit').checked,
    _alterno: document.getElementById('_alternoeditar').checked,
    _afectaInventario: document.getElementById('_afectaInventarioeditar').checked,
    _idStock: (document.getElementById('_idStockeditar').value || '').trim(),
    _plantaID: plantaID,
    _unidadMedidaID: unidadMedidaID   // <<< AQUI se envía la UM
  };

  fetch('@Url.Action("Edit", "Material")', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
    credentials: 'same-origin'
  })
  .then(res => {
    if (!res.ok) throw new Error('HTTP ' + res.status);
    return res.json();
  })
  .then(response => {
    if (response.success) {
      document.getElementById('alertEditSuccess').style.display = 'block';
      setTimeout(() => {
        document.getElementById('alertEditSuccess').style.display = 'none';
        const modal = bootstrap.Modal.getInstance(document.getElementById('editar'));
        if (modal) modal.hide();
        location.reload();
      }, 1200);
    } else {
      alert('Error: ' + (response.message || 'No se pudo guardar'));
    }
  })
  .catch(error => {
    console.error('Error al enviar datos:', error);
    alert('Ocurrio un error al enviar los datos.');
  })
  .finally(() => {
    const lm = document.getElementById('loadingModal');
    if (lm) lm.style.display = 'none';
  });
}



