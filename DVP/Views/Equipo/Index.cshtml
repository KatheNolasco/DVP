                                                Editar <span class="text-success ms-2">&#10004;</span>
                                            </button>
                                        </div>
                                    </form>
                                    <div id="alertEditeSuccesseditar" class="alert alert-success" role="alert" style="display: none;">
                                        ¡Editado!
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</body>


@section scripts{
    <script src="~/Content/Modernize-1.0.0/src/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/js/sidebarmenu.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/js/app.min.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/libs/simplebar/dist/simplebar.js"></script>
}


<script>

    document.addEventListener("DOMContentLoaded", function () {
        loadEquipmentTable();
    });

    function cargando() {
        document.getElementById("loadingModal").style.display = "block";
    }

    //___________________________________________________________________ Crear Equipo __________________________________________________________________//

    // ======================= ANTI DOBLE-CLICK (FLAG GLOBAL) =======================
let isCreateSubmitting = false;

// ======================= ABRIR MODAL NUEVO EQUIPO ============================
function newEquipment() {
    const modalElement = document.getElementById("newEquipment");
    const modal = new bootstrap.Modal(modalElement);
    modal.show();
    cargarCombosEquipo();
}

// ======================= CARGA DE COMBOS =====================================
function cargarCombosEquipo() {
    limpiarSelect("_procesoId");
    limpiarSelect("_plantaId");
    limpiarSelect("_unidadOperativaId");
    limpiarSelect("_paisId");

    fetch('@Url.Action("GetProceso", "Equipo")')
        .then(r => r.json())
        .then(data => llenarSelect("_procesoId", data, "ProcesoID", "Descripcion"));

    fetch('@Url.Action("GetPlanta", "Equipo")')
        .then(r => r.json())
        .then(data => llenarSelect("_plantaId", data, "PlantaID", "Descripcion"));

    fetch('@Url.Action("GetUnidadOperativa", "Equipo")')
        .then(r => r.json())
        .then(data => llenarSelect("_unidadOperativaId", data, "UnidadOperativaID", "Descripcion"));

    fetch('@Url.Action("GetPais", "Equipo")')
        .then(r => r.json())
        .then(data => llenarSelect("_paisId", data, "PaisID", "Descripcion"));
}

function llenarSelect(selectId, data, valueField, textField) {
    const select = document.getElementById(selectId);
    data.forEach(item => {
        const option = document.createElement("option");
        option.value = item[valueField];
        option.text = item[textField];
        select.appendChild(option);
    });
}

function limpiarSelect(selectId) {
    const select = document.getElementById(selectId);
    select.innerHTML = '<option value="">Seleccione una opción</option>';
}

// ======================= LISTENER DEL BOTÓN (ANTI DOBLE CLICK) ===============
const btnCrear = document.getElementById("crearequipo");
btnCrear.addEventListener("click", function () {
    if (isCreateSubmitting) return;           // evita doble click inmediato
    isCreateSubmitting = true;

    // Deshabilita visual y funcionalmente el botón
    btnCrear.disabled = true;
    btnCrear.style.pointerEvents = 'none';
    btnCrear.dataset.originalHtml = btnCrear.innerHTML;
    btnCrear.innerHTML = 'Creando…';
    btnCrear.setAttribute('aria-busy', 'true');

    // Llama a la función (devuelve promesa)
    crearEquipoNuevo()
        .catch(() => { /* el manejo de error ya re-habilita abajo */ });
});

// ======================= CREAR EQUIPO (RETORNA PROMESA) ======================
function crearEquipoNuevo() {
    // Doble guard por si llaman la función directamente
    if (isCreateSubmitting !== true) isCreateSubmitting = true;

    // Obtener valores del formulario
    const descripcion        = document.getElementById("_descripcion").value.trim();
    const condigoDetalle     = document.getElementById("_condigoDetalle").value.trim();
    const condigoSAP         = document.getElementById("_codigoSAP").value.trim();
    const personasAsignadas  = document.getElementById("_personasAsignadas").value.trim();
    const procesoId          = document.getElementById("_procesoId").value;
    const plantaId           = document.getElementById("_plantaId").value;
    const unidadOperativaId  = document.getElementById("_unidadOperativaId").value;
    const paisId             = document.getElementById("_paisId").value;
    const buscarParo         = document.getElementById("_buscarParo").checked;
    const active             = document.getElementById("_active").checked;
    const enviarASAP         = document.getElementById("_enviarASAP").checked;

    const url = document.getElementById("crearequipo").getAttribute("data-url");

    // Construir payload
    const data = {
        _descripcion: descripcion,
        _condigoDetalle: condigoDetalle,
        _condigoSAP: condigoSAP,
        _procesoId: parseInt(procesoId),
        _plantaId: parseInt(plantaId),
        _unidadOperativaId: parseInt(unidadOperativaId),
        _paisId: parseInt(paisId),
        _buscarParo: buscarParo,
        _active: active,
        _enviarASAP: enviarASAP,
        _personasAsignadas: personasAsignadas
    };

    // Enviar al backend vía fetch
    return fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data)
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            // Mostrar alerta
            document.getElementById("alertSuccess").style.display = "block";

            // Cerrar modal, limpiar y recargar tabla
            setTimeout(() => {
                document.getElementById("alertSuccess").style.display = "none";
                const modal = bootstrap.Modal.getInstance(document.getElementById("newEquipment"));
                modal.hide();
                document.querySelector("#newEquipment form").reset();

                if (typeof loadEquipmentTable === 'function') {
                    loadEquipmentTable();
                }

                // Rehabilitar botón y liberar candado (flujo exitoso)
                btnCrear.disabled = false;
                btnCrear.style.pointerEvents = '';
                btnCrear.innerHTML = btnCrear.dataset.originalHtml || 'Crear';
                btnCrear.removeAttribute('aria-busy');
                isCreateSubmitting = false;
            }, 1500);
        } else {
            alert(result.message || "Ocurrió un error al crear el equipo.");

            // Rehabilitar en error lógico
            btnCrear.disabled = false;
            btnCrear.style.pointerEvents = '';
            btnCrear.innerHTML = btnCrear.dataset.originalHtml || 'Crear';
            btnCrear.removeAttribute('aria-busy');
            isCreateSubmitting = false;
        }
    })
    .catch(error => {
        console.error("Error al enviar el formulario:", error);
        alert("Ocurrió un error al enviar los datos.");

        // Rehabilitar en error de red
        btnCrear.disabled = false;
        btnCrear.style.pointerEvents = '';
        btnCrear.innerHTML = btnCrear.dataset.originalHtml || 'Crear';
        btnCrear.removeAttribute('aria-busy');
        isCreateSubmitting = false;

        // Propaga por si arriba quisieras manejarlo
        throw error;
    });
}

    //____________________________________________________________________ Mostrar Equipos en el datatable_______________________________________________//



    function loadEquipmentTable() {
    const tbody = document.getElementById('downtimeTableBody');
    tbody.innerHTML = '';

    cargando(); // mostrar modal de carga

    fetch('@Url.Action("GetEquipos", "Equipo")')
        .then(response => {
            if (!response.ok) throw new Error('Error al obtener los datos.');
            return response.json();
        })
        .then(data => {
            if (!data || !data.success || !Array.isArray(data.data)) {
                alert('La respuesta del servidor no es valida.');
                return;
            }

            // traer TODOS (activos e inactivos)
            const equipos = data.data;

            equipos.forEach(item => {
                const row = document.createElement('tr');

                const isActive = item._active === true;
                const estadoIcon = isActive
                    ? '<i class="bi bi-check-circle-fill text-success" title="Activo"></i>'
                    : '<i class="bi bi-x-circle-fill text-danger" title="Inactivo"></i>';

                row.innerHTML = `
                    <td class="text-center">${estadoIcon}</td>
                    <td class="text-center">${item._procesoDescripcion ?? ''}</td>
                    <td class="text-center">${item._descripcion ?? ''}</td>
                    <td class="text-center">${item._plantaDescripcion ?? ''}</td>
                    <td class="text-center">${item._condigoSAP ?? ''}</td>
                    <td class="text-center">${item._condigoDetalle ?? ''}</td>
                    <td class="text-center">
                        ${item._enviarASAP ? '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-x-circle-fill text-danger"></i>'}
                    </td>
                    <td class="text-center">
                        ${item._buscarParo ? '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-x-circle-fill text-danger"></i>'}
                    </td>
                    <td class="text-center">${item._personasAsignadas ?? ''}</td>
                    <td class="text-center bg-white">
                        <a class="dropdown-item" href="javascript:void(0)" onclick="abrirModalEditarEquipo(${item._equipoId})">
                            <i class="bi bi-pencil me-2"></i>
                        </a>
                    </td>
                `;

                tbody.appendChild(row);
            });
        })
        .catch(error => {
            console.error('Error cargando la tabla de equipos:', error);
            alert('Ocurrio un error al cargar los equipos.');
        })
        .finally(() => {
            document.getElementById('loadingModal').style.display = 'none';
        });
}





    //____________________________________________________________________ Editar Equipo_________________________________________________________________//


    function abrirModalEditarEquipo(equipoId) {
    // Mostrar cargando
    document.getElementById("loadingModal").style.display = "block";

    Promise.all([
        fetch('@Url.Action("GetProceso", "Equipo")').then(res => res.json()),
        fetch('@Url.Action("GetPlanta", "Equipo")').then(res => res.json()),
        fetch('@Url.Action("GetUnidadOperativa", "Equipo")').then(res => res.json()),
        fetch('@Url.Action("GetPais", "Equipo")').then(res => res.json())
    ])
    .then(([procesos, plantas, unidades, paises]) => {
        llenarSelect('_procesoIdeditar', procesos, 'ProcesoID', 'Descripcion');
        llenarSelect('_plantaIdeditar', plantas, 'PlantaID', 'Descripcion');
        llenarSelect('_unidadOperativaIdeditar', unidades, 'UnidadOperativaID', 'Descripcion');
        llenarSelect('_paisIdeditar', paises, 'PaisID', 'Descripcion');

        return fetch('@Url.Action("GetEquipoId", "Equipo")' + '?equipoId=' + equipoId);
    })
    .then(res => res.json())
    .then(result => {
        if (result.success) {
            const data = result.data;

            document.getElementById("equipoIdhidden").value = data._equipoId;
            document.getElementById("_descripcioneditar").value = data._descripcion;
            document.getElementById("_condigoDetalleeditar").value = data._condigoDetalle;
            document.getElementById("_codigoSAPeditar").value = data._condigoSAP;
            document.getElementById("_personasAsignadaseditar").value = data._personasAsignadas;
            document.getElementById("_buscarParoeditar").checked = data._buscarParo;
            document.getElementById("_activeeditar").checked = data._active;
            document.getElementById("_enviarASAPeditar").checked = data._enviarASAP;

            setTimeout(() => {
                document.getElementById("_procesoIdeditar").value = data._procesoID?.toString();
                document.getElementById("_plantaIdeditar").value = data._plantaID?.toString();
                document.getElementById("_unidadOperativaIdeditar").value = data._unidadOperativaID?.toString();
                document.getElementById("_paisIdeditar").value = data._paisID?.toString();
            }, 100);

            // Abrir modal de edición
            const modalElement = document.getElementById("editEquipment");
            const modal = new bootstrap.Modal(modalElement);
            modal.show();
        } else {
            alert("Error al obtener datos del equipo: " + result.message);
        }
    })
    .catch(error => {
        console.error("Error:", error);
        alert("Error al cargar el formulario de edición.");
    })
    .finally(() => {
        // Ocultar cargando siempre al final
        document.getElementById("loadingModal").style.display = "none";
    });
}




    function llenarSelect(selectId, items, valueProp, textProp) {
        const select = document.getElementById(selectId);
        select.innerHTML = '<option value="">Seleccione una opción</option>';

        items.forEach(item => {
            const option = document.createElement("option");
            option.value = item[valueProp];
            option.textContent = item[textProp];
            select.appendChild(option);
        });
    }


    function submitEditEquipmentForm() {
    cargando();

    // deshabilitar el botón Editar para evitar doble submit
    const btnSave = document.getElementById('editarequipo');
    if (btnSave && !btnSave.disabled) {
        btnSave.disabled = true;
        btnSave.dataset.originalHtml = btnSave.innerHTML; // guarda HTML (incluye el <span>)
        btnSave.innerHTML = 'Guardando…';
    }

    const data = {
        _equipoId: document.getElementById("equipoIdhidden").value,
        _descripcion: document.getElementById("_descripcioneditar").value,
        _condigoDetalle: document.getElementById("_condigoDetalleeditar").value,
        _condigoSAP: document.getElementById("_codigoSAPeditar").value,
        _personasAsignadas: document.getElementById("_personasAsignadaseditar").value,
        _procesoId: document.getElementById("_procesoIdeditar").value,
        _plantaId: document.getElementById("_plantaIdeditar").value,
        _unidadOperativaId: document.getElementById("_unidadOperativaIdeditar").value,
        _paisId: document.getElementById("_paisIdeditar").value,
        _buscarParo: document.getElementById("_buscarParoeditar").checked,
        _active: document.getElementById("_activeeditar").checked,
        _enviarASAP: document.getElementById("_enviarASAPeditar").checked
    };

    fetch('@Url.Action("EditEquipment", "Equipo")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    })
    .then(res => res.json())
    .then(response => {
        if (response.success) {
            // mostrar éxito
            document.getElementById("alertEditeSuccesseditar").style.display = "block";

            setTimeout(() => {
                document.getElementById("alertEditeSuccesseditar").style.display = "none";
                const modal = bootstrap.Modal.getInstance(document.getElementById("editEquipment"));
                modal.hide();
                location.reload();
            }, 2000);
        } else {
            alert("Error: " + response.message);
            // re-habilitar si hubo error lógico
            if (btnSave) {
                btnSave.disabled = false;
                btnSave.innerHTML = btnSave.dataset.originalHtml || 'Editar';
            }
        }
    })
    .catch(error => {
        console.error("Error al enviar datos:", error);
        alert("Ocurrió un error al enviar los datos.");
        // re-habilitar si hubo error de red
        if (btnSave) {
            btnSave.disabled = false;
            btnSave.innerHTML = btnSave.dataset.originalHtml || 'Editar';
        }
    });
}




