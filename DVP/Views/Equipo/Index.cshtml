
@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

@model DVP.Models.EquipoViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Downtime Page";

}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<style>
    /* Estilo para el contenedor de la fecha y hora */
    .container {
        font-family: Arial, sans-serif;
        display: flex; /* Usamos flex para alinearlos horizontalmente */
        justify-content: center; /* Centra los elementos horizontalmente */
        align-items: center; /* Centra los elementos verticalmente */
        gap: 20px; /* Espacio entre los divs */
        margin-top: 20px;
    }
    /* Estilo para los divs de fecha y hora */
    .input-container {
        font-size: 18px;
        display: flex;
        flex-direction: column; /* Los inputs se alinean de arriba hacia abajo */
        align-items: center;
    }

    input {
        padding: 10px;
        font-size: 16px;
        margin-top: 10px;
        border: 2px solid #ccc;
        border-radius: 8px;
        background-color: #f0f0f0;
    }

    .scrollable-table {
        max-height: 400px;
        overflow-y: auto;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa; /* color fondo header */
        z-index: 2;
        text-align: center;
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
        text-align: center;
    }

    .form-check-input:checked {
        background-color: #13DEB9 !important; /* bg-success */
        border-color: #13DEB9 !important;
    }

    /* Opcional: cambiar el texto también */
    .form-check-label {
        font-weight: 500;
    }
</style>

<body>
    <div class="container-fluid" style="padding-left: 200px;">
        <br />
        <br />
        <br />
        <div class="card">
            <div class="container-fluid">
                <div class="container-fluid">
                    <div class="card">
                        <div class="card-body">
                            <!-- Fecha de validación -->
                            <h5 class="card-title fw-semibold mb-4 text-end">
                            </h5>
                            <div id="alertsuccesnewequipment" class="alert alert-success" role="alert" style="display: none;">
                                Equipo agregado correctamente!
                            </div>
                            <!-- Equipos -->
                            <h5 class="card-title fw-semibold mb-4">Equipments Configuration</h5>
                        </div>
                        <!-- Sección de Listas -->
                        <div class="card w-100">
                            <div class="card-body p-4">
                                <div class="text-end mb-3">
                                    <div class="d-flex justify-content-end align-items-center gap-2 mb-3">
                                        <i class="bi bi-binoculars-fill text-success"></i>
                                        <input type="text" class="form-control form-control-sm w-25" id="_buscar" placeholder="Buscar...">
                                        <button type="button" onclick="newEquipment()" class="btn btn-outline-dark btn-sm">
                                            Add new
                                        </button>
                                    </div>
                                </div>
                                <div class="d-flex gap-3">
                                    <!-- Tabla más ancha (downtimes activos) -->
                                    <div class="table-responsive w-100" style="max-height: 400px; overflow-y: auto; background-color: #ffffff; padding: 10px; border-radius: 10px;">
                                        <table class="table table-bordered mb-0" style="background-color: #ffffff;">
                                            <thead style="position: sticky; top: 0; background-color: #ffffff; z-index: 2;">
                                                <tr>
                                                    <th class="text-center">Status</th>
                                                    <th class="text-center">Process</th>
                                                    <th class="text-center">Equipment</th>
                                                    <th class="text-center">Plant</th>
                                                    <th class="text-center">Old SAP code</th>
                                                    <th class="text-center">New detail code </th>
                                                    <th class="text-center">Send to SAP</th>
                                                    <th class="text-center">Search in PI</th>
                                                    <th class="text-center">Personas Asignadas</th>
                                                    <th class="text-center">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="downtimeTableBody">
                                                <tr>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>



        @*___________________________________________________________________Modal Cargando__________________________________________________*@
        <div id="loadingModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; background-color: rgba(0, 0, 0, 0.5);">
            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background-color: white; padding: 25px 35px; border-radius: 10px; box-shadow: 0 0 15px rgba(0,0,0,0.3); min-width: 250px;">
                <div style="display: flex; align-items: center; justify-content: center;">
                    <img src="/Content/loading-green-loading.gif" alt="Cargando..." style="width: 40px; height: 40px; margin-right: 15px;" />
                    <span style="color: black; font-size: 16px;">Cargando...</span>
                </div>
            </div>
        </div>


        @*______________________________________________________________________Modal crear equipo _________________________________________________________________________*@

        <div class="modal fade" id="newEquipment" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="card-body">
                            <div class="card">
                                <form>
                                    <div class="card-body">
                                        <h4 class="card-title fw-semibold mb-2">Add New Equipment</h4>
                                        <br />
                                    </div>
                                    <div class="row">
                                        <!-- Columna izquierda -->
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label class="form-label">Descripción</label>
                                                <input type="text" class="form-control" id="_descripcion" required>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Código Detalle</label>
                                                <input type="text" class="form-control" id="_condigoDetalle" required>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Código SAP</label>
                                                <input type="text" class="form-control" id="_codigoSAP" required>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Personas Asignadas</label>
                                                <input type="number" class="form-control" id="_personasAsignadas" required>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Proceso</label>
                                                <select class="form-select" id="_procesoId">
                                                    <option value="">Seleccione un proceso</option>
                                                </select>
                                            </div>
                                        </div>

                                        <!-- Columna derecha -->
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label class="form-label">Planta</label>
                                                <select class="form-select" id="_plantaId">
                                                    <option value="">Seleccione una planta</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Unidad Operativa</label>
                                                <select class="form-select" id="_unidadOperativaId">
                                                    <option value="">Seleccione una Unidad Operativa</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">País</label>
                                                <select class="form-select" id="_paisId">
                                                    <option value="">Seleccione un país</option>
                                                </select>
                                            </div>
                                            <!-- Switches -->
                                            <div class="form-check form-switch mb-3">
                                                <input class="form-check-input" type="checkbox" id="_buscarParo">
                                                <label class="form-check-label" for="_buscarParo">Buscar Paro</label>
                                            </div>
                                            <div class="form-check form-switch mb-3">
                                                <input class="form-check-input" type="checkbox" id="_active">
                                                <label class="form-check-label" for="_active">Activo</label>
                                            </div>
                                            <div class="form-check form-switch mb-3">
                                                <input class="form-check-input" type="checkbox" id="_enviarASAP">
                                                <label class="form-check-label" for="_enviarASAP">Enviar a SAP</label>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Botón y alerta -->
                                    <div class="text-end mt-3">
                                        <button type="button" id="crearequipo" class="btn btn-outline-success m-1"
                                                data-url="@Url.Action("CreateEquipment", "Equipo")">
                                            Crear <span class="text-success ms-2">&#10004;</span>
                                        </button>
                                    </div>

                                    <div id="alertSuccess" class="alert alert-success mt-3" role="alert" style="display: none;">
                                        ¡Equipo creado exitosamente!
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @*_____________________________________________________________________________ Modal para Editar equipo ___________________________________________________________________*@


        <div class="modal fade" id="editEquipment" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalLabel">Downtime Validation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="card-body">
                            <div class="card">
                                <div class="card-body">
                                    <form>
                                        <div class="card-body">
                                            <h4 class="card-title fw-semibold mb-2">Edit New Equipment</h4>
                                            <br />
                                            <input type="hidden" id="equipoIdhidden" value=""/>
                                        </div>
                                        <div class="row">
                                            <!-- Columna izquierda -->
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label class="form-label">Descripción</label>
                                                    <input type="text" class="form-control" id="_descripcioneditar" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Código Detalle</label>
                                                    <input type="text" class="form-control" id="_condigoDetalleeditar" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Código SAP</label>
                                                    <input type="text" class="form-control" id="_codigoSAPeditar" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Personas Asignadas</label>
                                                    <input type="number" class="form-control" id="_personasAsignadaseditar" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Proceso</label>
                                                    <select class="form-select" id="_procesoIdeditar">
                                                        <option value="">Seleccione un proceso</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <!-- Columna derecha -->
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label class="form-label">Planta</label>
                                                    <select class="form-select" id="_plantaIdeditar">
                                                        <option value="">Seleccione una planta</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Unidad Operativa</label>
                                                    <select class="form-select" id="_unidadOperativaIdeditar">
                                                        <option value="">Seleccione una Unidad Operativa</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">País</label>
                                                    <select class="form-select" id="_paisIdeditar">
                                                        <option value="">Seleccione un país</option>
                                                    </select>
                                                </div>
                                                <!-- Switches -->
                                                <div class="form-check form-switch mb-3">
                                                    <input class="form-check-input" type="checkbox" id="_buscarParoeditar">
                                                    <label class="form-check-label" for="_buscarParoeditar">Buscar Paro</label>
                                                </div>
                                                <div class="form-check form-switch mb-3">
                                                    <input class="form-check-input" type="checkbox" id="_activeeditar">
                                                    <label class="form-check-label" for="_activeeditar">Activo</label>
                                                </div>
                                                <div class="form-check form-switch mb-3">
                                                    <input class="form-check-input" type="checkbox" id="_enviarASAPeditar">
                                                    <label class="form-check-label" for="_enviarASAPeditar">Enviar a SAP</label>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Botón y alerta -->
                                        <div class="text-end mt-3">
                                            <button type="button" id="editarequipo"
