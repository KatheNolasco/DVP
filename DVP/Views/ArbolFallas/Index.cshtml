        // render ESPECIAL: Clasificacion (con CodigoDet + switches + TipoParo)
        async function handleClasificacion() {
            clearUI();
            const [data, tiposParo] = await Promise.all([
                loadClasificaciones().catch(() => []),
                loadTiposParo().catch(() => [])
            ]);
            renderClasificacionTable(data, tiposParo);
        }

        function renderClasificacionTable(data, tiposParo = []) {
            if (data?.error) {
                contenedorListado.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
                return;
            }
