            contenedorListado.querySelectorAll('.btn-cancel').forEach(btn => {
                btn.addEventListener('click', () => {
                    const tr = btn.closest('tr');
                    const spanDesc = tr.querySelector('.cell-text-desc');
                    const inputDesc = tr.querySelector('.cell-input-desc');
                    inputDesc.value = spanDesc.textContent || '';
                    if (hasCode) {
                        const spanCod = tr.querySelector('.cell-text-cod');
                        const inputCod = tr.querySelector('.cell-input-cod');
                        inputCod.value = spanCod?.textContent || '';
                    }
                    setEditModeRow(tr, false, hasCode);
                });
            });
            contenedorListado.querySelectorAll('.btn-save').forEach(btn => {
