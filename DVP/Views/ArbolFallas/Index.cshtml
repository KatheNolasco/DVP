  <td>
    <span class="cell-text-tp">${escapeHtml(tipoParoDesc)}</span>
    <select class="form-select form-select-sm cell-input-tp" style="display:none;">
      <option value="">Seleccione un tipo de paro</option>
      ${tpOptions}
    </select>
  </td>

  <td class="text-nowrap text-center">
    ${bloqueado
                        ? `<span class="badge bg-secondary">No editable</span>`
                        : `
      <button type="button" class="btn btn-sm btn-outline-primary btn-edit">Editar</button>
      <button type="button" class="btn btn-sm btn-success btn-save" style="display:none;">Guardar</button>
      <button type="button" class="btn btn-sm btn-secondary btn-cancel" style="display:none;">Cancelar</button>
    `}
  </td>
</tr>`;
            }).join('');

            contenedorListado.innerHTML = `
<table class="table table-bordered table-sm table-striped align-middle">
  <thead>
    <tr>
      <th style="width:60px;">#</th>
      <th>Descripción</th>
      <th>Código Det.</th>
      <th class="text-center" style="width:120px;">Ajeno</th>
      <th class="text-center" style="width:150px;">Afecta TMEF</th>
      <th style="width:220px;">Tipo de paro</th>
      <th style="width:210px;">Acciones</th>
    </tr>
  </thead>
  <tbody>${rowsHtml}</tbody>
</table>`;

            // Delegacion de eventos SOLO para la tabla de Clasificacion
            contenedorListado.onclick = async (e) => {
                const btn = e.target.closest('button');
                if (!btn) return;
                const tr = btn.closest('tr');
                if (!tr) return;

                if (btn.classList.contains('btn-edit')) {
                    setEditModeClasificacion(tr, true);
                } else if (btn.classList.contains('btn-cancel')) {
                    setEditModeClasificacion(tr, false, /*restore=*/true);
                } else if (btn.classList.contains('btn-save')) {
                    await saveRowClasificacion(tr);
                }
            };

            // NUEVO: Delegacion de cambios para switches AJENO / AFECTA (mutuamente excluyentes en edicion)
            contenedorListado.onchange = (e) => {
                const input = e.target.closest('input');
                if (!input) return;
                if (!input.classList.contains('chk-ajeno') && !input.classList.contains('chk-afecta')) return;
                if (input.disabled) return; // solo en modo edición

                const tr = input.closest('tr');
                if (!tr) return;
                const aj = tr.querySelector('.chk-ajeno');
                const af = tr.querySelector('.chk-afecta');
                if (!aj || !af) return;

                if (input.classList.contains('chk-ajeno') && aj.checked) {
                    af.checked = false;
                } else if (input.classList.contains('chk-afecta') && af.checked) {
                    aj.checked = false;
                }
            };
        }

        // helpers de edicion
        function setEditModeRow(tr, editing, hasCode = true) {
            const spanDesc = tr.querySelector('.cell-text-desc');
            const inputDesc = tr.querySelector('.cell-input-desc');
            const spanCod = hasCode ? tr.querySelector('.cell-text-cod') : null;
            const inputCod = hasCode ? tr.querySelector('.cell-input-cod') : null;
            const btnEdit = tr.querySelector('.btn-edit');
            const btnSave = tr.querySelector('.btn-save');
            const btnCancel = tr.querySelector('.btn-cancel');

            if (editing) {
                spanDesc.style.display = 'none';
                inputDesc.style.display = '';
                if (hasCode && spanCod && inputCod) { spanCod.style.display = 'none'; inputCod.style.display = ''; }
                if (btnEdit) btnEdit.style.display = 'none';
                if (btnSave) btnSave.style.display = '';
                if (btnCancel) btnCancel.style.display = '';
                inputDesc.focus(); inputDesc.select();
            } else {
                spanDesc.style.display = '';
                inputDesc.style.display = 'none';
                if (hasCode && spanCod && inputCod) { spanCod.style.display = ''; inputCod.style.display = 'none'; }
                if (btnEdit) btnEdit.style.display = '';
                if (btnSave) btnSave.style.display = 'none';
                if (btnCancel) btnCancel.style.display = 'none';
            }
        }

        // Clasificacion: modo edicion robusto
        function setEditModeClasificacion(tr, editing, restore = false) {
            const spanDesc = tr.querySelector('.cell-text-desc');
            const inputDesc = tr.querySelector('.cell-input-desc');
            const spanCod = tr.querySelector('.cell-text-cod');
            const inputCod = tr.querySelector('.cell-input-cod');
            const spanTP = tr.querySelector('.cell-text-tp');
            const selTP = tr.querySelector('.cell-input-tp');

            const chkAjeno = tr.querySelector('.chk-ajeno');
            const chkAfecta = tr.querySelector('.chk-afecta');

            const btnEdit = tr.querySelector('.btn-edit');
            const btnSave = tr.querySelector('.btn-save');
            const btnCancel = tr.querySelector('.btn-cancel');

            if (!restore) {
                if (chkAjeno && !chkAjeno.hasAttribute('data-original'))
                    chkAjeno.setAttribute('data-original', String(chkAjeno.checked));
                if (chkAfecta && !chkAfecta.hasAttribute('data-original'))
                    chkAfecta.setAttribute('data-original', String(chkAfecta.checked));
            } else {
                if (chkAjeno && chkAjeno.hasAttribute('data-original'))
                    chkAjeno.checked = chkAjeno.getAttribute('data-original') === 'true';
                if (chkAfecta && chkAfecta.hasAttribute('data-original'))
                    chkAfecta.checked = chkAfecta.getAttribute('data-original') === 'true';

                if (inputDesc && spanDesc) inputDesc.value = spanDesc.textContent || '';
                if (inputCod && spanCod) inputCod.value = spanCod.textContent || '';
                if (selTP && spanTP) {
                    const wanted = (spanTP.textContent || '').trim();
                    let matched = false;
                    for (const opt of selTP.options) {
                        if (opt.text.trim() === wanted) { opt.selected = true; matched = true; break; }
                    }
                    if (!matched) selTP.value = '';
                }
            }

            const hasCod = !!(spanCod && inputCod);
            const hasTP = !!(spanTP && selTP);

            if (editing) {
                if (spanDesc && inputDesc) { spanDesc.style.display = 'none'; inputDesc.style.display = ''; inputDesc.focus(); inputDesc.select(); }
                if (hasCod) { spanCod.style.display = 'none'; inputCod.style.display = ''; }
                if (hasTP) { spanTP.style.display = 'none'; selTP.style.display = ''; }
                if (chkAjeno) chkAjeno.disabled = false;
                if (chkAfecta) chkAfecta.disabled = false;

                if (btnEdit) btnEdit.style.display = 'none';
                if (btnSave) btnSave.style.display = '';
                if (btnCancel) btnCancel.style.display = '';
            } else {
                if (spanDesc && inputDesc) { spanDesc.style.display = ''; inputDesc.style.display = 'none'; }
                if (hasCod) { spanCod.style.display = ''; inputCod.style.display = 'none'; }
                if (hasTP) { spanTP.style.display = ''; selTP.style.display = 'none'; }
                if (chkAjeno) chkAjeno.disabled = true;
                if (chkAfecta) chkAfecta.disabled = true;

                if (btnEdit) btnEdit.style.display = '';
                if (btnSave) btnSave.style.display = 'none';
                if (btnCancel) btnCancel.style.display = 'none';
            }
        }

        async function saveRow(tr, config) {
            const id = tr.getAttribute('data-row-id');
            const spanDesc = tr.querySelector('.cell-text-desc');
            const inputDesc = tr.querySelector('.cell-input-desc');

            const descripcionNueva = (inputDesc.value || '').trim();

            if (isBlocked(spanDesc.textContent)) { alert('Este registro no es editable.'); return; }
            if (!descripcionNueva) { alert('La descripción no puede estar vacía.'); return; }

            let fetchOptions;
            if (config.asForm && config.tipo === 'TipoParo') {
                // TipoParo: solo ID + Descripcion
                const urlParams = new URLSearchParams();
                urlParams.set(config.idField, isNaN(Number(id)) ? String(id) : Number(id));
                urlParams.set('Descripcion', descripcionNueva);
                fetchOptions = {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                    body: urlParams.toString()
                };
            } else {
                // JSON (incluye CodigoDet si aplica)
                const payload = { Descripcion: descripcionNueva };
                if (config.codeField) payload.CodigoDet = (tr.querySelector('.cell-input-cod')?.value || '').trim();
                payload[config.idField] = isNaN(Number(id)) ? id : Number(id);
                fetchOptions = {
                    method: 'POST',
                    headers: config.headers,
                    body: JSON.stringify(payload)
                };
            }

            try {
                const resp = await fetch(config.updateUrl, fetchOptions);
                if (!resp.ok) throw new Error('Error de red/servidor');
                const result = await resp.json().catch(() => ({}));

                if (result?.success === false) {
                    alert(result?.message || 'No se pudo guardar.');
                    return;
                }

                // actualizar UI
                const hasCode = !!config.codeField;
                spanDesc.textContent = descripcionNueva;
                if (hasCode) {
                    const spanCod = tr.querySelector('.cell-text-cod');
                    const inputCod = tr.querySelector('.cell-input-cod');
                    spanCod.textContent = (inputCod.value || '').trim();
                }
                setEditModeRow(tr, false, hasCode);
            } catch (err) {
                console.error(err);
                alert('Error guardando el registro.');
            }
        }

        async function saveRowClasificacion(tr) {
            const id = Number(tr.getAttribute('data-row-id'));
            const spanDesc = tr.querySelector('.cell-text-desc');
            const inputDesc = tr.querySelector('.cell-input-desc');
            const spanCod = tr.querySelector('.cell-text-cod');
            const inputCod = tr.querySelector('.cell-input-cod');
            const spanTP = tr.querySelector('.cell-text-tp');
            const selTP = tr.querySelector('.cell-input-tp');
            const chkAjeno = tr.querySelector('.chk-ajeno');
            const chkAfecta = tr.querySelector('.chk-afecta');

            const nuevaDesc = (inputDesc.value || '').trim();
            const nuevoCod = (inputCod.value || '').trim();
            const tipoParoId = selTP ? parseInt(selTP.value || '0', 10) : 0;
            const tipoParoText = selTP ? (selTP.selectedOptions[0]?.text || '') : '';

            if (isBlocked(spanDesc.textContent)) { alert('Este registro no es editable.'); return; }
            if (!nuevaDesc) { alert('La descripción no puede estar vacía.'); return; }
            if (!tipoParoId) { alert('Seleccione un tipo de paro.'); return; }

            const payload = {
                ClasificacionID: id,
                Descripcion: nuevaDesc,
                Ajeno: !!(chkAjeno && chkAjeno.checked),
                AfectaMTF: !!(chkAfecta && chkAfecta.checked), // UpdateClasificacion usa AfectaMTF
                CodigoDet: nuevoCod,
                TipoParoID: tipoParoId
            };

            try {
                const resp = await fetch('/ArbolFallas/UpdateClasificacion', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (!resp.ok) throw new Error('Error de red/servidor');
                const result = await resp.json().catch(() => ({}));

                if (result?.success === false) {
                    alert(result?.message || 'No se pudo guardar.');
                    return;
                }

                // aplicar cambios
                spanDesc.textContent = nuevaDesc;
                spanCod.textContent = nuevoCod;
                if (spanTP) spanTP.textContent = tipoParoText;
                if (chkAjeno) chkAjeno.setAttribute('data-original', String(chkAjeno.checked));
                if (chkAfecta) chkAfecta.setAttribute('data-original', String(chkAfecta.checked));
                setEditModeClasificacion(tr, false);
            } catch (err) {
                console.error(err);
                alert('Error guardando la clasificación.');
            }
        }

        // helpers html safe
        function escapeHtml(s) {
            return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }
        function escapeAttr(s) {
            return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        function clearUI() {
            filtros.innerHTML = '';
            contenedorListado.innerHTML = '';
            // quitar delegaciones previas
            contenedorListado.onclick = null;
            contenedorListado.onchange = null;
        }

        // select simple
        function createSelect({ id, label, placeholder, col = 'col-md-4' }) {
            const colDiv = document.createElement('div');
            colDiv.className = col;
            colDiv.innerHTML = `
  <div class="mb-2">
    <label class="form-label">${label}</label>
    <select id="${id}" class="form-select">
      <option value="">${placeholder}</option>
    </select>
  </div>`;
            return colDiv;
        }

        function fillSelect(selectEl, items, firstOptionText) {
            selectEl.innerHTML = `<option value="">${firstOptionText}</option>`;
            items.forEach(i => {
                const opt = document.createElement('option');
                opt.value = i.value;
                opt.textContent = i.text;
                selectEl.appendChild(opt);
            });
        }

        // handlers por tipo
        async function handleSubEquipo() {
            clearUI();
            const config = getConfig('SubEquipo');

            const selEquipoWrap = createSelect({ id: 'filtroEquipo', label: 'Equipo', placeholder: 'Seleccione un equipo' });
            filtros.appendChild(selEquipoWrap);
            const selEquipo = document.getElementById('filtroEquipo');

            const equipos = await loadEquipos().catch(() => []);
            if (Array.isArray(equipos)) {
                fillSelect(selEquipo, equipos.map(e => ({ value: e.EquipoID, text: e.Descripcion })), 'Seleccione un equipo');
                if (window.equipoSeleccionadoId) selEquipo.value = String(window.equipoSeleccionadoId);
            } else {
                selEquipo.innerHTML = `<option value="">${equipos?.message || 'Sin datos'}</option>`;
            }

            selEquipo.addEventListener('change', async function () {
                contenedorListado.innerHTML = '';
                const id = this.value;
                if (!id) return;
                const data = await loadSubEquipos(id).catch(() => []);
                renderEditableTable(data, config);
            });

            if (selEquipo.value) selEquipo.dispatchEvent(new Event('change'));
        }

        async function handleComponente() {
            clearUI();
            const config = getConfig('Componente');

            const selEquipoWrap = createSelect({ id: 'filtroEquipo', label: 'Equipo', placeholder: 'Seleccione un equipo' });
            const selSubWrap = createSelect({ id: 'filtroSubequipo', label: 'Subequipo', placeholder: 'Seleccione un subequipo' });
            filtros.appendChild(selEquipoWrap);
            filtros.appendChild(selSubWrap);

            const selEquipo = document.getElementById('filtroEquipo');
            const selSub = document.getElementById('filtroSubequipo');

            const equipos = await loadEquipos().catch(() => []);
            if (Array.isArray(equipos)) {
                fillSelect(selEquipo, equipos.map(e => ({ value: e.EquipoID, text: e.Descripcion })), 'Seleccione un equipo');
                if (window.equipoSeleccionadoId) selEquipo.value = String(window.equipoSeleccionadoId);
            }

            selEquipo.addEventListener('change', async function () {
                contenedorListado.innerHTML = '';
                selSub.innerHTML = '<option value="">Cargando...</option>';
                const eqId = this.value;
                if (!eqId) { selSub.innerHTML = '<option value="">Seleccione un equipo primero</option>'; return; }

                const subs = await loadSubEquipos(eqId).catch(() => []);
                if (Array.isArray(subs)) {
                    fillSelect(selSub, subs.map(s => ({ value: s.SubEquipoID, text: s.Descripcion })), 'Seleccione un subequipo');
                } else {
                    selSub.innerHTML = '<option value="">Sin datos</option>';
                }
            });

            selSub.addEventListener('change', async function () {
                contenedorListado.innerHTML = '';
                const subId = this.value;
                if (!subId) return;

                const comps = await loadComponentesBySub(subId).catch(() => []);
                renderEditableTable(comps, config);
            });

            if (selEquipo.value) selEquipo.dispatchEvent(new Event('change'));
        }

        async function handleTipoFalla() {
            clearUI();
            const config = getConfig('TipoFalla');

            const selEquipoWrap = createSelect({ id: 'filtroEquipoTF', label: 'Equipo', placeholder: 'Seleccione un equipo' });
            const selSubWrap = createSelect({ id: 'filtroSubTF', label: 'Subequipo', placeholder: 'Seleccione un subequipo' });
            const selCompWrap = createSelect({ id: 'filtroCompTF', label: 'Componente', placeholder: 'Seleccione un componente' });
            const selClasWrap = createSelect({ id: 'filtroClasTF', label: 'Clasificación', placeholder: 'Seleccione una clasificación' });
            filtros.appendChild(selEquipoWrap);
            filtros.appendChild(selSubWrap);
            filtros.appendChild(selCompWrap);
            filtros.appendChild(selClasWrap);

            const selEquipo = document.getElementById('filtroEquipoTF');
            const selSub = document.getElementById('filtroSubTF');
            const selComp = document.getElementById('filtroCompTF');
            const selClas = document.getElementById('filtroClasTF');

            const [equipos, clasificaciones] = await Promise.all([
                loadEquipos().catch(() => []),
                loadClasificaciones().catch(() => [])
            ]);

            if (Array.isArray(equipos)) {
                fillSelect(selEquipo, equipos.map(e => ({ value: e.EquipoID, text: e.Descripcion })), 'Seleccione un equipo');
                if (window.equipoSeleccionadoId) selEquipo.value = String(window.equipoSeleccionadoId);
            }
            if (Array.isArray(clasificaciones)) {
                fillSelect(selClas, clasificaciones.map(c => ({ value: c.ClasificacionID, text: c.Descripcion })), 'Seleccione una clasificación');
                if (window.clasificacionId) selClas.value = String(window.clasificacionId);
            }

            selEquipo.addEventListener('change', async function () {
                contenedorListado.innerHTML = '';
                selSub.innerHTML = '<option value="">Cargando...</option>';
                selComp.innerHTML = '<option value="">Seleccione un subequipo primero</option>';
                const eqId = this.value;
                if (!eqId) { selSub.innerHTML = '<option value="">Seleccione un equipo primero</option>'; return; }

                const subs = await loadSubEquipos(eqId).catch(() => []);
                if (Array.isArray(subs)) {
                    fillSelect(selSub, subs.map(s => ({ value: s.SubEquipoID, text: s.Descripcion })), 'Seleccione un subequipo');
                    if (window.subEquipoId) { selSub.value = String(window.subEquipoId); selSub.dispatchEvent(new Event('change')); }
                } else {
                    selSub.innerHTML = '<option value="">Sin datos</option>';
                }
            });

            selSub.addEventListener('change', async function () {
                contenedorListado.innerHTML = '';
                selComp.innerHTML = '<option value="">Cargando...</option>';
                const subId = this.value;
                if (!subId) { selComp.innerHTML = '<option value="">Seleccione un subequipo primero</option>'; return; }

                const comps = await loadComponentesBySub(subId).catch(() => []);
                if (Array.isArray(comps)) {
                    fillSelect(selComp, comps.map(c => ({ value: c.ComponenteEquipoID, text: c.Descripcion })), 'Seleccione un componente');
                    if (window.componenteEquipoId) selComp.value = String(window.componenteEquipoId);
                } else {
                    selComp.innerHTML = '<option value="">Sin datos</option>';
                }
            });

            async function tryLoadTipos() {
                contenedorListado.innerHTML = '';
                const clasId = selClas.value;
                const compId = selComp.value;
                if (!clasId || !compId) return;

                const data = await loadTiposFalla(clasId, compId).catch(() => []);
                renderEditableTable(data, config);
            }

            selClas.addEventListener('change', tryLoadTipos);
            selComp.addEventListener('change', tryLoadTipos);

            if (selEquipo.value) selEquipo.dispatchEvent(new Event('change'));
        }

        async function handleTipoParo() {
            clearUI();
            const config = getConfig('TipoParo');
            const data = await loadTiposParo().catch(() => []);
            renderEditableTable(data, config); // sin columna CodigoDet
        }

        // evento principal
        selectListado.addEventListener('change', function () {
            const tipo = this.value;
            if (!tipo) { clearUI(); return; }

            if (tipo === 'SubEquipo') return handleSubEquipo();
            if (tipo === 'Componente') return handleComponente();
            if (tipo === 'Clasificacion') return handleClasificacion();
            if (tipo === 'TipoFalla') return handleTipoFalla();
            if (tipo === 'TipoParo') return handleTipoParo();
        });
    });
</script>







<script>

    (function () {
        function showLoading() {
            var m = document.getElementById('loadingModal');
            if (m) m.style.display = 'block';
        }
        function hideLoading() {
            var m = document.getElementById('loadingModal');
            if (m) m.style.display = 'none';
        }
        // expone helpers por si quieres usarlos en otros fetch
        window.showLoading = showLoading;
        window.hideLoading = hideLoading;

        // muestra lo antes posible (cuando el DOM ya esta parseado)
        document.addEventListener('readystatechange', function () {
            if (document.readyState === 'interactive') showLoading();
        });

        // oculta cuando ya cargo todo (assets incluidos)
        window.addEventListener('load', function () {
            setTimeout(hideLoading, 200);
        });

        // muestra al navegar/recargar (cuando cambias de pagina)
        window.addEventListener('beforeunload', function () {
            showLoading();
        });
    })();

</script>


