                    const sel = String(tp.TipoParoID) === String(tipoParoId) ? 'selected' : '';
                    return `<option value="${escapeAttr(tp.TipoParoID)}" ${sel}>${escapeHtml(tp.Descripcion)}</option>`;
                }).join('');

                return `
