@model DVP.Models.ArbolFallasViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Downtime Page";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<style>
    /* Estilo para el contenedor de la fecha y hora */
    .container {
        font-family: Arial, sans-serif;
        display: flex; /* Usamos flex para alinearlos horizontalmente */
        justify-content: center; /* Centra los elementos horizontalmente */
        align-items: center; /* Centra los elementos verticalmente */
        gap: 20px; /* Espacio entre los divs */
        margin-top: 20px;
    }
    /* Estilo para los divs de fecha y hora */
    .input-container {
        font-size: 18px;
        display: flex;
        flex-direction: column; /* Los inputs se alinean de arriba hacia abajo */
        align-items: center;
    }

    input {
        padding: 10px;
        font-size: 16px;
        margin-top: 10px;
        border: 2px solid #ccc;
        border-radius: 8px;
        background-color: #f0f0f0;
    }

    .scrollable-table {
        max-height: 400px;
        overflow-y: auto;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa; /* color fondo header */
        z-index: 2;
        text-align: center;
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
        text-align: center;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 45px;
        height: 24px;
        margin-right: 8px;
        vertical-align: middle;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .switch .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 34px;
        }

            .switch .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 3px;
                bottom: 3px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        .switch input:checked + .slider {
            background-color: #13DEB9; /* Verde menta */
        }

            .switch input:checked + .slider:before {
                transform: translateX(21px);
            }

    .switch-label {
        font-size: 14px;
        color: #555;
        vertical-align: middle;
    }
</style>


<body>
    <div class="container-fluid" style="padding-left: 200px;">
        <br />
        <br />
        <br />
        <div class="card">
            <div class="container-fluid">
                <div class="container-fluid">
                    <div class="card">
                        <div class="card-body">
                            <div id="alertsuccesclose" class="alert alert-success" role="alert" style="display: none;">
                                Agregado correctamente!
                            </div>
                            <!-- Configuracion -->
                            <h5 class="card-title fw-semibold mb-4">Configuration Fault Tree</h5>
                        </div>
                        <div class="mb-3">
                            <form id="formElemento">
                                <label class="form-label">Add</label>
                                <select class="form-select" id="_elememnto">
                                    <option value="">Select what you want to add</option>
                                    <option value="1">Sub Equipo</option>
                                    <option value="2">Componente</option>
                                    <option value="3">Clasificación</option>
                                    <option value="4">Tipo Falla</option>
                                </select>

                                <div id="camposContainer" class="mt-3"></div>

                                <button type="submit" id="btnGuardar" class="btn btn-primary mt-2">Guardar</button>
                            </form>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Faul tree list</label>
                        <select class="form-select" id="selectListado">
                            <option value="">Select a type</option>
                            <option value="SubEquipo">Sub Equipo</option>
                            <option value="Componente">Componente</option>
                            <option value="Clasificacion">Clasificacion</option>
                            <option value="TipoFalla">Tipo Falla</option>
                        </select>
                    </div>

                    <div id="filtrosListado" class="row g-3 mb-2"></div>
                    <div id="contenedorListado" class="mt-3"></div>

                </div>
            </div>
        </div>
    </div>

    @*___________________________________________________________________Modal Cargando__________________________________________________*@
    <div id="loadingModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; background-color: rgba(0, 0, 0, 0.5);">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background-color: white; padding: 25px 35px; border-radius: 10px; box-shadow: 0 0 15px rgba(0,0,0,0.3); min-width: 250px;">
            <div style="display: flex; align-items: center; justify-content: center;">
                <img src="/Content/loading-green-loading.gif" alt="Cargando..." style="width: 40px; height: 40px; margin-right: 15px;" />
                <span style="color: black; font-size: 16px;">Cargando...</span>
            </div>
        </div>
    </div>

</body>

<script>


    document.addEventListener("DOMContentLoaded", function () {
        const select = document.getElementById('_elememnto'); // si tu select real es _elemento, cambia este id
        const contenedor = document.getElementById('camposContainer');
        const form = document.getElementById('formElemento');

        // alert success (usa el div con id="alertsuccesclose")
        const alertSuccessEl = document.getElementById('alertsuccesclose');
        const showSuccess = (msg) => {
            if (!alertSuccessEl) return;
            alertSuccessEl.textContent = msg || 'Agregado correctamente!';
            alertSuccessEl.style.display = 'block';
            clearTimeout(showSuccess._t);
            showSuccess._t = setTimeout(() => {
                alertSuccessEl.style.display = 'none';
            }, 4000);
        };
        const hideSuccess = () => {
            if (alertSuccessEl) alertSuccessEl.style.display = 'none';
        };

        // ==== endpoints por opcion ====
        const endpoints = {
            '1': '/ArbolFallas/CreateSubEquipo',        // data: { _descripcion, _equipoId }
            '2': '/ArbolFallas/CreateComponenteEquipo', // data: { _descripcion, _subequipoId }
            '3': '/ArbolFallas/CreateClasificacion',    // data: { _descripcion, _ajeno, _afectaTMEF }
            '4': '/ArbolFallas/CreateTipoFalla'         // data: { _descripcion, _clasificacionId, _componenteEquipoId }
        };

        // util: POST JSON con soporte a antiforgery
        const postJson = async (url, payload) => {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const headers = { 'Content-Type': 'application/json; charset=utf-8' };
            if (token) headers['RequestVerificationToken'] = token;

            const res = await fetch(url, {
                method: 'POST',
                headers,
                // IMPORTANTE: el param en MVC es "data", asi que envolvemos { data: payload }
                body: JSON.stringify({ data: payload })
            });

            let json = null;
            try { json = await res.json(); } catch (_) { }

            if (!res.ok) {
                const msg = (json && (json.message || json.error)) || ('HTTP ' + res.status);
                throw new Error(msg);
            }
            return json || {};
        };

        // Helper: cargar equipos por pais del usuario logueado
        const loadEquipos = (selectId) => {
            const sel = document.getElementById(selectId);
            sel.disabled = true;
            sel.innerHTML = '<option value="">Cargando...</option>';

            return fetch('/Equipo/GetEquiposporPaislogguedUser')
                .then(res => res.json())
                .then(data => {
                    if (!Array.isArray(data) || data.length === 0) {
                        sel.innerHTML = '<option value="">Sin datos</option>';
                        return [];
                    }

                    sel.innerHTML = '<option value="">Seleccione un equipo</option>';
                    data.forEach(equipo => {
                        const opt = document.createElement('option');
                        opt.value = equipo.EquipoID;
                        opt.textContent = equipo.Descripcion;
                        sel.appendChild(opt);
                    });

                    return data;
                })
                .catch(err => {
                    console.error(err);
                    sel.innerHTML = '<option value="">Error al cargar</option>';
                    return [];
                })
                .finally(() => {
                    sel.disabled = false;
                });
        };

        // Helper: cargar subequipos dado un EquipoID
        const loadSubEquipos = (equipoId, selectId) => {
            const sel = document.getElementById(selectId);

            if (!equipoId || Number(equipoId) <= 0) {
                sel.innerHTML = '<option value="">Seleccione un equipo primero</option>';
                return Promise.resolve([]); // no lanzar error
            }

            sel.disabled = true;
            sel.innerHTML = '<option value="">Cargando...</option>';

            return fetch(`/Downtime/GetSubEquipos?_equipoId=${encodeURIComponent(equipoId)}`)
                .then(res => res.json())
                .then(data => {
                    if (data?.error) {
                        sel.innerHTML = `<option value="">${data.error}</option>`;
                        return [];
                    }
                    if (!Array.isArray(data) || data.length === 0) {
                        sel.innerHTML = '<option value="">Sin datos</option>';
                        return [];
                    }

                    sel.innerHTML = '<option value="">Seleccione un subequipo</option>';
                    data.forEach(se => {
                        const opt = document.createElement('option');
                        opt.value = se.SubEquipoID;
                        opt.textContent = se.Descripcion;
                        sel.appendChild(opt);
                    });
                    return data;
                })
                .catch(err => {
                    console.error(err);
                    sel.innerHTML = '<option value="">Error al cargar</option>';
                    return [];
                })
                .finally(() => {
                    sel.disabled = false;
                });
        };

        // Hace que dos checkboxes sean mutuamente excluyentes (ambos pueden estar apagados)
        function setMutualExclusive(idA, idB) {
            const a = document.getElementById(idA);
            const b = document.getElementById(idB);
            if (!a || !b) return;

            a.addEventListener('change', () => {
                if (a.checked) b.checked = false;
            });
            b.addEventListener('change', () => {
                if (b.checked) a.checked = false;
            });
        }

        // Helper: cargar clasificaciones
        const loadClasificaciones = (selectId) => {
            const sel = document.getElementById(selectId);
            sel.disabled = true;
            sel.innerHTML = '<option value="">Cargando...</option>';

            return fetch('/Downtime/GetClasificacion')
                .then(res => res.json())
                .then(data => {
                    if (!Array.isArray(data) || data.length === 0) {
                        sel.innerHTML = '<option value="">Sin datos</option>';
                        return [];
                    }
                    sel.innerHTML = '<option value="">Seleccione una clasificacion</option>';
                    data.forEach(c => {
                        const opt = document.createElement('option');
                        opt.value = c.ClasificacionID;
                        opt.textContent = c.Descripcion;
                        sel.appendChild(opt);
                    });
                    return data;
                })
                .catch(err => {
                    console.error(err);
                    sel.innerHTML = '<option value="">Error al cargar</option>';
                    return [];
                })
                .finally(() => { sel.disabled = false; });
        };

        // Helper: cargar componentes por subequipo
        const loadComponentes = (subequipoId, selectId) => {
            const sel = document.getElementById(selectId);

            if (!subequipoId || Number(subequipoId) <= 0) {
                sel.innerHTML = '<option value="">Seleccione un subequipo primero</option>';
                return Promise.resolve([]); // no lanzar error
            }

            sel.disabled = true;
            sel.innerHTML = '<option value="">Cargando...</option>';

            return fetch(`/Downtime/GetComponenteEquipo?_subEquipoId=${encodeURIComponent(subequipoId)}`)
                .then(res => res.json())
                .then(data => {
                    if (data?.error) {
                        sel.innerHTML = `<option value="">${data.error}</option>`;
                        return [];
                    }
                    if (!Array.isArray(data) || data.length === 0) {
                        sel.innerHTML = '<option value="">Sin datos</option>';
                        return [];
                    }

                    sel.innerHTML = '<option value="">Seleccione un componente</option>';
                    data.forEach(co => {
                        const opt = document.createElement('option');
                        opt.value = co.ComponenteEquipoID;
                        opt.textContent = co.Descripcion;
                        sel.appendChild(opt);
                    });
                    return data;
                })
                .catch(err => {
                    console.error(err);
                    sel.innerHTML = '<option value="">Error al cargar</option>';
                    return [];
                })
                .finally(() => { sel.disabled = false; });
        };

        // Render segun opcion
        select.addEventListener('change', function () {
            const valor = this.value;
            contenedor.innerHTML = '';

            switch (valor) {
                case '1':
                    contenedor.innerHTML = `
            <div class="mb-3">
                <label class="form-label">Descripcion</label>
                <input type="text" class="form-control" id="_descripcion" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Equipo</label>
                <select class="form-control" id="_equipoId" required>
                    <option value="">Cargando equipos...</option>
                </select>
            </div>`;
                    loadEquipos('_equipoId');
                    break;

                case '2':
                    contenedor.innerHTML = `
            <div class="mb-3">
                <label class="form-label">Descripcion</label>
                <input type="text" class="form-control" id="_descripcion" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Equipo</label>
                <select class="form-control" id="_equipoIdForSub" required>
                    <option value="">Cargando...</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Subequipo</label>
                <select class="form-control" id="_subequipoId" required>
                    <option value="">Seleccione un equipo primero</option>
                </select>
            </div>`;
                    loadEquipos('_equipoIdForSub').then(() => {
                        const selEquipo = document.getElementById('_equipoIdForSub');
                        if (window.equipoSeleccionadoId) {
                            selEquipo.value = String(window.equipoSeleccionadoId);
                            loadSubEquipos(selEquipo.value, '_subequipoId');
                        }
                        selEquipo.addEventListener('change', function () {
                            document.getElementById('_subequipoId').innerHTML = '<option value="">Cargando...</option>';
                            loadSubEquipos(this.value, '_subequipoId');
                        });
                    });
                    break;

                case '3':
                    contenedor.innerHTML = `
            <div class="mb-3">
                <label class="form-label">Descripcion</label>
                <input type="text" class="form-control" id="_descripcion" required />
            </div>
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="_ajeno">
                <label class="form-check-label" for="_ajeno">Ajeno</label>
            </div>
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="_afectaTMEF">
                <label class="form-check-label" for="_afectaTMEF">Afecta TMEF</label>
            </div>`;
                    // hacerlos mutuamente excluyentes
                    setMutualExclusive('_ajeno', '_afectaTMEF');
                    break;

                case '4':
                    contenedor.innerHTML = `
            <div class="mb-3">
                <label class="form-label">Descripcion</label>
                <input type="text" class="form-control" id="_descripcion" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Equipo</label>
                <select class="form-control" id="_equipoIdForTF" required>
                    <option value="">Cargando...</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Subequipo</label>
                <select class="form-control" id="_subequipoIdForTF" required>
                    <option value="">Seleccione un equipo primero</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Componente</label>
                <select class="form-control" id="_componenteId" required>
                    <option value="">Seleccione un subequipo primero</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Clasificacion</label>
                <select class="form-control" id="_clasificacionId" required>
                    <option value="">Cargando...</option>
                </select>
            </div>`;
                    loadClasificaciones('_clasificacionId');
                    loadEquipos('_equipoIdForTF').then(() => {
                        const selEquipo = document.getElementById('_equipoIdForTF');
                        const selSubEq = document.getElementById('_subequipoIdForTF');
                        const selComp = document.getElementById('_componenteId');

                        if (window.equipoSeleccionadoId) {
                            selEquipo.value = String(window.equipoSeleccionadoId);
                            loadSubEquipos(selEquipo.value, '_subequipoIdForTF');
                        }

                        selEquipo.addEventListener('change', function () {
                            selSubEq.innerHTML = '<option value="">Cargando...</option>';
                            selComp.innerHTML = '<option value="">Seleccione un subequipo primero</option>';
                            loadSubEquipos(this.value, '_subequipoIdForTF');
                        });

                        selSubEq.addEventListener('change', function () {
                            selComp.innerHTML = '<option value="">Cargando...</option>';
                            loadComponentes(this.value, '_componenteId');
                        });
                    });
                    break;
            }
        });

        // ==== submit al backend segun opcion seleccionada ====
        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            hideSuccess();

            const opcion = select.value;
            if (!opcion || !endpoints[opcion]) {
                alert('Seleccione una opcion valida.');
                return;
            }

            let payload = null;

            try {
                switch (opcion) {
                    case '1': {
                        // CreateSubEquipo
                        const descripcion = document.getElementById('_descripcion')?.value.trim();
                        const equipoId = parseInt(document.getElementById('_equipoId')?.value || '0', 10) || null;
                        payload = { _descripcion: descripcion, _equipoId: equipoId };
                        break;
                    }
                    case '2': {
                        // CreateComponenteEquipo
                        const descripcion = document.getElementById('_descripcion')?.value.trim();
                        const subequipoId = parseInt(document.getElementById('_subequipoId')?.value || '0', 10) || null;
                        payload = { _descripcion: descripcion, _subequipoId: subequipoId };
                        break;
                    }
                    case '3': {
                        // CreateClasificacion
                        const descripcion = document.getElementById('_descripcion')?.value.trim();
                        const ajeno = !!document.getElementById('_ajeno')?.checked;
                        const afectaTMEF = !!document.getElementById('_afectaTMEF')?.checked;
                        payload = { _descripcion: descripcion, _ajeno: ajeno, _afectaTMEF: afectaTMEF };
                        break;
                    }
                    case '4': {
                        // CreateTipoFalla
                        const descripcion = document.getElementById('_descripcion')?.value.trim();
                        const clasificacionId = parseInt(document.getElementById('_clasificacionId')?.value || '0', 10) || null;
                        const componenteEquipoId = parseInt(document.getElementById('_componenteId')?.value || '0', 10) || null;
                        payload = {
                            _descripcion: descripcion,
                            _clasificacionId: clasificacionId,
                            _componenteEquipoId: componenteEquipoId
                        };
                        break;
                    }
                }

                // validacion rapida
                if (!payload || Object.values(payload).some(v => v === null || v === '' || Number.isNaN(v))) {
                    alert('Complete los datos requeridos.');
                    return;
                }

                const url = endpoints[opcion];
                const resp = await postJson(url, payload);

                if (resp?.success) {
                    showSuccess(resp.message || 'Agregado correctamente!');
                    // 🔁 Recargar la pagina tras mostrar el mensaje
                    setTimeout(() => {
                        window.location.reload();
                    }, 700);
                } else {
                    alert(resp?.message || 'No se pudo guardar.');
                }
            } catch (err) {
                console.error(err);
                alert('Error: ' + (err?.message || 'Fallo al enviar.'));
            }
        });
    });


    document.addEventListener('DOMContentLoaded', function () {
        const selectListado = document.getElementById('selectListado');
        const filtros = document.getElementById('filtrosListado');
        const contenedorListado = document.getElementById('contenedorListado');

        // ------- helpers fetch -------
        const loadEquipos = () => fetch('/Equipo/GetEquiposporPaislogguedUser').then(r => r.json());
        const loadSubEquipos = (equipoId) => fetch(`/Downtime/GetSubEquipos?_equipoId=${encodeURIComponent(equipoId)}`).then(r => r.json());
        const loadComponentesBySub = (subEquipoId) => fetch(`/Downtime/GetComponenteEquipo?_subEquipoId=${encodeURIComponent(subEquipoId)}`).then(r => r.json());
        const loadClasificaciones = () => fetch('/Downtime/GetClasificacion').then(r => r.json());
        const loadTiposFalla = (clasificacionId, componenteId) =>
            fetch(`/Downtime/GetTiposFalla?_clasificacionId=${encodeURIComponent(clasificacionId)}&_componenteEquipoId=${encodeURIComponent(componenteId)}`).then(r => r.json());

        // ------- bloqueo de palabras -------
        const BLOCKED_PATTERNS = ['PI', 'EQUIPO COMPLETO', 'PARO DVM'];
        function isBlocked(desc) {
            const up = String(desc || '').toUpperCase();
            return BLOCKED_PATTERNS.some(p => up.includes(p));
        }

        // ------- config por tipo (id, campo descripcion y endpoint update) -------
        function getConfig(tipo) {
            const base = {
                descField: 'Descripcion',
                headers: {
                    'Content-Type': 'application/json'
                    // ,'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            };
            if (tipo === 'SubEquipo') return { ...base, tipo, idField: 'SubEquipoID', updateUrl: '/ArbolFallas/UpdateSubEquipo' };
            if (tipo === 'Componente') return { ...base, tipo, idField: 'ComponenteEquipoID', updateUrl: '/ArbolFallas/UpdateComponente' };
            if (tipo === 'Clasificacion') return { ...base, tipo, idField: 'ClasificacionID', updateUrl: '/ArbolFallas/UpdateClasificacion' };
            if (tipo === 'TipoFalla') return { ...base, tipo, idField: 'TipoFallaID', updateUrl: '/ArbolFallas/UpdateTipoFalla' };
            return null;
        }

        // ------- render editable con bloqueo -------
        function renderEditableTable(data, config) {
            if (data?.error) {
                contenedorListado.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
                return;
            }
            if (!Array.isArray(data) || data.length === 0) {
                contenedorListado.innerHTML = '<div class="alert alert-warning">No hay registros disponibles.</div>';
                return;
            }

            const rowsHtml = data.map((item, idx) => {
                const id = item[config.idField];
                const desc = item[config.descField] ?? item.Nombre ?? item.nombre ?? '';
                const bloqueado = isBlocked(desc);

                return `
        <tr data-row-id="${id}">
            <td class="text-center">${idx + 1}</td>
            <td>
                <span class="cell-text">${escapeHtml(desc)}</span>
                <input class="form-control form-control-sm cell-input" type="text" value="${escapeAttr(desc)}" style="display:none;">
            </td>
            <td class="text-nowrap text-center">
                ${bloqueado
                        ? `<span class="badge bg-secondary">No editable</span>`
                        : `
                        <button type="button" class="btn btn-sm btn-outline-primary btn-edit">Editar</button>
                        <button type="button" class="btn btn-sm btn-success btn-save" style="display:none;">Guardar</button>
                        <button type="button" class="btn btn-sm btn-secondary btn-cancel" style="display:none;">Cancelar</button>
                      `
                    }
            </td>
        </tr>`;
            }).join('');

            contenedorListado.innerHTML = `
    <table class="table table-bordered table-sm table-striped align-middle">
        <thead>
            <tr>
                <th style="width:60px;">#</th>
                <th>Descripcion</th>
                <th style="width:210px;">Acciones</th>
            </tr>
        </thead>
        <tbody>${rowsHtml}</tbody>
    </table>`;

            // wire events SOLO para filas no bloqueadas (porque las bloqueadas no tienen botones)
            contenedorListado.querySelectorAll('.btn-edit').forEach(btn => {
                btn.addEventListener('click', () => {
                    const tr = btn.closest('tr');
                    setEditMode(tr, true);
                });
            });
            contenedorListado.querySelectorAll('.btn-cancel').forEach(btn => {
                btn.addEventListener('click', () => {
                    const tr = btn.closest('tr');
                    const span = tr.querySelector('.cell-text');
                    const input = tr.querySelector('.cell-input');
                    input.value = span.textContent || '';
                    setEditMode(tr, false);
                });
            });
            contenedorListado.querySelectorAll('.btn-save').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const tr = btn.closest('tr');
                    await saveRow(tr, config);
                });
            });
        }

        function setEditMode(tr, editing) {
            const span = tr.querySelector('.cell-text');
            const input = tr.querySelector('.cell-input');
            const btnEdit = tr.querySelector('.btn-edit');
            const btnSave = tr.querySelector('.btn-save');
            const btnCancel = tr.querySelector('.btn-cancel');

            if (editing) {
                span.style.display = 'none';
                input.style.display = '';
                if (btnEdit) btnEdit.style.display = 'none';
                if (btnSave) btnSave.style.display = '';
                if (btnCancel) btnCancel.style.display = '';
                input.focus();
                input.select();
            } else {
                span.style.display = '';
                input.style.display = 'none';
                if (btnEdit) btnEdit.style.display = '';
                if (btnSave) btnSave.style.display = 'none';
                if (btnCancel) btnCancel.style.display = 'none';
            }
        }

        async function saveRow(tr, config) {
            const id = tr.getAttribute('data-row-id');
            const span = tr.querySelector('.cell-text');
            const input = tr.querySelector('.cell-input');
            const descripcionNueva = (input.value || '').trim();

            // Salvaguarda adicional: bloquear si la fila actual es de las restringidas
            if (isBlocked(span.textContent)) {
                alert('Este registro no es editable.');
                return;
            }

            if (!descripcionNueva) {
                alert('La descripcion no puede estar vacia.');
                return;
            }

            const payload = { Descripcion: descripcionNueva };
            payload[config.idField] = isNaN(Number(id)) ? id : Number(id);

            try {
                const resp = await fetch(config.updateUrl, {
                    method: 'POST', // cambia a PUT si tu accion lo requiere
                    headers: config.headers,
                    body: JSON.stringify(payload)
                });
                if (!resp.ok) throw new Error('Error de red/servidor');
                const result = await resp.json().catch(() => ({}));

                if (result?.success === false) {
                    alert(result?.message || 'No se pudo guardar.');
                    return;
                }

                span.textContent = descripcionNueva;
                setEditMode(tr, false);
            } catch (err) {
                console.error(err);
                alert('Error guardando el registro.');
            }
        }

        // helpers de html safe
        function escapeHtml(s) {
            return String(s)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }
        function escapeAttr(s) {
            return String(s).replace(/"/g, '&quot;');
        }

        function clearUI() {
            filtros.innerHTML = '';
            contenedorListado.innerHTML = '';
        }

        // select simple
        function createSelect({ id, label, placeholder, col = 'col-md-4' }) {
            const colDiv = document.createElement('div');
            colDiv.className = col;
            colDiv.innerHTML = `
      <div class="mb-2">
        <label class="form-label">${label}</label>
        <select id="${id}" class="form-select">
          <option value="">${placeholder}</option>
        </select>
      </div>`;
            return colDiv;
        }

        function fillSelect(selectEl, items, firstOptionText) {
            selectEl.innerHTML = `<option value="">${firstOptionText}</option>`;
            items.forEach(i => {
                const opt = document.createElement('option');
                opt.value = i.value;
                opt.textContent = i.text;
                selectEl.appendChild(opt);
            });
        }

        // ------- handlers por tipo (usan renderEditableTable) -------
        async function handleSubEquipo() {
            clearUI();
            const config = getConfig('SubEquipo');

            const selEquipoWrap = createSelect({ id: 'filtroEquipo', label: 'Equipo', placeholder: 'Seleccione un equipo' });
            filtros.appendChild(selEquipoWrap);
            const selEquipo = document.getElementById('filtroEquipo');

            const equipos = await loadEquipos().catch(() => []);
            if (Array.isArray(equipos)) {
                fillSelect(
                    selEquipo,
                    equipos.map(e => ({ value: e.EquipoID, text: e.Descripcion })),
                    'Seleccione un equipo'
                );
                if (window.equipoSeleccionadoId) selEquipo.value = String(window.equipoSeleccionadoId);
            } else {
                selEquipo.innerHTML = `<option value="">${equipos?.message || 'Sin datos'}</option>`;
            }

            selEquipo.addEventListener('change', async function () {
                contenedorListado.innerHTML = '';
                const id = this.value;
                if (!id) return;
                const data = await loadSubEquipos(id).catch(() => []);
                renderEditableTable(data, config);
            });

            if (selEquipo.value) selEquipo.dispatchEvent(new Event('change'));
        }

        async function handleComponente() {
            clearUI();
            const config = getConfig('Componente');

            const selEquipoWrap = createSelect({ id: 'filtroEquipo', label: 'Equipo', placeholder: 'Seleccione un equipo' });
            const selSubWrap = createSelect({ id: 'filtroSubequipo', label: 'Subequipo', placeholder: 'Seleccione un subequipo' });
            filtros.appendChild(selEquipoWrap);
            filtros.appendChild(selSubWrap);

            const selEquipo = document.getElementById('filtroEquipo');
            const selSub = document.getElementById('filtroSubequipo');

            const equipos = await loadEquipos().catch(() => []);
            if (Array.isArray(equipos)) {
                fillSelect(
                    selEquipo,
                    equipos.map(e => ({ value: e.EquipoID, text: e.Descripcion })),
                    'Seleccione un equipo'
                );
                if (window.equipoSeleccionadoId) selEquipo.value = String(window.equipoSeleccionadoId);
            }

            selEquipo.addEventListener('change', async function () {
                contenedorListado.innerHTML = '';
                selSub.innerHTML = '<option value="">Cargando...</option>';
                const eqId = this.value;
                if (!eqId) { selSub.innerHTML = '<option value="">Seleccione un equipo primero</option>'; return; }

                const subs = await loadSubEquipos(eqId).catch(() => []);
                if (Array.isArray(subs)) {
                    fillSelect(
                        selSub,
                        subs.map(s => ({ value: s.SubEquipoID, text: s.Descripcion })),
                        'Seleccione un subequipo'
                    );
                } else {
                    selSub.innerHTML = '<option value="">Sin datos</option>';
                }
            });

            selSub.addEventListener('change', async function () {
                contenedorListado.innerHTML = '';
                const subId = this.value;
                if (!subId) return;

                const comps = await loadComponentesBySub(subId).catch(() => []);
                renderEditableTable(comps, config);
            });

            if (selEquipo.value) selEquipo.dispatchEvent(new Event('change'));
        }

        async function handleClasificacion() {
            clearUI();
            const config = getConfig('Clasificacion');
            const data = await loadClasificaciones().catch(() => []);
            renderEditableTable(data, config);
        }

        async function handleTipoFalla() {
            clearUI();
            const config = getConfig('TipoFalla');

            const selEquipoWrap = createSelect({ id: 'filtroEquipoTF', label: 'Equipo', placeholder: 'Seleccione un equipo' });
            const selSubWrap = createSelect({ id: 'filtroSubTF', label: 'Subequipo', placeholder: 'Seleccione un subequipo' });
            const selCompWrap = createSelect({ id: 'filtroCompTF', label: 'Componente', placeholder: 'Seleccione un componente' });
            const selClasWrap = createSelect({ id: 'filtroClasTF', label: 'Clasificacion', placeholder: 'Seleccione una clasificacion' });
            filtros.appendChild(selEquipoWrap);
            filtros.appendChild(selSubWrap);
            filtros.appendChild(selCompWrap);
            filtros.appendChild(selClasWrap);

            const selEquipo = document.getElementById('filtroEquipoTF');
            const selSub = document.getElementById('filtroSubTF');
            const selComp = document.getElementById('filtroCompTF');
            const selClas = document.getElementById('filtroClasTF');

            const [equipos, clasificaciones] = await Promise.all([
                loadEquipos().catch(() => []),
                loadClasificaciones().catch(() => [])
            ]);

            if (Array.isArray(equipos)) {
                fillSelect(
                    selEquipo,
                    equipos.map(e => ({ value: e.EquipoID, text: e.Descripcion })),
                    'Seleccione un equipo'
                );
                if (window.equipoSeleccionadoId) selEquipo.value = String(window.equipoSeleccionadoId);
            }
            if (Array.isArray(clasificaciones)) {
                fillSelect(
                    selClas,
                    clasificaciones.map(c => ({ value: c.ClasificacionID, text: c.Descripcion })),
                    'Seleccione una clasificacion'
                );
                if (window.clasificacionId) selClas.value = String(window.clasificacionId);
            }

            // Cascadas
            selEquipo.addEventListener('change', async function () {
                contenedorListado.innerHTML = '';
                selSub.innerHTML = '<option value="">Cargando...</option>';
                selComp.innerHTML = '<option value="">Seleccione un subequipo primero</option>';
                const eqId = this.value;
                if (!eqId) { selSub.innerHTML = '<option value="">Seleccione un equipo primero</option>'; return; }

                const subs = await loadSubEquipos(eqId).catch(() => []);
                if (Array.isArray(subs)) {
                    fillSelect(
                        selSub,
                        subs.map(s => ({ value: s.SubEquipoID, text: s.Descripcion })),
                        'Seleccione un subequipo'
                    );
                    if (window.subEquipoId) { selSub.value = String(window.subEquipoId); selSub.dispatchEvent(new Event('change')); }
                } else {
                    selSub.innerHTML = '<option value="">Sin datos</option>';
                }
            });

            selSub.addEventListener('change', async function () {
                contenedorListado.innerHTML = '';
                selComp.innerHTML = '<option value="">Cargando...</option>';
                const subId = this.value;
                if (!subId) { selComp.innerHTML = '<option value="">Seleccione un subequipo primero</option>'; return; }

                const comps = await loadComponentesBySub(subId).catch(() => []);
                if (Array.isArray(comps)) {
                    fillSelect(
                        selComp,
                        comps.map(c => ({ value: c.ComponenteEquipoID, text: c.Descripcion })),
                        'Seleccione un componente'
                    );
                    if (window.componenteEquipoId) selComp.value = String(window.componenteEquipoId);
                } else {
                    selComp.innerHTML = '<option value="">Sin datos</option>';
                }
            });

            async function tryLoadTipos() {
                contenedorListado.innerHTML = '';
                const clasId = selClas.value;
                const compId = selComp.value;
                if (!clasId || !compId) return;

                const data = await loadTiposFalla(clasId, compId).catch(() => []);
                renderEditableTable(data, config);
            }

            selClas.addEventListener('change', tryLoadTipos);
            selComp.addEventListener('change', tryLoadTipos);

            if (selEquipo.value) selEquipo.dispatchEvent(new Event('change'));
        }

        // evento principal
        selectListado.addEventListener('change', function () {
            const tipo = this.value;
            if (!tipo) {
                clearUI();
                return;
            }
            if (tipo === 'SubEquipo') return handleSubEquipo();
            if (tipo === 'Componente') return handleComponente();
            if (tipo === 'Clasificacion') return handleClasificacion();
            if (tipo === 'TipoFalla') return handleTipoFalla();
        });
    });



    (function () {
        function showLoading() {
            var m = document.getElementById('loadingModal');
            if (m) m.style.display = 'block';
        }
        function hideLoading() {
            var m = document.getElementById('loadingModal');
            if (m) m.style.display = 'none';
        }
        // expone helpers por si quieres usarlos en otros fetch
        window.showLoading = showLoading;
        window.hideLoading = hideLoading;

        // muestra lo antes posible (cuando el DOM ya esta parseado)
        document.addEventListener('readystatechange', function () {
            if (document.readyState === 'interactive') showLoading();
        });

        // oculta cuando ya cargo todo (assets incluidos)
        window.addEventListener('load', function () {
            setTimeout(hideLoading, 200);
        });

        // muestra al navegar/recargar (cuando cambias de pagina)
        window.addEventListener('beforeunload', function () {
            showLoading();
        });
    })();



</script>


