      `;

      document.body.appendChild(editBg);
      document.body.appendChild(editEl);

      // Event Listeners
      editBg.addEventListener('click', hideEditOverlay);
      editEl.querySelector('#ed_close_top').addEventListener('click', hideEditOverlay);
      editEl.querySelector('#ed_cancel').addEventListener('click', hideEditOverlay);
      editEl.querySelector('#ed_guardar').addEventListener('click', guardarEdicionOverlay);

      // AÑADIDO: Listeners para la validación en tiempo real
      editEl.querySelector('#ed_cantVal').addEventListener('input', validateEditCantidadValidada);
      editEl.querySelector('#ed_cantVal').addEventListener('blur', validateEditCantidadValidada);
    }

    function showEditOverlay({ id, pims, validada, fechaISO }){
        ensureEditOverlay();
        editEl.querySelector('#ed_row_id').value  = id || '';
        editEl.querySelector('#ed_fecha_iso_original').value = fechaISO || '';

        // Muestra el valor con punto
        editEl.querySelector('#ed_cantPims').value = (pims === null || pims === undefined) ? '' : String(pims);
        // Al mostrar el valor, inmediatamente aplicamos la validación
        editEl.querySelector('#ed_cantVal').value  = (validada === null || validada === undefined) ? '' : String(validada);

        // AÑADIDO: Forzar validación al abrir para marcar en rojo si está vacío
        validateEditCantidadValidada();

        editBg.style.display = 'block';
        editEl.style.display = 'block';
    }

    function hideEditOverlay(){
        if(!editBg || !editEl) return;
        editBg.style.display = 'none';
        editEl.style.display = 'none';
    }

    function guardarEdicionOverlay(){
      const cantValInput = editEl.querySelector('#ed_cantVal');

      // AÑADIDO: Ejecutar validación final antes de guardar
      if (!validateEditCantidadValidada()) {
          alert('Corrija la cantidad validada antes de guardar.');
          cantValInput.focus();
          return;
      }

      const btn = editEl.querySelector('#ed_guardar');
      btn.disabled = true;

      try{
        const idStr = editEl.querySelector('#ed_row_id')?.value || '';
        const id    = Number(idStr);

        const pimsValue = editEl.querySelector('#ed_cantPims')?.value;
        const pimsN = parseNumber(pimsValue);
        // El valor de Cant Validada ya fue validado en validateEditCantidadValidada
        const valN  = parseNumber(cantValInput.value);

        if(!id){ alert('No se pudo identificar el registro.'); btn.disabled=false; return; }
        // La validación de null ya se hace en validateEditCantidadValidada
        if(valN === null){ alert('Cantidad validada es obligatoria.'); btn.disabled=false; return; }

        const fechaOriginalStr = editEl.querySelector('#ed_fecha_iso_original')?.value || '';
        const fechaBackendISO = toISODateOnly(fechaOriginalStr);

        const currentParams = (typeof window.getCurrentParams === 'function') ? window.getCurrentParams() : {};
        const equipoId = currentParams.equipoId || 0;
        const tipoMaterialSel = currentParams.tipoMaterial || '';

        const payload = {
          _dataOperacionId:      id,
          _cantidadPims:         pimsN,
          _cantidadValidada:     valN,
          _fechaReporte:         fechaBackendISO,
          _equipoId:             equipoId,
          _tipoMaterial:         tipoMaterialSel
        };

        fetch(URL_UPDATE_HUMEDAD, {
          method: 'POST',
          headers: { 'Content-Type':'application/json' },
          body: JSON.stringify(payload)
        })
        .then(r => r.json())
        .then(res => {
          if(res && res.success){
            if(typeof window.filtrarPorFecha === 'function') { window.filtrarPorFecha(); }

            hideEditOverlay();

            const ok = document.getElementById('alertsuccesclose');
            if(ok){ ok.textContent='Humedad actualizada correctamente.'; ok.style.display='block'; setTimeout(()=>ok.style.display='none',2500); }
            else alert('Humedad actualizada correctamente.');
          } else {
            alert('No se pudo actualizar: ' + (res?.message || 'Error desconocido'));
          }
        })
        .catch(err => {
            console.error(err);
            alert('Error al actualizar la humedad.');
        })
        .finally(() => { btn.disabled=false; });
      } catch(e){
        console.error(e); alert('Error inesperado.'); btn.disabled=false;
      }
    }

    contenedorListado.addEventListener('click', function(ev){
        const btn = ev.target.closest('.btn-editar');
        if(!btn) return;

        const id = Number(btn.dataset.id || 0);
        if(!id){ alert('No se pudo identificar el registro.'); return; }

        const tr = btn.closest('tr');
        let pims     = parseNumber(btn.dataset.pims);
        let validada = parseNumber(btn.dataset.validada);
        let fechaStr = btn.dataset.fecha || '';

        if((pims === null || validada === null || !fechaStr) && tr){
          const tdPims = tr.querySelector('td[data-col="pims"]');
          const tdVal  = tr.querySelector('td[data-col="validada"]');
          const tdFecha = tr.querySelector('td[data-col="fecha"]');

          if(pims === null && tdPims){
            const raw = tdPims.getAttribute('data-value') ?? tdPims.textContent;
            pims = parseNumber(raw);
          }
          if(validada === null && tdVal){
            const raw = tdVal.getAttribute('data-value') ?? tdVal.textContent;
            validada = parseNumber(raw);
          }
          if(!fechaStr && tdFecha){
             fechaStr = tdFecha.getAttribute('data-value') || tdFecha.textContent.trim().split(' ')[0];
          }
        }

        const finalFecha = /^\d{4}-\d{2}-\d{2}$/.test(fechaStr) ? fechaStr : (new Date().toISOString().split('T')[0]);

        showEditOverlay({ id, pims, validada, fechaISO: finalFecha });
    });
});
</script>



@*Fecha*@

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const inputFecha = document.getElementById("fechaReporte");

        // Obtener la fecha de ayer
        const hoy = new Date();
        hoy.setDate(hoy.getDate() - 1); // resta un día

        // Formatear a yyyy-mm-dd
        const año = hoy.getFullYear();
        const mes = String(hoy.getMonth() + 1).padStart(2, "0");
        const dia = String(hoy.getDate()).padStart(2, "0");
        const fechaFormateada = `${año}-${mes}-${dia}`;

        // Asignar la fecha al input
        inputFecha.value = fechaFormateada;

        // Ejecutar fetch automáticamente al cargar con la fecha de ayer
        filtrarPorFecha();
    });

    function filtrarPorFecha() {
        const fecha = document.getElementById("fechaReporte").value;

        fetch(`/TuControlador/GetCapturasHumedad?fecha=${encodeURIComponent(fecha)}`)
            .then(response => {
                if (!response.ok) throw new Error("Error al obtener datos");
                return response.json();
            })
            .then(data => {
                console.log("Datos recibidos:", data);
                // aquí puedes llenar tu tabla o contenedor con los datos
            })
            .catch(error => {
                console.error("Error en la solicitud:", error);
            });
    }
</script>


@*Loading*@

<script>

    (function () {
        function showLoading() {
            var m = document.getElementById('loadingModal');
            if (m) m.style.display = 'block';
        }
        function hideLoading() {
            var m = document.getElementById('loadingModal');
            if (m) m.style.display = 'none';
        }
        // expone helpers por si quieres usarlos en otros fetch
        window.showLoading = showLoading;
        window.hideLoading = hideLoading;

        // muestra lo antes posible (cuando el DOM ya esta parseado)
        document.addEventListener('readystatechange', function () {
            if (document.readyState === 'interactive') showLoading();
        });

        // oculta cuando ya cargo todo (assets incluidos)
        window.addEventListener('load', function () {
            setTimeout(hideLoading, 200);
        });

        // muestra al navegar/recargar (cuando cambias de pagina)
        window.addEventListener('beforeunload', function () {
            showLoading();
        });
    })();

</script>


