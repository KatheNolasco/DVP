@model DVP.Models.OperationDataToReportViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Downtime Page";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<style>
    /* Estilo para el contenedor de la fecha y hora */
    .container {
        font-family: Arial, sans-serif;
        display: flex; /* Usamos flex para alinearlos horizontalmente */
        justify-content: center; /* Centra los elementos horizontalmente */
        align-items: center; /* Centra los elementos verticalmente */
        gap: 20px; /* Espacio entre los divs */
        margin-top: 20px;
    }
    /* Estilo para los divs de fecha y hora */
    .input-container {
        font-size: 18px;
        display: flex;
        flex-direction: column; /* Los inputs se alinean de arriba hacia abajo */
        align-items: center;
    }

    input {
        padding: 10px;
        font-size: 16px;
        margin-top: 10px;
        border: 2px solid #ccc;
        border-radius: 8px;
        background-color: #f0f0f0;
    }

    .scrollable-table {
        max-height: 400px;
        overflow-y: auto;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa; /* color fondo header */
        z-index: 2;
        text-align: center;
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
        text-align: center;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 45px;
        height: 24px;
        margin-right: 8px;
        vertical-align: middle;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .switch .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 34px;
        }

            .switch .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 3px;
                bottom: 3px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        .switch input:checked + .slider {
            background-color: #13DEB9; /* Verde menta */
        }

            .switch input:checked + .slider:before {
                transform: translateX(21px);
            }

    .switch-label {
        font-size: 14px;
        color: #555;
        vertical-align: middle;
    }
</style>


<body>
    <div class="container-fluid" style="padding-left: 200px;">
        <div class="card">
            <div class="container-fluid">
                <div class="container-fluid">
                    <div class="card">
                        <div class="card-body">
                            <div id="alertsuccesclose" class="alert alert-success" role="alert" style="display: none;">
                                Agregado correctamente!
                            </div>

                            <div class="card-body" style="text-align: right;">
                                <input type="date" id="fechaReporte" style="text-align: right;" onchange="filtrarPorFecha()">
                            </div>
                        </div>
                        <h5 class="card-title fw-semibold mb-4">Configuration humidity of materials</h5>
                        <br />
                        <div class="mb-3">
                            <label class="form-label">Agregar </label>
                            <div class="d-flex">
                                <select class="form-select" id="selectEquipo"></select>
                                <select class="form-select" id="selectConsumo"></select>
                                <select class="form-select" id="selectProduccion"></select>
                                <button id="agregar" class="btn btn-sm btn-primary ms-2">Agregar</button>
                            </div>
                            <br />
                            <div class="d-flex">
                                <select class="form-select" id="selectMaterialProduccion"></select>
                                <select class="form-select" id="selectMaterialConsumo"></select>
                                <button id="agregarmaterial" class="btn btn-sm btn-primary ms-2">Agregar</button>
                            </div>
                            <br />
                            <label class="form-label">Listar</label>
                            <div class="d-flex">
                                <select class="form-select" id="selectEquipoList"></select>
                                <select class="form-select" id="selectMaterial">
                                    <option value="Produccion">Producción</option>
                                    <option value="Consumo">Consumo</option>
                                </select>
                            </div>
                        </div>
                        <div id="filtrosListado" class="row g-3 mb-2"></div>
                        <div id="contenedorListado" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*___________________________________________________________________Modal Cargando__________________________________________________*@
    <div id="loadingModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; background-color: rgba(0, 0, 0, 0.5);">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background-color: white; padding: 25px 35px; border-radius: 10px; box-shadow: 0 0 15px rgba(0,0,0,0.3); min-width: 250px;">
            <div style="display: flex; align-items: center; justify-content: center;">
                <img src="/Content/loading-green-loading.gif" alt="Cargando..." style="width: 40px; height: 40px; margin-right: 15px;" />
                <span style="color: black; font-size: 16px;">Cargando...</span>
            </div>
        </div>
    </div>

</body>

@*Create por equipo*@
<script>
    document.addEventListener('DOMContentLoaded', function () {
        'use strict';

        const selectEquipo = document.getElementById('selectEquipo');
        const selectConsumo = document.getElementById('selectConsumo');
        const selectProduccion = document.getElementById('selectProduccion');
        const btnAgregar = document.getElementById('agregar'); // O el ID del botón que abre el modal
        const inputFecha = document.getElementById('fechaReporte');

        // Endpoints (Asegúrate de que estos sean correctos para tu lógica de Equipo/BOM)
        const URL_EQUIPOS = '@Url.Action("GetEquiposporPaislogguedUser", "Equipo")';
        const URL_BOMS_CONSUMO = '@Url.Action("GetBOMsConsumoByEquipo", "BillOfMaterial")';
        const URL_BOMS_PRODUCCION = '@Url.Action("GetBOMsProduccionByEquipo", "BillOfMaterial")';
        const URL_CREATE_HUMEDAD = '@Url.Action("CrearCapturaHumedadByBOM", "OperationDataToReport")';

        // helpers
        function option(el, value, text) { const o = document.createElement('option'); o.value = value; o.textContent = text; el.appendChild(o); }
        function clearSelect(el) { el.innerHTML = ''; }
        function showAlert(msg) {
            const el = document.getElementById('alertsuccesclose');
            if (el) { el.textContent = msg; el.style.display = 'block'; setTimeout(() => el.style.display = 'none', 2500); }
            else alert(msg);
        }
        function hoyISO() { return new Date().toISOString().split('T')[0]; }

        async function loadEquipos() {
            if (!selectEquipo) return;
            selectEquipo.disabled = true;
            clearSelect(selectEquipo);
            option(selectEquipo, '', 'Cargando equipos...');

            try {
                const r = await fetch(URL_EQUIPOS, { headers: { 'Accept': 'application/json' } });
                const data = await r.json();

                const list = Array.isArray(data) ? data : (Array.isArray(data?.data) ? data.data : []);

                clearSelect(selectEquipo);
                option(selectEquipo, '', 'Seleccione equipo');
                list.forEach(x => {
                    const v = x?.EquipoID, t = x?.Descripcion;
                    if (v !== undefined && t !== undefined) option(selectEquipo, String(v), String(t));
                });

            } catch (e) {
                console.error('[Equipos]', e);
                clearSelect(selectEquipo);
                option(selectEquipo, '', '(error al cargar equipos)');
            } finally {
                selectEquipo.disabled = false;
            }
        }

        function loadBOMConsumo(equipoId) {
            selectConsumo.disabled=true;
            clearSelect(selectConsumo);
            option(selectConsumo,'','Cargando consumo...');

            if(!equipoId){
                clearSelect(selectConsumo);
                option(selectConsumo, '', 'Seleccione material consumo...'); // <- CORRECCIÓN
                selectConsumo.disabled=false;
                return;
            }

            fetch(`${URL_BOMS_CONSUMO}?equipoId=${encodeURIComponent(equipoId)}`,{headers:{'Accept':'application/json'}})
            .then(r=>r.json())
            .then(res=>{
                const arr=(res && res.success && Array.isArray(res.data))?res.data:[];
                const items=[];
                const seen=new Set();
                arr.forEach(x=>{
                    const id=x?._materialConsumoID, txt=x?._materialConsumoDescripcion;
                    if(id && txt && !seen.has(id)){
                        seen.add(id);
                        items.push({id,txt});
                    }
                });

                clearSelect(selectConsumo);
                option(selectConsumo, '', 'Seleccione material consumo...'); // <- CORRECCIÓN
                items.forEach(x => option(selectConsumo, x.id, x.txt));
            })
            .catch(e=>{
                console.error('[Consumo]',e);
                clearSelect(selectConsumo);
                option(selectConsumo, '', '(error al cargar consumo)');
            })
            .finally(()=>{ selectConsumo.disabled=false; });
        }

        function loadBOMProduccion(equipoId) {
            selectProduccion.disabled=true;
            clearSelect(selectProduccion);
            option(selectProduccion,'','Cargando produccion...');

            if(!equipoId){
                clearSelect(selectProduccion);
                option(selectProduccion, '', 'Seleccione material produccion...'); // <- CORRECCIÓN
                selectProduccion.disabled=false;
                return;
            }

            fetch(`${URL_BOMS_PRODUCCION}?equipoId=${encodeURIComponent(equipoId)}`,{headers:{'Accept':'application/json'}})
            .then(r=>r.json())
            .then(res=>{
                const arr=(res && res.success && Array.isArray(res.data))?res.data:[];
                const items=[];
                const seen=new Set();
                arr.forEach(x=>{
                    const id=x?._materialProduccionID, txt=x?._materialProduccionDescripcion;
                    if(id && txt && !seen.has(id)){
                        seen.add(id);
                        items.push({id,txt});
                    }
                });

                clearSelect(selectProduccion);
                option(selectProduccion, '', 'Seleccione material produccion...'); // <- CORRECCIÓN
                items.forEach(x => option(selectProduccion, x.id, x.txt));
            })
            .catch(e=>{
                console.error('[Produccion]',e);
                clearSelect(selectProduccion);
                option(selectProduccion, '', '(error al cargar produccion)');
            })
            .finally(()=>{ selectProduccion.disabled=false; });
        }

        // Eventos de selección para cargar BOMs y hacer bloqueo cruzado
        selectEquipo.addEventListener('change', function(){
            const eqId = this.value ? Number(this.value) : 0;
            selectConsumo.disabled=false;
            selectConsumo.value='';
            selectProduccion.disabled=false;
            selectProduccion.value='';
            loadBOMConsumo(eqId);
            loadBOMProduccion(eqId);
        });

        // Bloqueo cruzado
        selectConsumo.addEventListener('change', ()=>{
            if(selectConsumo.value){
                selectProduccion.value='';
                selectProduccion.disabled=true;
            } else {
                selectProduccion.disabled=false;
            }
        });

        selectProduccion.addEventListener('change', ()=>{
            if(selectProduccion.value){
                selectConsumo.value='';
                selectConsumo.disabled=true;
            } else {
                selectConsumo.disabled=false;
            }
        });

        // ---------- MODAL ----------
        let createBg = null, createEl = null;

        function ensureCreateOverlay() {
            if (createBg && createEl) return;

            createBg = document.createElement('div');
            createBg.id = 'overlayCrear_bg';
            createBg.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:2050;display:none;';
            createEl = document.createElement('div');
            createEl.id = 'overlayCrear';
            createEl.style.cssText = 'position:fixed;left:50%;top:8vh;transform:translateX(-50%);z-index:2051;display:none;max-width:760px;width:calc(100% - 32px);background:#fff;border-radius:10px;box-shadow:0 12px 28px rgba(0,0,0,.2);';

            // Estructura del modal
            createEl.innerHTML = `
        <div style="padding:.75rem 1rem;border-bottom:1px solid #e9ecef;" class="d-flex align-items-center justify-content-between">
            <strong>Nueva Captura de Humedad</strong>
            <button type="button" id="cr_close_top" class="btn btn-sm btn-outline-secondary">Cerrar</button>
        </div>
        <div style="padding:1rem;">
            <div class="row g-2">
                <input id="cr_equipoId" type="hidden">
                <input id="cr_materialId" type="hidden">

                <div class="col-md-6">
                    <label class="form-label">Equipo</label>
                    <input id="cr_equipoDesc" class="form-control" disabled>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Material</label>
                    <input id="cr_materialDesc" class="form-control" disabled>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Cant PIMS</label>
                    <div class="input-group">
                        <input id="cr_cantPims" type="number" step="0.000001" class="form-control text-end" disabled>
                        <span class="input-group-text" style="min-width:56px;">%</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Cant Validada</label>
                    <div class="input-group">
                        <input id="cr_cantVal" type="text" class="form-control text-end">
                        <span class="input-group-text" style="min-width:56px;">%</span>
                    </div>
                    <div id="cr_cantVal_error" class="text-danger small mt-1" style="display:none;"></div>
                </div>

                <div class="col-12">
                    <div class="alert alert-info py-2 mb-0">
                        Esta accion quedara registrada con la fecha/hora del servidor.
                    </div>
                </div>
            </div>
        </div>
        <div style="padding:.75rem 1rem;border-top:1px solid #e9ecef;" class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" id="cr_cancel">Cancelar</button>
            <button type="button" class="btn btn-success" id="cr_guardar">Guardar</button>
        </div>`;

            document.body.appendChild(createBg);
            document.body.appendChild(createEl);
            createBg.addEventListener('click', hideCreateOverlay);
            createEl.querySelector('#cr_close_top').addEventListener('click', hideCreateOverlay);
            createEl.querySelector('#cr_cancel').addEventListener('click', hideCreateOverlay);
            createEl.querySelector('#cr_guardar').addEventListener('click', guardarDesdeCreateOverlay);

            // Listener para la validación en tiempo real
            createEl.querySelector('#cr_cantVal').addEventListener('input', validateCantidadValidada);
            createEl.querySelector('#cr_cantVal').addEventListener('blur', validateCantidadValidada);
        }

        function validateCantidadValidada(){
            if(!createEl) return false;
            const input = createEl.querySelector('#cr_cantVal');
            const errorEl = createEl.querySelector('#cr_cantVal_error');
            const guardarBtn = createEl.querySelector('#cr_guardar');
            let value = input.value.trim();
            let errorMessage = '';

            input.classList.remove('is-invalid');
            errorEl.style.display = 'none';
            errorEl.textContent = '';
            guardarBtn.disabled = false;

            if (value === '') {
                errorMessage = 'La cantidad es obligatoria.';
            } else if (value.includes(',')) {
                errorMessage = 'No se permiten comas, use un punto (.) como separador decimal.';
            } else {
                const regex = /^\d+(\.\d{1,3})?$/;
                if (!regex.test(value)) {
                    const parts = value.split('.');
                    if (parts.length > 1 && parts[1].length > 3) {
                        errorMessage = 'Solo se permiten hasta 3 decimales.';
                    } else if (Number.isNaN(Number(value))) {
                        errorMessage = 'Formato numérico inválido.';
                    }
                }

                const numValue = Number(value);
                if (Number.isFinite(numValue) && numValue > 100) {
                    errorMessage = 'La cantidad no puede ser mayor a 100.';
                }
            }

            if (errorMessage) {
                input.classList.add('is-invalid');
                errorEl.textContent = errorMessage;
                errorEl.style.display = 'block';
                guardarBtn.disabled = true;
                return false;
            }

            guardarBtn.disabled = false;
            return true;
        }


        function showCreateOverlay() {
            const eqId = Number(selectEquipo.value || 0);
            const eqDesc = selectEquipo.options[selectEquipo.selectedIndex]?.text || '';
            const matConsId = Number(selectConsumo.value || 0);
            const matConsDesc = matConsId ? (selectConsumo.options[selectConsumo.selectedIndex]?.text || '') : '';
            const matProdId = Number(selectProduccion.value || 0);
            const matProdDesc = matProdId ? (selectProduccion.options[selectProduccion.selectedIndex]?.text || '') : '';


            if (!eqId) { alert('Debe seleccionar un equipo.'); return; }
            if (!matConsId && !matProdId) { alert('Seleccione un material de consumo o uno de produccion.'); return; }

            ensureCreateOverlay();

            const matId = matConsId || matProdId;
            const matDesc = matConsDesc || matProdDesc;

            const fechaStr = (inputFecha && inputFecha.value) ? inputFecha.value : hoyISO();

            createEl.querySelector('#cr_equipoId').value = eqId;
            createEl.querySelector('#cr_materialId').value = matId;
            createEl.querySelector('#cr_equipoDesc').value = eqDesc;
            createEl.querySelector('#cr_materialDesc').value = matDesc;

            const pimsInput = createEl.querySelector('#cr_cantPims');
            if (pimsInput) { pimsInput.value = ''; pimsInput.disabled = true; }

            createEl.querySelector('#cr_cantVal').value = '';

            validateCantidadValidada();

            createBg.style.display = 'block';
            createEl.style.display = 'block';
        }

        function hideCreateOverlay() {
            if (createBg && createEl) {
                createBg.style.display = 'none';
                createEl.style.display = 'none';
            }
        }

        function guardarDesdeCreateOverlay() {
            const cantValInput = createEl.querySelector('#cr_cantVal');

            if (!validateCantidadValidada()) {
                alert('Corrija la cantidad validada antes de guardar.');
                cantValInput.focus();
                return;
            }

            const btn = createEl.querySelector('#cr_guardar');
            btn.disabled = true;
            try {
                const equipoId = Number(createEl.querySelector('#cr_equipoId')?.value || 0);
                const materialId = Number(createEl.querySelector('#cr_materialId')?.value || 0);
                const cantValV = cantValInput.value;
                const cantidadValidada = (cantValV==='') ? null : Number(cantValV);

                const fechaStr = (inputFecha && inputFecha.value) ? inputFecha.value : hoyISO();
                const fechaISO = new Date(fechaStr + 'T00:00:00').toISOString();

                if(!equipoId){ alert('Equipo es obligatorio.'); btn.disabled=false; return; }
                if(cantidadValidada===null || Number.isNaN(cantidadValidada)){
                    alert('Cantidad validada es obligatoria y debe ser un número válido.');
                    btn.disabled=false;
                    return;
                }

                const payload = {
                    _equipoId: equipoId,
                    _materialId: materialId,
                    _cantidadValidada: Number.isFinite(cantidadValidada) ? cantidadValidada : null,
                    _fechaReporte: fechaISO
                };

                fetch(URL_CREATE_HUMEDAD,{
                    method:'POST',
                    headers:{'Content-Type':'application/json'},
                    body: JSON.stringify(payload)
                })
                .then(r=>r.json())
                .then(res=>{
                    if(res && res.success){
                        showAlert('Humedad registrada correctamente.');
                        hideCreateOverlay();
                        selectEquipo.value = '';
                        loadBOMConsumo(0);
                        loadBOMProduccion(0);
                        if(inputFecha){ inputFecha.dispatchEvent(new Event('change')); }
                    } else {
                        alert('No se pudo registrar: ' + (res?.message || 'Error desconocido'));
                    }
                })
                .catch(err=>{
                    console.error(err);
                    alert('Error al registrar la humedad.');
                })
                .finally(()=>{ btn.disabled=false; });
            }catch(e){
                console.error(e);
                alert('Error inesperado.');
                btn.disabled=false;
            }
        }

        if(btnAgregar){
            btnAgregar.addEventListener('click', e=>{
                e.preventDefault();
                showCreateOverlay();
            });
        }

        // init
        loadEquipos();
    });
</script>



@*Create por material*@

<script>
    document.addEventListener('DOMContentLoaded', function () {
        'use strict';

        const selProd = document.getElementById('selectMaterialProduccion');
        const selCons = document.getElementById('selectMaterialConsumo');
        const btnAgregar = document.getElementById('agregarmaterial');
        const inputFecha = document.getElementById('fechaReporte'); // opcional, si no existe se usa hoy

        // Endpoints
        // NOTA: Reemplaza estas URLs con las que sean correctas para tu entorno
        const URL_MAT_PROD = '/Material/GetMaterialProducido';
        const URL_MAT_CONS = '/Material/GetMaterialConsumido';
        const URL_CREAR_PROD = '/OperationDataToReport/CrearCapturaHumedadByMaterialProduccion';
        const URL_CREAR_CONS = '/OperationDataToReport/CrearCapturaHumedadByMaterialConsumo';

        // helpers
        function option(el, value, text) { const o = document.createElement('option'); o.value = value; o.textContent = text; el.appendChild(o); }
        function clearSelect(el) { el.innerHTML = ''; }
        function showAlert(msg) {
            const el = document.getElementById('alertsuccesclose');
            if (el) { el.textContent = msg; el.style.display = 'block'; setTimeout(() => el.style.display = 'none', 2500); }
            else alert(msg);
        }
        function todayISO() { return new Date().toISOString().split('T')[0]; }

        async function loadMateriales() {
            clearSelect(selProd); clearSelect(selCons);
            option(selProd, '', 'Cargando produccion...');
            option(selCons, '', 'Cargando consumo...');

            try {
                const [rProd, rCons] = await Promise.all([
                    fetch(URL_MAT_PROD, { headers: { 'Accept': 'application/json' } }),
                    fetch(URL_MAT_CONS, { headers: { 'Accept': 'application/json' } })
                ]);
                const [dataProd, dataCons] = await Promise.all([rProd.json(), rCons.json()]);

                clearSelect(selProd);
                option(selProd, '', 'Seleccione material de produccion...');
                (Array.isArray(dataProd) ? dataProd : []).forEach(m => {
                    if (m?.MaterialID != null && m?.Descripcion != null) option(selProd, m.MaterialID, m.Descripcion);
                });

                clearSelect(selCons);
                option(selCons, '', 'Seleccione material de consumo...');
                (Array.isArray(dataCons) ? dataCons : []).forEach(m => {
                    if (m?.MaterialID != null && m?.Descripcion != null) option(selCons, m.MaterialID, m.Descripcion);
                });

            } catch (e) {
                console.error('[Materiales]', e);
                clearSelect(selProd); clearSelect(selCons);
                option(selProd, '', '(error cargando produccion)');
                option(selCons, '', '(error cargando consumo)');
            }
        }

        // bloqueo cruzado
        function syncDisable() {
            const prodVal = selProd.value;
            const consVal = selCons.value;
            selCons.disabled = !!prodVal;
            selProd.disabled = !!consVal;
        }
        selProd.addEventListener('change', syncDisable);
        selCons.addEventListener('change', syncDisable);

        // ---------- MODAL ----------
        let createBg = null, createEl = null;

        function ensureCreateOverlay() {
            if (createBg && createEl) return;

            createBg = document.createElement('div');
            createBg.id = 'overlayCrear_bg';
            createBg.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:2050;display:none;';
            createEl = document.createElement('div');
            createEl.id = 'overlayCrear';
            createEl.style.cssText = 'position:fixed;left:50%;top:8vh;transform:translateX(-50%);z-index:2051;display:none;max-width:760px;width:calc(100% - 32px);background:#fff;border-radius:10px;box-shadow:0 12px 28px rgba(0,0,0,.2);';

            // ESTRUCTURA BASE: CAMBIO DE type="number" a type="text" en cr_cantVal
            createEl.innerHTML = `
        <div style="padding:.75rem 1rem;border-bottom:1px solid #e9ecef;" class="d-flex align-items-center justify-content-between">
            <strong>Nueva Captura de Humedad</strong>
            <button type="button" id="cr_close_top" class="btn btn-sm btn-outline-secondary">Cerrar</button>
        </div>
        <div style="padding:1rem;">
            <div class="row g-2">
                <input id="cr_materialId" type="hidden">
                <input id="cr_tipoMaterial" type="hidden">
                <div class="col-md-6">
                    <label class="form-label">Material</label>
                    <input id="cr_materialDesc" class="form-control" disabled>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Fecha reporte</label>
                    <input id="cr_fecha" class="form-control" disabled>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Cant PIMS</label>
                    <div class="input-group">
                        <input id="cr_cantPims" type="number" step="0.000001" class="form-control text-end" disabled>
                        <span class="input-group-text" style="min-width:56px;">%</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Cant Validada</label>
                    <div class="input-group">
                        <input id="cr_cantVal" type="text" class="form-control text-end">
                        <span class="input-group-text" style="min-width:56px;">%</span>
                    </div>
                    <div id="cr_cantVal_error" class="text-danger small mt-1" style="display:none;"></div>
                </div>

                <div class="col-12">
                    <div class="alert alert-info py-2 mb-0">
                        Se registrara para todos los equipos asociados a este material (segun BOM). La unidad es %.
                    </div>
                </div>
            </div>
        </div>
        <div style="padding:.75rem 1rem;border-top:1px solid #e9ecef;" class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" id="cr_cancel">Cancelar</button>
            <button type="button" class="btn btn-success" id="cr_guardar">Guardar</button>
        </div>`;

            document.body.appendChild(createBg);
            document.body.appendChild(createEl);
            createBg.addEventListener('click', hideCreateOverlay);
            createEl.querySelector('#cr_close_top').addEventListener('click', hideCreateOverlay);
            createEl.querySelector('#cr_cancel').addEventListener('click', hideCreateOverlay);
            createEl.querySelector('#cr_guardar').addEventListener('click', guardarDesdeCreateOverlay);

            // Listener para la validación en tiempo real (input y blur)
            createEl.querySelector('#cr_cantVal').addEventListener('input', validateCantidadValidada);
            createEl.querySelector('#cr_cantVal').addEventListener('blur', validateCantidadValidada); // Para validar al salir del campo
        }

        // Función de validación (ajustada para el control estricto)
        function validateCantidadValidada() {
            if (!createEl) return false;
            const input = createEl.querySelector('#cr_cantVal');
            const errorEl = createEl.querySelector('#cr_cantVal_error');
            const guardarBtn = createEl.querySelector('#cr_guardar');
            let value = input.value.trim();
            let errorMessage = '';

            // 1. Limpiar estilos y mensajes
            input.classList.remove('is-invalid');
            errorEl.style.display = 'none';
            errorEl.textContent = '';
            guardarBtn.disabled = false;

            // **VALIDACIÓN ESTRICTA DE CAMPO VACÍO (ROJO INMEDIATO)**
            if (value === '') {
                errorMessage = 'La cantidad es obligatoria.';
            } else if (value.includes(',')) {
                // 1. Validación de comas (,) - **SOLO PUNTOS**
                errorMessage = 'No se permiten comas, use un punto (.) como separador decimal.';
            } else {
                // Validación de formato general: debe ser un número con opcionalmente un punto y hasta 3 dígitos.
                // Usamos Regex para ser estrictos con los decimales
                const regex = /^\d+(\.\d{1,3})?$/;
                if (!regex.test(value)) {
                    // Si falla el regex, podría ser más de 3 decimales o un formato incorrecto (ej: "123.4567" o "12.3.")
                    const parts = value.split('.');
                    if (parts.length > 1 && parts[1].length > 3) {
                        errorMessage = 'Solo se permiten hasta 3 decimales.';
                    } else if (Number.isNaN(Number(value))) {
                        errorMessage = 'Formato numérico inválido.';
                    }
                }

                // 2. Validación de valor > 100
                const numValue = Number(value);
                if (Number.isFinite(numValue) && numValue > 100) {
                    errorMessage = 'La cantidad no puede ser mayor a 100.';
                }
            }

            if (errorMessage) {
                input.classList.add('is-invalid'); // Clase de Bootstrap para poner en rojo el input
                errorEl.textContent = errorMessage;
                errorEl.style.display = 'block';
                guardarBtn.disabled = true;
                return false;
            }

            guardarBtn.disabled = false;
            return true;
        }


        function showCreateOverlay() {
            const matProdId = selProd.value ? Number(selProd.value) : 0;
            const matConsId = selCons.value ? Number(selCons.value) : 0;

            if (!matProdId && !matConsId) { alert('Seleccione un material de produccion o de consumo.'); return; }
            if (matProdId && matConsId) { alert('Solo puede seleccionar uno a la vez.'); return; }

            ensureCreateOverlay();

            const tipo = matProdId ? 'PROD' : 'CONS';
            const matId = matProdId || matConsId;
            const matDesc = (matProdId
                ? selProd.options[selProd.selectedIndex]?.text
                : selCons.options[selCons.selectedIndex]?.text) || '';

            const fechaStr = (inputFecha && inputFecha.value) ? inputFecha.value : todayISO();

            createEl.querySelector('#cr_tipoMaterial').value = tipo;
            createEl.querySelector('#cr_materialId').value = matId;
            createEl.querySelector('#cr_materialDesc').value = matDesc;
            createEl.querySelector('#cr_fecha').value = fechaStr;

            // limpiar y asegurar PIMS deshabilitado
            const pimsInput = createEl.querySelector('#cr_cantPims');
            if (pimsInput) { pimsInput.value = ''; pimsInput.disabled = true; }

            createEl.querySelector('#cr_cantVal').value = '';

            // Limpiar errores al abrir el modal y FORZAR VALIDACIÓN
            validateCantidadValidada();

            createBg.style.display = 'block';
            createEl.style.display = 'block';
        }

        function hideCreateOverlay() {
            if (createBg && createEl) {
                createBg.style.display = 'none';
                createEl.style.display = 'none';
            }
        }

        function guardarDesdeCreateOverlay() {
            const cantValInput = createEl.querySelector('#cr_cantVal');

            // 1. Ejecutar validación final antes de guardar
            if (!validateCantidadValidada()) {
                alert('Corrija la cantidad validada antes de guardar.');
                cantValInput.focus();
                return;
            }

            const btn = createEl.querySelector('#cr_guardar');
            btn.disabled = true;
            try {
                const tipo = createEl.querySelector('#cr_tipoMaterial').value; // PROD o CONS
                const materialId = Number(createEl.querySelector('#cr_materialId').value || 0);
                const cantValV = cantValInput.value;
                // Al ser type="text", usamos Number() en el valor validado para el payload
                const cantidadVal = (cantValV === '') ? null : Number(cantValV);

                const fechaStr = (inputFecha && inputFecha.value) ? inputFecha.value : todayISO();
                const fechaISO = new Date(fechaStr + 'T00:00:00').toISOString();

                // 2. Validación de Obligatoriedad (adicional, aunque ya la cubre validateCantidadValidada)
                if (!materialId) { alert('Material es obligatorio.'); btn.disabled = false; return; }
                if (cantidadVal === null || Number.isNaN(cantidadVal)) { alert('Cantidad validada es obligatoria.'); btn.disabled = false; return; }

                const payload = {
                    _materialId: materialId,
                    _cantidadValidada: Number.isFinite(cantidadVal) ? cantidadVal : null,
                    _equipoId: 0, // Se mantiene el 0 para la compatibilidad con el endpoint
                    _fechaReporte: fechaISO
                };

                const url = (tipo === 'PROD') ? URL_CREAR_PROD : URL_CREAR_CONS;

                fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json; charset=utf-8' },
                    body: JSON.stringify(payload)
                })
                    .then(r => r.json())
                    .then(res => {
                        if (res && res.success) {
                            if (res.summary) {
                                const { inserted, skipped, total } = res.summary;
                                showAlert(`Humedad registrada: ${inserted} insertados, ${skipped} omitidos, total ${total}.`);
                            } else {
                                showAlert(res.message || 'Humedad registrada correctamente.');
                            }
                            hideCreateOverlay();
                            selProd.value = ''; selCons.value = '';
                            syncDisable();
                            if (inputFecha) { inputFecha.dispatchEvent(new Event('change')); }
                        } else {
                            alert(res?.message || 'No se pudo registrar.');
                        }
                    })
                    .catch(err => { console.error(err); alert('Error al registrar la humedad.'); })
                    .finally(() => { btn.disabled = false; });
            } catch (e) {
                console.error(e);
                alert('Error inesperado.');
                btn.disabled = false;
            }
        }

        if (btnAgregar) {
            btnAgregar.addEventListener('click', function (e) {
                e.preventDefault();
                showCreateOverlay();
            });
        }

        // init
        loadMateriales().then(syncDisable);
    });
</script>







@*List*@

<script>
document.addEventListener('DOMContentLoaded', function () {
    'use strict';

    const contenedorListado = document.getElementById('contenedorListado');
    const inputFecha        = document.getElementById('fechaReporte');
    const selectEquipoList  = document.getElementById('selectEquipoList');
    const selectMaterial    = document.getElementById('selectMaterial');

    const URL_GET_HUMEDAD = '@Url.Action("GetCapturasHumedad", "OperationDataToReport")';
    const URL_EQUIPOS     = '@Url.Action("GetEquiposporPaislogguedUser", "Equipo")';

    function option(el, value, text){ const o=document.createElement('option'); o.value=value; o.textContent=text; el.appendChild(o); }
    function fillSelect(selectEl, list, valueKey, textKey, placeholder){
      if(!selectEl) return;
      selectEl.innerHTML=''; option(selectEl,'',placeholder);
      (list||[]).forEach(x=>{
        const v=x?.[valueKey], t=x?.[textKey];
        if(v!==undefined && t!==undefined) option(selectEl,String(v),String(t));
      });
    }
    function escapeHtml(str){
      return String(str).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }
    function showMsg(msg,type='info'){
      contenedorListado.innerHTML = `<div class="alert alert-${type}" role="alert" style="margin-top:8px;">${escapeHtml(msg)}</div>`;
    }
    function fmtFechaHora(d){
      if(!d) return '';
      const m=/\/Date\((\d+)\)\//.exec(String(d));
      let dt=null;
      if(m){ const ms=parseInt(m[1],10); if(!Number.isNaN(ms)) dt=new Date(ms); }
      else dt=new Date(d);
      if(!dt || Number.isNaN(dt.getTime())) return '';
      const yyyy=dt.getFullYear();
      const mm=String(dt.getMonth()+1).padStart(2,'0');
      const dd=String(dt.getDate()).padStart(2,'0');
      const hh=String(dt.getHours()).padStart(2,'0');
      const mi=String(dt.getMinutes()).padStart(2,'0');
      return `${yyyy}-${mm}-${dd} ${hh}:${mi}`;
    }
    function renderCheck(v){ return v?'<i class="bi bi-check-circle-fill text-success"></i>':'<i class="bi bi-x-circle-fill text-danger"></i>'; }
    function getPimsRaw(r){
      if (r.hasOwnProperty('CantidadPIMS')) return r.CantidadPIMS;
      if (r.hasOwnProperty('CantidadPims')) return r.CantidadPims;
      return null;
    }
    function parseNumber(text){
      if(text == null) return null;
      const t = String(text).trim().replace(/%/g,'').replace(/\s+/g,'');
      const formatted = t.includes(',') ? t.replace(',', '.') : t;
      if(formatted === '') return null;
      const n = Number(formatted);
      return Number.isFinite(n) ? n : null;
    }
    function toISODateOnly(dateStr){
      const base = dateStr && /^\d{4}-\d{2}-\d{2}$/.test(dateStr)
                   ? dateStr
                   : (new Date()).toISOString().split('T')[0];
      return new Date(base + 'T00:00:00').toISOString();
    }
    function defaultAyerISO(){
      const hoy = new Date();
      const ayer = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() - 1);
      return ayer.toISOString().split('T')[0];
    }

    window.getCurrentParams = function(){
      const fechaISO  = (inputFecha && inputFecha.value) ? inputFecha.value : defaultAyerISO();
      const equipoId  = selectEquipoList && selectEquipoList.value ? Number(selectEquipoList.value) : 0;
      const tipoMateriaSel = (selectMaterial && selectMaterial.value) ? String(selectMaterial.value) : '';
      return { fechaISO, equipoId, tipoMaterial: tipoMateriaSel };
    };

    function buildTheadHtml(){
      return `<thead><tr>
        <th class="text-center">Fecha/Hora</th><th class="text-center">Equipo</th>
        <th class="text-center">Material</th><th class="text-center">Cant PIMS</th>
        <th class="text-center">Cant Validada</th><th class="text-center">Unidad</th>
        <th class="text-center">Tipo Mov SAP</th><th class="text-center">Close</th>
        <th class="text-center">Validate</th><th class="text-center">Acciones</th>
      </tr></thead>`;
    }

    function renderTabla(rows){
      const data = Array.isArray(rows) ? rows : [];
      if(!data.length){ showMsg('No hay registros para los filtros aplicados','warning'); return; }

      let tbody = '<tbody>';
      data.forEach(r=>{
        const pimsRaw = getPimsRaw(r);
        const valRaw  = (r.CantidadValidada !== undefined) ? r.CantidadValidada : null;

        const pimsTxt = (pimsRaw === null || pimsRaw === undefined) ? '—' : `${pimsRaw} %`;
        const valTxt  = (valRaw  === null || valRaw  === undefined) ? '—' : `${valRaw} %`;

        const materialDesc = r.Material ?? r.MaterialDescripcion ?? r.MaterialConsumo ?? r.MaterialProduccion ?? '';
        const sapMovDesc = (r.TipoMovimientoSAP && String(r.TipoMovimientoSAP).trim())
                           || (r.TipoMovimientoSAPDescripcion && String(r.TipoMovimientoSAPDescripcion).trim())
                           || '';
        const sapMovShown = sapMovDesc || (r.TipoMovimientoSAPID ?? '');

        let fechaData = '';
        if (r.FechaReporte){
          const m=/\/Date\((\d+)\)\//.exec(String(r.FechaReporte));
          const dt = m ? new Date(parseInt(m[1],10)) : new Date(r.FechaReporte);
          if(!Number.isNaN(dt?.getTime?.())){
            const yyyy=dt.getFullYear();
            const mm=String(dt.getMonth()+1).padStart(2,'0');
            const dd=String(dt.getDate()).padStart(2,'0');
            fechaData = `${yyyy}-${mm}-${dd}`;
          }
        }

        tbody += `<tr>
          <td class="text-center" data-col="fecha" data-value="${escapeHtml(fechaData)}">${escapeHtml(fmtFechaHora(r.FechaReporte))}</td>
          <td class="text-center">${escapeHtml(r.Equipo || '')}</td>
          <td class="text-center">${escapeHtml(materialDesc || '')}</td>
          <td class="text-end" data-col="pims" data-value="${pimsRaw ?? ''}">${pimsTxt}</td>
          <td class="text-end" data-col="validada" data-value="${valRaw ?? ''}">${valTxt}</td>
          <td class="text-center">${escapeHtml(r.UnidadMedida || '')}</td>
          <td class="text-center">${escapeHtml(String(sapMovShown))}</td>
          <td class="text-center">${renderCheck(!!r.StatusClose)}</td>
          <td class="text-center">${renderCheck(!!r.StatusValidate)}</td>
          <td class="text-center">
            <button class="btn btn-sm btn-primary btn-editar"
                    data-id="${r.DataOperacionID}"
                    data-pims="${pimsRaw ?? ''}"
                    data-validada="${valRaw ?? ''}"
                    data-fecha="${escapeHtml(fechaData)}">
              Editar
            </button>
          </td>
        </tr>`;
      });
      tbody += '</tbody>';

      contenedorListado.innerHTML = `
        <div class="table-responsive w-100" style="max-height:420px; overflow-y:auto; background-color:#fff; padding:10px; border-radius:10px;">
          <table class="table table-bordered table-sm table-striped mb-0" style="background-color:#fff;">
            ${buildTheadHtml()}${tbody}
          </table>
        </div>`;
    }

    function cargarCapturas(params){
      const { fechaISO, equipoId, tipoMaterial } = params;
      showMsg('Cargando...','secondary');

      let url = `${URL_GET_HUMEDAD}?_fecha=${encodeURIComponent(fechaISO)}`;
      if(equipoId){ url += `&_equipoId=${encodeURIComponent(equipoId)}`; }
      if(tipoMaterial){ url += `&_tipoMaterial=${encodeURIComponent(tipoMaterial)}`; }

      fetch(url, { headers:{'Accept':'application/json'} })
        .then(r=>{ if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); })
        .then(arr=> renderTabla(arr))
        .catch(err=>{ console.error(err); showMsg('No se pudo cargar la data de humedad','danger'); });
    }

    function loadEquiposList() {
      if(!selectEquipoList) return;
      selectEquipoList.disabled = true;
      selectEquipoList.innerHTML = '<option value="">Cargando equipos...</option>';
      fetch(URL_EQUIPOS, { headers:{'Accept':'application/json'} })
        .then(r=>r.json())
        .then(data=>{
          if(data && data.success===false){
            fillSelect(selectEquipoList, [], '', '', '(sesion no iniciada)');
            return;
          }
          const list = Array.isArray(data) ? data : (Array.isArray(data?.data) ? data.data : []);
          fillSelect(selectEquipoList, list, 'EquipoID', 'Descripcion', 'Todos los equipos');
        })
        .catch(err=>{
          console.error('[Equipos List] ', err);
          fillSelect(selectEquipoList, [], '', '', '(error al cargar equipos)');
        })
        .finally(()=>{ selectEquipoList.disabled=false; });
    }

    window.filtrarPorFecha = function(){
      cargarCapturas(window.getCurrentParams());
    };

    if(inputFecha){
      if(!inputFecha.value) inputFecha.value = defaultAyerISO();
      inputFecha.addEventListener('change', window.filtrarPorFecha);
    }
    if(selectEquipoList){
      selectEquipoList.addEventListener('change', window.filtrarPorFecha);
    }
    if(selectMaterial){
      selectMaterial.addEventListener('change', window.filtrarPorFecha);
    }

    loadEquiposList();
    window.filtrarPorFecha();
});
</script>





