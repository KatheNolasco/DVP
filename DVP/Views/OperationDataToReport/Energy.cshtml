@model DVP.Models.OperationDataToReportViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Downtime Page";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<style>
    /* Estilo para el contenedor de la fecha y hora */
    .container {
        font-family: Arial, sans-serif;
        display: flex; /* Usamos flex para alinearlos horizontalmente */
        justify-content: center; /* Centra los elementos horizontalmente */
        align-items: center; /* Centra los elementos verticalmente */
        gap: 20px; /* Espacio entre los divs */
        margin-top: 20px;
    }
    /* Estilo para los divs de fecha y hora */
    .input-container {
        font-size: 18px;
        display: flex;
        flex-direction: column; /* Los inputs se alinean de arriba hacia abajo */
        align-items: center;
    }

    input {
        padding: 10px;
        font-size: 16px;
        margin-top: 10px;
        border: 2px solid #ccc;
        border-radius: 8px;
        background-color: #f0f0f0;
    }

    .scrollable-table {
        max-height: 400px;
        overflow-y: auto;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa; /* color fondo header */
        z-index: 2;
        text-align: center;
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
        text-align: center;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 45px;
        height: 24px;
        margin-right: 8px;
        vertical-align: middle;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .switch .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 34px;
        }

            .switch .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 3px;
                bottom: 3px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        .switch input:checked + .slider {
            background-color: #13DEB9; /* Verde menta */
        }

            .switch input:checked + .slider:before {
                transform: translateX(21px);
            }

    .switch-label {
        font-size: 14px;
        color: #555;
        vertical-align: middle;
    }
</style>


<body>
    <div class="container-fluid" style="padding-left: 200px;">
        <div class="card">
            <div class="container-fluid">
                <div class="container-fluid">
                    <div class="card">
                        <div class="card-body">
                            <div id="alertsuccesclose" class="alert alert-success" role="alert" style="display: none;">
                                Agregado correctamente!
                            </div>
                            <!-- Fecha de validación -->
                            <br />
                            <h5 class="card-title fw-semibold mb-4">
                                <div class="d-flex flex-column align-items-end gap-2">
                                    <br />
                                    <select class="form-select" id="_plantaAsignada" style="width: auto; min-width: 200px;">
                                        <option value="">Seleccione una planta</option>
                                    </select>
                                    <div class="d-flex align-items-center gap-2">
                                        <button onclick="" id="btnDescargarEnergy" class="btn btn-link p-0 m-0 align-baseline" title="Download energy">
                                            <i class="bi bi-arrow-down-circle-fill text-success ms-2"></i>
                                        </button>
                                        <span>Energy Validation Date:</span>
                                        <button onclick="cerrarReporte()" id="btnCerrarReporte" class="btn btn-link p-0 m-0 align-baseline" title="Close report">
                                            <i class="bi bi-unlock-fill text-warning ms-2"></i>
                                        </button>
                                        <input type="date" id="fechaReporte" onchange="">
                                        <a id="btnenergy" onclick="sendtoenergyvalidation()"
                                           class="btn btn-link p-0 m-0 align-baseline"
                                           style="display: none;" role="button">
                                            <i class="bi bi-arrow-right-circle-fill text-danger"></i>
                                        </a>
                                    </div>
                                </div>
                            </h5>
                        </div>
                        <div style="display: flex; gap: 10px;">
                            <div id="totalkwhpims" class="alert alert-success p-2 my-2"
                                 style="width: fit-content;">
                                Total KWH PIMS: <strong id="countkwhpims">0</strong>
                            </div>
                            <div id="totalkwhvalidado" class="alert alert-success p-2 my-2"
                                 style="width: fit-content;">
                                Total KWH Validado: <strong id="countkwhvalidado">0</strong>
                            </div>
                        </div>
                        <div id="filtrosListado" class="row g-3 mb-2"></div>
                        <div id="contenedorListado" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*___________________________________________________________________Modal Cargando__________________________________________________*@
    <div id="loadingModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; background-color: rgba(0, 0, 0, 0.5);">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background-color: white; padding: 25px 35px; border-radius: 10px; box-shadow: 0 0 15px rgba(0,0,0,0.3); min-width: 250px;">
            <div style="display: flex; align-items: center; justify-content: center;">
                <img src="/Content/loading-green-loading.gif" alt="Cargando..." style="width: 40px; height: 40px; margin-right: 15px;" />
                <span style="color: black; font-size: 16px;">Cargando...</span>
            </div>
        </div>
    </div>

</body>



@*List*@

<script>
document.addEventListener('DOMContentLoaded', function () {
    'use strict';

    const MAX_QUANTITY = 500000; // Límite máximo para la cantidad validada

    const contenedorListado = document.getElementById('contenedorListado');
    const inputFecha        = document.getElementById('fechaReporte');
    const selectEquipoList  = document.getElementById('selectEquipoList');

    // === NUEVOS ELEMENTOS DE TOTALES ===
    const totalKwhPimsEl = document.getElementById('countkwhpims');
    const totalKwhValidadoEl = document.getElementById('countkwhvalidado');
    // ===================================

    // URLS DE ACCIÓN
    const URL_GET_ENERGY = '@Url.Action("GetEnergy", "OperationDataToReport")';
    const URL_EQUIPOS    = '@Url.Action("GetEquiposporPaislogguedUser", "Equipo")';
    const URL_SAVE_VALIDATED_QTY = '@Url.Action("UpdateEnergy", "OperationDataToReport")';

    // --- Funciones de Utilidad ---

    function option(el, value, text){ const o=document.createElement('option'); o.value=value; o.textContent=text; el.appendChild(o); }
    function fillSelect(selectEl, list, valueKey, textKey, placeholder){
      if(!selectEl) return;
      selectEl.innerHTML=''; option(selectEl,'',placeholder);
      (list||[]).forEach(x=>{
        const v=x?.[valueKey], t=x?.[textKey];
        if(v!==undefined && t!==undefined) option(selectEl,String(v),String(t));
      });
    }
    function escapeHtml(str){
      return String(str).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }

    // showMsg: AHORA INCLUYE LA LÓGICA DE RECARGA PARA 'danger'
    function showMsg(msg,type='info'){
      if (!msg || msg.includes('Cargando datos') || type === 'secondary' || type === 'success') {
          contenedorListado.innerHTML = '';
          // Limpia los totales al cargar
          updateTotals(0, 0);
          return;
      }
      if (type === 'danger' || type === 'warning') {
          contenedorListado.innerHTML = `<div class="alert alert-${type}" role="alert" style="margin-top:8px;">${escapeHtml(msg)}</div>`;
      }

      // === LÓGICA AÑADIDA PARA RECARGAR LA PÁGINA EN CASO DE 'danger' ===
      if (type === 'danger') {
          console.error(`Alerta 'danger' activada: Recargando en 2 segundos. Mensaje: ${msg}`);
          setTimeout(() => {
              window.location.reload();
          }, 2000); // 2 segundos de espera antes de la recarga
      }
    }
    // -----------------------------------------------------------------

    function fmtFechaHora(d){
      if(!d) return '';
      const m=/\/Date\((\d+)\)\//.exec(String(d));
      let dt=null;
      if(m){ const ms=parseInt(m[1],10); if(!Number.isNaN(ms)) dt=new Date(ms); }
      else dt=new Date(d);
      if(!dt || Number.isNaN(dt.getTime())) return '';
      const yyyy=dt.getFullYear();
      const mm=String(dt.getMonth()+1).padStart(2,'0');
      const dd=String(dt.getDate()).padStart(2,'0');
      const hh=String(dt.getHours()).padStart(2,'0');
      const mi=String(dt.getMinutes()).padStart(2,'0');
      return `${yyyy}-${mm}-${dd} ${hh}:${mi}`;
    }

    // Función original para StatusValidate (check/x)
    function renderCheck(v){
        return v ? '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-x-circle-fill text-danger"></i>';
    }

    // *** NUEVA FUNCIÓN SOLO PARA StatusClose (Candado) - Arreglo CS0103 con @@ ***
    /**
     * Renderiza un candado cerrado (bloqueado, true) o abierto (desbloqueado, false).
     * @@param {boolean} v - El valor booleano (true=cerrado, false=abierto).
     * @@returns {string} El HTML del icono de candado.
     */
    function renderCloseStatus(v){
        // Si es TRUE (cerrado/bloqueado) -> Candado cerrado (bi-lock-fill, color rojo para indicar bloqueo)
        if (v) {
            return '<i class="bi bi-lock-fill text-warning"></i>';
        }
        // Si es FALSE (abierto/desbloqueado) -> Candado abierto (bi-unlock-fill, text-warning como solicitaste)
        else {
            return '<i class="bi bi-unlock-fill text-warning"></i>';
        }
    }
    // ********************************************************************************

    function getPimsRaw(r){
      if (r.hasOwnProperty('CantidadPIMS')) return r.CantidadPIMS;
      if (r.hasOwnProperty('CantidadPims')) return r.CantidadPims;
      return null;
    }

    function defaultAyerISO(){
      const hoy = new Date();
      const ayer = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() - 1);
      return ayer.toISOString().split('T')[0];
    }

    function fmtNumero(val, decimals = 3) {
        if (val === null || val === undefined || val === '') return '';
        const num = Number(val);
        if (!Number.isFinite(num)) return '';

        const options = {
            minimumFractionDigits: 0,
            maximumFractionDigits: decimals,
            useGrouping: true
        };
        // Usamos 'en-US' (punto decimal) para el formato visual
        return num.toLocaleString('en-US', options);
    }


    window.getCurrentParams = function(){
      const fechaISO  = (inputFecha && inputFecha.value) ? inputFecha.value : defaultAyerISO();
      const equipoId  = selectEquipoList && selectEquipoList.value ? Number(selectEquipoList.value) : null;
      return { fechaISO, equipoId };
    };

    function buildTheadHtml(){
      return `<thead><tr>
        <th class="text-center">Fecha/Hora</th><th class="text-center">Equipo</th>
        <th class="text-center">Material</th><th class="text-center">Cant PIMS</th>
        <th class="text-center">Cant Validada</th><th class="text-center">Unidad</th>
        <th class="text-center">Tipo Mov SAP</th><th class="text-center">Close</th>
        <th class="text-center">Validate</th>
      </tr></thead>`;
    }

    // ======================================================================
    // === NUEVA FUNCIÓN DE CÁLCULO Y ACTUALIZACIÓN DE TOTALES ================
    // ======================================================================

    function updateTotals(totalPims, totalValidado) {
        // Asegura que los elementos existen antes de intentar actualizarlos
        if (totalKwhPimsEl) {
            totalKwhPimsEl.textContent = fmtNumero(totalPims, 3);
        }
        if (totalKwhValidadoEl) {
            totalKwhValidadoEl.textContent = fmtNumero(totalValidado, 3);
        }
    }

    function calculateAndRenderTotals(rows) {
        let totalPims = 0;
        let totalValidado = 0;

        (Array.isArray(rows) ? rows : []).forEach(r => {
            const pimsRaw = getPimsRaw(r);
            const valRaw  = (r.CantidadValidada !== undefined) ? r.CantidadValidada : null;

            // Suma de PIMS (solo si es un número finito)
            if (pimsRaw !== null && Number.isFinite(pimsRaw)) {
                totalPims += Number(pimsRaw);
            }

            // Suma de Validado (solo si es un número finito)
            if (valRaw !== null && Number.isFinite(valRaw)) {
                totalValidado += Number(valRaw);
            }
        });

        // Llama a la función para actualizar los div con los totales
        updateTotals(totalPims, totalValidado);
    }

    // ======================================================================
    // === FIN NUEVA FUNCIÓN DE CÁLCULO Y ACTUALIZACIÓN DE TOTALES =============
    // ======================================================================


    function renderTabla(rows){
      const data = Array.isArray(rows) ? rows : [];

      // *** 1. CÁLCULO DE TOTALES ANTES DE DEVOLVER UN MENSAJE DE ADVERTENCIA ***
      calculateAndRenderTotals(data);

      if(!data.length){ showMsg('No hay registros para los filtros aplicados','warning'); return; }

      contenedorListado.innerHTML = '';

      let tbody = '<tbody>';
      data.forEach(r=>{
        const pimsRaw = getPimsRaw(r);
        const valRaw  = (r.CantidadValidada !== undefined) ? r.CantidadValidada : null;

        const unidad = r.UnidadMedida || 'KWH';
        const pimsTxt = (pimsRaw === null || pimsRaw === undefined) ? '—' : `${fmtNumero(pimsRaw, 3)} ${unidad}`;
        const valTxt  = (valRaw  === null || valRaw  === undefined) ? '—' : `${fmtNumero(valRaw, 3)} ${unidad}`;

        const materialDesc = r.Material ?? r.MaterialDescripcion ?? r.MaterialConsumo ?? r.MaterialProduccion ?? '';
        const sapMovDesc = (r.TipoMovimientoSAP && String(r.TipoMovimientoSAP).trim())
                             || (r.TipoMovimientoSAPDescripcion && String(r.TipoMovimientoSAPDescripcion).trim())
                             || '';
        const sapMovShown = sapMovDesc || (r.TipoMovimientoSAPID ?? '');

        let fechaData = '';
        let fechaHoraDisplay = '—';

        if (r.FechaReporte){
          const m=/\/Date\((\d+)\)\//.exec(String(r.FechaReporte));
          const dt = m ? new Date(parseInt(m[1],10)) : new Date(r.FechaReporte);
          if(!Number.isNaN(dt?.getTime?.())){
            const yyyy=dt.getFullYear();
            const mm=String(dt.getMonth()+1).padStart(2,'0');
            const dd=String(dt.getDate()).padStart(2,'0');
            fechaData = `${yyyy}-${mm}-${dd}`;
            fechaHoraDisplay = fmtFechaHora(r.FechaReporte);
          }
        }

        const dataOpId = r.DataOperacionID ?? null;

        const equipoIdFila = r.EquipoID ?? null;

        tbody += `<tr>
          <td class="text-center" data-col="fecha" data-value="${escapeHtml(fechaData)}">${escapeHtml(fechaHoraDisplay)}</td>
          <td class="text-center" data-col="equipo" data-id="${equipoIdFila}">${escapeHtml(r.Equipo || '')}</td>
          <td class="text-center">${escapeHtml(materialDesc || '')}</td>
          <td class="text-end" data-col="pims" data-value="${pimsRaw ?? ''}">${pimsTxt}</td>
          <td class="text-end editable-validada" data-col="validada" data-id="${dataOpId}" data-value="${valRaw ?? ''}">${valTxt}</td>
          <td class="text-center" data-col="unidad">${escapeHtml(r.UnidadMedida || '')}</td>
          <td class="text-center">${escapeHtml(sapMovShown)}</td>
          <td class="text-center">${renderCloseStatus(!!r.StatusClose)}</td>
          <td class="text-center">${renderCheck(!!r.StatusValidate)}</td>
        </tr>`;
      });
      tbody += '</tbody>';

      contenedorListado.innerHTML = `
        <div class="table-responsive w-100" style="max-height:420px; overflow-y:auto; background-color:#fff; padding:10px; border-radius:10px;">
          <table class="table table-bordered table-sm table-striped mb-0" style="background-color:#fff;">
            ${buildTheadHtml()}${tbody}
          </table>
        </div>`;
    }

    function cargarCapturas(params){
      const { fechaISO, equipoId } = params;

      // Limpiar y resetear los totales mientras se carga
      showMsg('Cargando datos...', 'secondary');

      let url = `${URL_GET_ENERGY}?_fecha=${encodeURIComponent(fechaISO)}`;
      if(equipoId !== null && equipoId > 0){
          url += `&_equipoId=${encodeURIComponent(equipoId)}`;
      }

      fetch(url, { headers:{'Accept':'application/json'} })
        .then(r=>{
            if(!r.ok) {
                throw new Error('HTTP ' + r.status + (r.statusText ? ': ' + r.statusText : ''));
            }
            return r.json();
        })
        .then(arr=> renderTabla(arr))
        .catch(err=>{
            console.error(err);
            showMsg('No se pudo cargar la data de Energía (KWH). ' + err.message,'danger');
        });
    }


    function loadEquiposList() {
      if(!selectEquipoList) return;
      selectEquipoList.disabled = true;
      selectEquipoList.innerHTML = '<option value="">Cargando equipos...</option>';
      fetch(URL_EQUIPOS, { headers:{'Accept':'application/json'} })
        .then(r=>r.json())
        .then(data=>{
          if(data && data.success===false){
            fillSelect(selectEquipoList, [], '', '', '(sesion no iniciada)');
            return;
          }
          const list = Array.isArray(data) ? data : (Array.isArray(data?.data) ? data.data : []);
          fillSelect(selectEquipoList, list, 'EquipoID', 'Descripcion', 'Todos los equipos');
        })
        .catch(err=>{
          console.error('[Equipos List] ', err);
          fillSelect(selectEquipoList, [], '', '', '(error al cargar equipos)');
        })
        .finally(()=>{ selectEquipoList.disabled=false; });
    }

    window.filtrarPorFecha = function(){
      cargarCapturas(window.getCurrentParams());
    };

    // Listeners de filtro
    if(inputFecha){
      if(!inputFecha.value) inputFecha.value = defaultAyerISO();
      inputFecha.addEventListener('change', window.filtrarPorFecha);
    }
    if(selectEquipoList){
      selectEquipoList.addEventListener('change', window.filtrarPorFecha);
    }

    loadEquiposList();
    window.filtrarPorFecha();

    // ======================================================================
    // === LÓGICA DE EDICIÓN EN LÍNEA PARA CANTIDAD VALIDADA =================
    // ======================================================================

    const restoreCellContent = function(cell, val) {
        const unityEl = cell.closest('tr').querySelector('[data-col="unidad"]');
        const unity = unityEl ? unityEl.textContent.trim() : 'KWH';
        const txt = (val === null || val === undefined || val === '') ? '—' : `${fmtNumero(val, 3)} ${unity}`;
        cell.textContent = txt;
        cell.classList.remove('editing');
    };


    function saveValidatedQuantity(dataOpId, newQuantity, tdCell, originalValue) {
        const tr = tdCell.closest('tr');

        // ... (Tu lógica para obtener EquipoID y FechaReporteISO) ...
        const fechaReporteISO = tr.querySelector('[data-col="fecha"]').getAttribute('data-value');

        const equipoIdColumna = tr.querySelector('[data-col="equipo"]').getAttribute('data-id');
        const equipoID = Number(equipoIdColumna) > 0
                                 ? Number(equipoIdColumna)
                                 : (window.getCurrentParams().equipoId || null);

        if (!equipoID || equipoID <= 0 || !fechaReporteISO) {
            showMsg('Error: ID de Equipo o Fecha de Reporte de la fila no válidos para crear/actualizar.', 'danger');
            restoreCellContent(tdCell, originalValue);
            return;
        }

        const payload = {
            _dataOperacionId: dataOpId,
            _cantidadValidada: newQuantity,
            _equipoId: equipoID,
            _fechaReporte: fechaReporteISO
        };

        tdCell.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
        tdCell.style.minWidth = '100px';

        fetch(URL_SAVE_VALIDATED_QTY, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify(payload)
        })
        .then(r => {
            if (!r.ok) {
                return r.text().then(text => { throw new Error(`HTTP ${r.status}: ${r.statusText} - ${text.substring(0, 100)}...`); });
            }
            return r.json();
        })
        .then(result => {
            if (result && result.success === true) {

                let isCreation = !dataOpId;

                if (isCreation && result.id) {
                    tdCell.setAttribute('data-id', result.id);
                }

                tdCell.setAttribute('data-value', newQuantity ?? '');
                restoreCellContent(tdCell, newQuantity);

                // *** CAMBIO CLAVE: Llama a filtrarPorFecha (que recarga la tabla y recalcula totales) ***
                setTimeout(() => {
                    window.filtrarPorFecha();
                }, 500);

            } else {
                throw new Error(result?.message || 'Fallo de servidor al guardar.');
            }
        })
        .catch(err => {
            console.error('Error de guardado:', err);
            restoreCellContent(tdCell, originalValue);
            showMsg('Error al actualizar: ' + (err.message || 'Error de red.'), 'danger');
        })
        .finally(() => {
             tdCell.classList.remove('editing');
             tdCell.style.minWidth = '';
        });
    }

    /**
     * Inicia la edición en línea en la celda y maneja las validaciones.
     */
    function startInlineEdit(tdCell) {
        const dataOpId = Number(tdCell.getAttribute('data-id')) || null;
        const currentValue = tdCell.getAttribute('data-value') || '';

        if (tdCell.classList.contains('editing')) {
            return;
        }

        tdCell.classList.add('editing');
        tdCell.innerHTML = '';

        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'form-control form-control-sm text-end';
        // Mostrar el valor actual tal como está, sin forzar formato
        input.value = currentValue;
        input.min = '0';
        input.style.width = '100%';
        input.style.maxWidth = '150px';
        input.style.margin = '0 auto';
        input.setAttribute('placeholder', `Max ${fmtNumero(MAX_QUANTITY)}`); // Usar fmtNumero para el placeholder


        const cancelEdit = function () {
            if (tdCell.contains(input)) {
                restoreCellContent(tdCell, currentValue);
            }
            input.removeEventListener('blur', handleAction);
            input.removeEventListener('keyup', handleKeyup);
        };

        // *** FUNCIÓN CLAVE DE VALIDACIÓN Y GUARDADO MODIFICADA ***
        const handleAction = function () {
            if (!tdCell.contains(input)) return;

            let rawValue = input.value.trim();

            if (rawValue === '') {
                saveValidatedQuantity(dataOpId, null, tdCell, currentValue);
                return;
            }

            // 1. REEMPLAZAR COMA POR PUNTO
            // Permite el uso de coma (,) como separador decimal, luego lo convierte a punto (.)
            // Esto asume que el usuario no está usando ambos, lo cual es el estándar.
            // Si el valor contiene una coma, reemplazamos la última coma por un punto.
            // Para evitar problemas con el separador de miles.

            // Reemplaza el último separador decimal (punto o coma) si es el único o el último en la cadena.
            // Ejemplo: '100.000,50' -> '100000.50' (quita miles)
            // Ejemplo: '100,50' -> '100.50'
            // Ejemplo: '100.50' -> '100.50' (sin cambios si solo hay punto)

            // Normalizar: quitar separadores de miles (punto o coma, lo que no sea el decimal final)
            // Buscar el último separador decimal.
            const lastComma = rawValue.lastIndexOf(',');
            const lastDot = rawValue.lastIndexOf('.');

            let normalizedValue = rawValue;

            if (lastComma > lastDot) {
                // La coma es el separador decimal (ej: 1.000,50 o 100,50)
                // Removemos todos los puntos y luego cambiamos la coma final a punto.
                normalizedValue = normalizedValue.replace(/\./g, '');
                normalizedValue = normalizedValue.replace(',', '.');
            } else if (lastDot > lastComma && lastComma !== -1) {
                // El punto es el separador decimal y hay comas (ej: 1,000.50)
                // Removemos todas las comas.
                normalizedValue = normalizedValue.replace(/,/g, '');
            } else if (lastDot !== -1 && lastComma === -1) {
                // Solo hay puntos (ej: 1.000.50 - inválido, o 100.50)
                // Si hay más de un punto, es un formato de miles incorrecto o inválido.
                if ((normalizedValue.match(/\./g) || []).length > 1) {
                    // Tratar el último punto como decimal y quitar los demás (miles).
                    // Esto es una simplificación; un buen input debería usar `1000.50` o `1,000.50`.
                    // Pero si llega '1.000.50', lo tratamos como '1000.50'
                    const parts = normalizedValue.split('.');
                    if (parts.length > 2 && parts[parts.length - 1].length <= 3) {
                        normalizedValue = parts.slice(0, -1).join('') + '.' + parts[parts.length - 1];
                    }
                }
            } else if (lastComma !== -1 && lastDot === -1) {
                // Solo hay comas (ej: 1.000,50 - inválido, o 100,50)
                if ((normalizedValue.match(/,/g) || []).length > 1) {
                    // Tratar la última coma como decimal y quitar las demás (miles).
                    const parts = normalizedValue.split(',');
                    if (parts.length > 2 && parts[parts.length - 1].length <= 3) {
                        normalizedValue = parts.slice(0, -1).join('') + '.' + parts[parts.length - 1];
                    } else if (parts.length === 2) {
                        // Es solo el decimal: 100,50 -> 100.50
                        normalizedValue = normalizedValue.replace(',', '.');
                    }
                } else if ((normalizedValue.match(/,/g) || []).length === 1) {
                    // Es solo el decimal: 100,50 -> 100.50
                    normalizedValue = normalizedValue.replace(',', '.');
                }
            }

            // 2. VALIDACIÓN NUMÉRICA Y DE DECIMALES
            const newQuantity = Number(normalizedValue);

            if (!Number.isFinite(newQuantity) || newQuantity < 0) {
                showMsg('Error: El valor debe ser un número positivo válido. Puede usar punto o coma como separador decimal.', 'danger');
                cancelEdit();
                return;
            }

            // Validar más de 3 decimales
            const decimalPart = normalizedValue.split('.')[1];
            if (decimalPart && decimalPart.length > 3) {
                showMsg('Error de formato: No puede tener más de 3 dígitos después del separador decimal.', 'danger');
                cancelEdit();
                return;
            }

            // 3. VALIDACIÓN DE LÍMITE
            if (newQuantity > MAX_QUANTITY) {
                showMsg(`Error: La cantidad no puede ser mayor a ${fmtNumero(MAX_QUANTITY, 0)}.`, 'danger');
                cancelEdit();
                return;
            }

            // 4. PREPARAR VALOR FINAL
            // Siempre guardar con un máximo de 3 decimales para consistencia
            const finalQuantity = parseFloat(newQuantity.toFixed(3));

            // Comprobar si realmente cambió el valor
            if (String(finalQuantity) !== String(currentValue)) {
                saveValidatedQuantity(dataOpId, finalQuantity, tdCell, currentValue);
            } else {
                cancelEdit();
            }
        };
        // *** FIN FUNCIÓN CLAVE DE VALIDACIÓN Y GUARDADO MODIFICADA ***


        const handleKeyup = function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                input.blur(); // Usar blur para disparar handleAction
            } else if (e.key === 'Escape') {
                cancelEdit();
            }
        };

        tdCell.appendChild(input);

        input.addEventListener('blur', handleAction);
        input.addEventListener('keyup', handleKeyup);

        setTimeout(() => {
            input.focus();
            input.select();
        }, 0);
    }

    // Delegación de eventos
    contenedorListado.addEventListener('click', function(e) {
        const targetCell = e.target.closest('td.editable-validada');

        if (targetCell && !targetCell.classList.contains('editing')) {
            startInlineEdit(targetCell);
        }
    });

});
</script>


@*Cerrar Reporte*@

<script>
function cerrarReporte() {
    // 1. Obtener la fecha y el ID del equipo usando la función que ya existe
    // Esta función maneja si el valor es el ID específico o 0/null para 'Todos'
    const { fechaISO, equipoId } = window.getCurrentParams();

    const boton = document.getElementById('btnCerrarReporte');
    const alerta = document.getElementById("alertsuccesclose");

    // 2. Solo validar que la FECHA exista, permitiendo que equipoId sea 0 o null
    if (!fechaISO) {
        alert("Por favor selecciona una fecha.");
        return;
    }

    // Desactivar el botón para evitar múltiples clics
    boton.disabled = true;

    const url = '@Url.Action("CerrarReporteEnergia", "OperationDataToReport")';

    fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        // 3. Enviar el Body con las propiedades que espera el ViewModel de C#
        body: JSON.stringify({
            _fechaReporte: fechaISO,
            _equipoId: equipoId // Se envía 0 o null si es 'Todos', o el ID específico
        })
    })
    .then(response => {
        // Manejo de errores HTTP
        if (!response.ok) {
            return response.json().then(error => {
                throw new Error(error.message || `Error HTTP: ${response.status}`);
            }).catch(() => {
                throw new Error(`Error HTTP: ${response.status} ${response.statusText}`);
            });
        }
        return response.json();
    })
    .then(data => {
        if (data.success) {
            // Lógica de éxito: mostrar alerta, guardar bandera, y recargar
            alerta.style.display = "block";
            localStorage.setItem('mostrarFlecha', 'true');

            setTimeout(() => {
                alerta.style.display = "none";
                location.reload();
            }, 3000);
        } else {
            // Lógica de fallo del servidor
            alert(data.message || "No se pudo cerrar el reporte.");
            boton.disabled = false;
        }
    })
    .catch(error => {
        // Lógica de error de red o fetch
        console.error('Error:', error);
        alert("Ocurrió un error al intentar cerrar el reporte: " + error.message);
        boton.disabled = false;
    });
}

</script>



@*Fecha*@

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const inputFecha = document.getElementById("fechaReporte");

        // Obtener la fecha de ayer
        const hoy = new Date();
        hoy.setDate(hoy.getDate() - 1); // resta un día

        // Formatear a yyyy-mm-dd
        const año = hoy.getFullYear();
        const mes = String(hoy.getMonth() + 1).padStart(2, "0");
        const dia = String(hoy.getDate()).padStart(2, "0");
        const fechaFormateada = `${año}-${mes}-${dia}`;

        // Asignar la fecha al input
        inputFecha.value = fechaFormateada;

    });

    
</script>

@*Loading*@

<script>

    (function () {
        function showLoading() {
            var m = document.getElementById('loadingModal');
            if (m) m.style.display = 'block';
        }
        function hideLoading() {
            var m = document.getElementById('loadingModal');
            if (m) m.style.display = 'none';
        }
        // expone helpers por si quieres usarlos en otros fetch
        window.showLoading = showLoading;
        window.hideLoading = hideLoading;

        // muestra lo antes posible (cuando el DOM ya esta parseado)
        document.addEventListener('readystatechange', function () {
            if (document.readyState === 'interactive') showLoading();
        });

        // oculta cuando ya cargo todo (assets incluidos)
        window.addEventListener('load', function () {
            setTimeout(hideLoading, 200);
        });

        // muestra al navegar/recargar (cuando cambias de pagina)
        window.addEventListener('beforeunload', function () {
            showLoading();
        });
    })();

</script>



<script>

    function cargando() {
        document.getElementById("loadingModal").style.display = "block";
    };

    //________________________________________________________________________ Llamar el script de python para descargar _____________________________________//

    document.addEventListener("DOMContentLoaded", function () {
        const btn = document.getElementById("btnDescargarEnergy");
        const fechaInput = document.getElementById("fechaReporte");
        const alertaOk = document.getElementById("alertsuccesclose");

        btn.addEventListener("click", async function () {
            // Tomar fecha o usar hoy
            let fecha = fechaInput?.value;
            if (!fecha) {
                const hoy = new Date();
                const yyyy = hoy.getFullYear();
                const mm = String(hoy.getMonth() + 1).padStart(2, '0');
                const dd = String(hoy.getDate()).padStart(2, '0');
                fecha = `${yyyy}-${mm}-${dd}`;
            }

            const url = `/OperationDataToReport/EjecutarScriptKWH?fecha=${encodeURIComponent(fecha)}`;

            // Mostrar cargando
            cargando();
            btn.disabled = true;

            try {
                const resp = await fetch(url, {
                    method: "GET",
                    headers: { "Accept": "application/json" }
                });
                if (!resp.ok) throw new Error(`Status ${resp.status}`);

                const data = await resp.json();
                if (!data?.success) throw new Error(data?.error || "Fallo al ejecutar el script.");

                // ÉXITO: mostrar alerta y recargar
                alertaOk.style.display = "block";
                setTimeout(() => {
                    location.reload();
                }, 1200);
            } catch (err) {
                console.error(err);
                alert("Ocurrió un error al ejecutar el script. Revisa la consola.");
            } finally {
                // Ocultar cargando en el mismo bloque
                document.getElementById("loadingModal").style.display = "none";
                btn.disabled = false;
            }
        });
    });
</script>


