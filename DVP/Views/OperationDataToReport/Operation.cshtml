@*List*@

<script>
document.addEventListener('DOMContentLoaded', function () {
    'use strict';

    const MAX_QUANTITY = 100000;

    // Referencias a los elementos del DOM
    const contenedorListado = document.getElementById('contenedorListado');
    const inputFecha        = document.getElementById('fechaReporte');
    const selectEquipoList  = document.getElementById('selectEquipoList');
    // ❌ ELIMINAMOS la referencia a selectTipoOperacion
    // const selectTipoOperacion = document.getElementById('selectTipoOperacion');
    const totalKwhPimsEl = document.getElementById('countkwhpims');
    const totalKwhValidadoEl = document.getElementById('countkwhvalidado');

    // URLS DE ACCIÓN:
    const URL_GET_OPERATION = '@Url.Action("GetOperation", "OperationDataToReport")';
    const URL_EQUIPOS       = '@Url.Action("GetEquiposporPaislogguedUser", "Equipo")';
    const URL_SAVE_VALIDATED_QTY = '@Url.Action("UpdateEnergy", "OperationDataToReport")';
    const URL_SAVE_SAP_ORDER = '@Url.Action("UpdateSapOrder", "OperationDataToReport")';

    // ------------------------------------------
    // === FUNCIÓN DE FORMATO DE FECHA: YYYY-MM-DD HH:MI ===
    // (Sin cambios)
    // ------------------------------------------
    function fmtFechaHora(d){
      if(!d) return '';
      const m=/\/Date\((\d+)\)\//.exec(String(d));
      let dt=null;

      if(m){
          const ms=parseInt(m[1],10);
          if(!Number.isNaN(ms)) dt=new Date(ms);
      }
      else dt=new Date(d);

      if(!dt || Number.isNaN(dt.getTime())) return '';

      const yyyy=dt.getFullYear();
      const mm=String(dt.getMonth()+1).padStart(2,'0');
      const dd=String(dt.getDate()).padStart(2,'0');
      const hh=String(dt.getHours()).padStart(2,'0');
      const mi=String(dt.getMinutes()).padStart(2,'0');

      return `${yyyy}-${mm}-${dd} ${hh}:${mi}`;
    }
    // ------------------------------------------

    // --- Funciones de Utilidad ---
    function option(el, value, text){ const o=document.createElement('option'); o.value=value; o.textContent=text; el.appendChild(o); }
    function fillSelect(selectEl, list, valueKey, textKey, placeholder){
      if(!selectEl) return;
      selectEl.innerHTML=''; option(selectEl,'',placeholder);
      (list||[]).forEach(x=>{
        const v=x?.[valueKey], t=x?.[textKey];
        if(v!==undefined && t!==undefined) option(selectEl,String(v),String(t));
      });
    }
    function escapeHtml(str){ return String(str).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m])); }
    function showMsg(msg,type='info'){
      if (!msg || msg.includes('Cargando datos') || type === 'secondary' || type === 'success') {
          contenedorListado.innerHTML = '';
          updateTotals(0, 0);
          return;
      }
      if (type === 'danger' || type === 'warning') {
          contenedorListado.innerHTML = `<div class="alert alert-${type}" role="alert" style="margin-top:8px;">${escapeHtml(msg)}</div>`;
      }
      if (type === 'danger') {
          setTimeout(() => { window.location.reload(); }, 2000);
      }
    }
    function renderCheck(v){ return v ? '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-x-circle-fill text-danger"></i>'; }
    function renderCloseStatus(v){ return v ? '<i class="bi bi-lock-fill text-warning"></i>' : '<i class="bi bi-unlock-fill text-warning"></i>'; }
    function getPimsRaw(r){ return r.hasOwnProperty('CantidadPIMS') ? r.CantidadPIMS : (r.hasOwnProperty('CantidadPims') ? r.CantidadPims : null); }
    function defaultAyerISO(){
      const hoy = new Date();
      const ayer = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() - 1);
      return ayer.toISOString().split('T')[0];
    }
    function fmtNumero(val, decimals = 3) {
        if (val === null || val === undefined || val === '') return '';
        const num = Number(val);
        if (!Number.isFinite(num)) return '';
        return num.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: decimals, useGrouping: true });
    }
    function updateTotals(totalPims, totalValidado) {
        if (totalKwhPimsEl) totalKwhPimsEl.textContent = fmtNumero(totalPims, 3);
        if (totalKwhValidadoEl) totalKwhValidadoEl.textContent = fmtNumero(totalValidado, 3);
    }
    function calculateAndRenderTotals(rows) {
        let totalPims = 0;
        let totalValidado = 0;
        (Array.isArray(rows) ? rows : []).forEach(r => {
            const pimsRaw = getPimsRaw(r);
            const valRaw  = (r.CantidadValidada !== undefined && r.CantidadValidada !== null) ? Number(r.CantidadValidada) : null;
            if (pimsRaw !== null && Number.isFinite(pimsRaw)) totalPims += Number(pimsRaw);
            if (valRaw !== null && Number.isFinite(valRaw)) totalValidado += Number(valRaw);
        });
        updateTotals(totalPims, totalValidado);
    }
    // ------------------------------------------

    // --- FUNCIÓN DE PARÁMETROS (ACTUALIZADA) ---
    window.getCurrentParams = function(){
      const fechaISO  = (inputFecha && inputFecha.value) ? inputFecha.value : defaultAyerISO();
      const equipoId  = selectEquipoList && selectEquipoList.value ? Number(selectEquipoList.value) : null;
      // ❌ ELIMINAMOS tipoOperacionId
      // const tipoOperacionId = selectTipoOperacion && selectTipoOperacion.value ? Number(selectTipoOperacion.value) : null;

      return { fechaISO, equipoId }; // Retorna solo fechaISO y equipoId
    };
    // -----------------------------

    // --- ENCABEZADO DE TABLA (ACTUALIZADO A MATERIAL) ---
    function buildTheadHtml(){
      return `<thead><tr>
        <th class="text-center">Fecha/Hora</th><th class="text-center">Equipo</th>
        <th class="text-center">Material Consumido</th><th class="text-center">Tipo Mov. SAP</th>
        <th class="text-center">Cant PIMS</th><th class="text-center">Cant Validada</th>
        <th class="text-center">Unidad</th><th class="text-center">Tipo Mov SAP ID</th>
        <th class="text-center">Orden Proceso SAP</th> <th class="text-center">Close</th><th class="text-center">Validate</th>
      </tr></thead>`;
    }

    // ------------------------------------------
    // === FUNCIÓN RENDER CON AGRUPACIÓN VISUAL (AJUSTADA PARA MATERIAL) ===
    // ------------------------------------------
    function renderTabla(rows){
      const data = Array.isArray(rows) ? rows : [];
      calculateAndRenderTotals(data);

      if(!data.length){ showMsg('No hay registros para los filtros aplicados','warning'); return; }

      contenedorListado.innerHTML = '';

      let tbody = '<tbody>';

      let previousFechaHora = null;
      let previousEquipo = null;

      data.forEach(r=>{
        const pimsRaw = getPimsRaw(r);
        const isEditable = !!r.DataOperacionID;
        const valRaw  = r.DataOperacionID !== null ? (r.CantidadValidada !== undefined ? r.CantidadValidada : null) : null;

        const pimsToDisplay = (r.DataOperacionID === null && (pimsRaw === 0 || pimsRaw === null)) ? null : pimsRaw;

        const pimsTxt = (pimsToDisplay === null || pimsToDisplay === undefined) ? '—' : fmtNumero(pimsToDisplay, 3);
        const valTxt  = (valRaw  === null || valRaw  === undefined) ? '—' : fmtNumero(valRaw, 3);

        // El campo 'Material' del backend ahora es la descripción del material de BillOfMaterial
        const materialDesc = r.Material ?? '—';

        // El campo 'TipoMovimientoSAP' del backend ahora ocupa la columna que antes era TipoOperacion
        const sapMovShown = r.TipoMovimientoSAP || (r.TipoMovimientoSAPID ?? '—');
        // Usamos el TipoMovimientoSAPID para la columna que estaba cerca de Unidad, si es necesario, si no, se puede dejar MaterialConsumidoDescripcion como un campo de material extra.
        const sapMovIdShown = r.TipoMovimientoSAPID ?? '—';


        const ordenSap = r.OrdenProcesoSAP ?? '';

        let fechaData = '';
        let fechaHoraDisplay = '—';

        if (r.FechaReporte){
          fechaHoraDisplay = fmtFechaHora(r.FechaReporte);
          fechaData = fechaHoraDisplay.split(' ')[0];
        }

        const dataOpId = r.DataOperacionID ?? null;
        const equipoIdFila = r.EquipoID ?? null;
        const equipoNombre = r.Equipo || '';

        // Clases de editabilidad
        const editableValidadaClass = isEditable ? 'editable-validada' : '';
        const editableSapClass = isEditable ? 'editable-sap' : '';

        const dataValue = valRaw ?? '';

        // *** LÓGICA DE AGRUPACIÓN ***
        let fechaCellContent = escapeHtml(fechaHoraDisplay);
        let equipoCellContent = escapeHtml(equipoNombre);

        if (previousFechaHora === fechaHoraDisplay) {
            fechaCellContent = '';
        } else {
            previousFechaHora = fechaHoraDisplay;
        }

        if (fechaCellContent === '' && previousEquipo === equipoNombre) {
              equipoCellContent = '';
        } else {
            previousEquipo = equipoNombre;
            if(fechaCellContent !== '') equipoCellContent = escapeHtml(equipoNombre);
        }
        // *******************************************************


        tbody += `<tr>
          <td class="text-center" data-col="fecha" data-value="${escapeHtml(fechaData)}">${fechaCellContent}</td>
          <td class="text-center" data-col="equipo" data-id="${equipoIdFila}">${equipoCellContent}</td>
          <td class="text-center">${escapeHtml(materialDesc)}</td> <td class="text-center">${escapeHtml(sapMovShown)}</td> <td class="text-end" data-col="pims" data-value="${pimsToDisplay ?? ''}">${pimsTxt}</td>
          <td class="text-end ${editableValidadaClass}" data-col="validada" data-id="${dataOpId}" data-value="${dataValue}">${valTxt}</td>
          <td class="text-center" data-col="unidad">${escapeHtml(r.UnidadMedida || 'N/A')}</td>
          <td class="text-center">${escapeHtml(sapMovIdShown)}</td> <td class="text-center ${editableSapClass}" data-col="orden-sap" data-id="${dataOpId}" data-value="${escapeHtml(ordenSap)}">${escapeHtml(ordenSap || '—')}</td>
          <td class="text-center">${renderCloseStatus(!!r.StatusClose)}</td>
          <td class="text-center">${renderCheck(!!r.StatusValidate)}</td>
        </tr>`;
      });
      tbody += '</tbody>';

      contenedorListado.innerHTML = `
        <div class="table-responsive w-100" style="max-height:420px; overflow-y:auto; background-color:#fff; padding:10px; border-radius:10px;">
          <table class="table table-bordered table-sm table-striped mb-0" style="background-color:#fff;">
            ${buildTheadHtml()}${tbody}
          </table>
        </div>`;
    }
    // ------------------------------------------

    // --- Lógica de Edición en Línea ---
    // (Esta lógica se mantiene, ya que se basa en data-id/data-col, que siguen existiendo)
    const restoreCellContent = function(cell, val, type = 'number') {
        cell.classList.remove('editing');
        if (type === 'number') {
            const txt = (val === null || val === undefined || val === '') ? '—' : fmtNumero(val, 3);
            cell.textContent = txt;
        } else if (type === 'text') {
            cell.textContent = val || '—';
        }
    };

    function startInlineEdit(tdCell) {
        const dataOpId = tdCell.dataset.id;
        const col = tdCell.dataset.col;
        const originalValue = tdCell.dataset.value;

        if (!dataOpId) return;

        tdCell.classList.add('editing');
        tdCell.textContent = '';

        const isQuantity = col === 'validada';
        const isSapOrder = col === 'orden-sap';
        const input = document.createElement('input');

        input.type = isQuantity ? 'number' : 'text';
        input.value = originalValue;
        input.classList.add('form-control', 'form-control-sm');

        if (isQuantity) {
            input.step = '0.001';
            input.min = '0';
            input.max = String(MAX_QUANTITY);
        }

        tdCell.appendChild(input);
        input.focus();

        const handleSave = () => {
            const newValue = input.value.trim();

            if (isQuantity) {
                const numericValue = Number(newValue) || 0.0;
                if (numericValue < 0 || numericValue > MAX_QUANTITY) {
                    restoreCellContent(tdCell, originalValue, 'number');
                    return;
                }
                saveValidatedQuantity(dataOpId, numericValue, tdCell);
            } else if (isSapOrder) {
                saveSapOrder(dataOpId, newValue, tdCell);
            }
        };

        const handleCancel = () => {
            restoreCellContent(tdCell, originalValue, isQuantity ? 'number' : 'text');
        };

        input.addEventListener('blur', handleSave);
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                input.removeEventListener('blur', handleSave);
                handleSave();
            } else if (e.key === 'Escape') {
                input.removeEventListener('blur', handleSave);
                handleCancel();
            }
        });
    }

    // --- FUNCIONES DE GUARDADO (Mantienen la simulación) ---
    function saveValidatedQuantity(dataOpId, newQuantity, tdCell) {
        // Lógica AJAX/FETCH para URL_SAVE_VALIDATED_QTY
        // ...
        tdCell.dataset.value = newQuantity;
        restoreCellContent(tdCell, newQuantity, 'number');
    }

    function saveSapOrder(dataOpId, newSapOrder, tdCell) {
        // Lógica AJAX/FETCH para URL_SAVE_SAP_ORDER
        // ...
        tdCell.dataset.value = newSapOrder;
        restoreCellContent(tdCell, newSapOrder, 'text');
    }
    // ------------------------------------------

    // --- FUNCIÓN FETCH PRINCIPAL (ACTUALIZADA) ---
    function cargarCapturas(params){
      const { fechaISO, equipoId } = params;

      showMsg('Cargando datos...', 'secondary');

      let url = `${URL_GET_OPERATION}?_fecha=${encodeURIComponent(fechaISO)}`;

      if(equipoId !== null && equipoId > 0){
          url += `&_equipoId=${encodeURIComponent(equipoId)}`;
      }
      // ❌ Ya no se incluye _tipoOperacionId en la URL

      fetch(url, { headers:{'Accept':'application/json'} })
        .then(r=>{
            if(!r.ok) {
                throw new Error('HTTP ' + r.status + (r.statusText ? ': ' + r.statusText : ''));
            }
            return r.json();
        })
        .then(arr=> renderTabla(arr))
        .catch(err=>{
            console.error(err);
            showMsg('No se pudo cargar la data de Operación. ' + err.message,'danger');
        });
    }
    // ---------------------------------

    function loadEquiposList() { /* ... Lógica de carga de selectEquipoList ... */ }

    window.filtrarPorFecha = function(){
      cargarCapturas(window.getCurrentParams());
    };

    // Listeners de filtro
    if(inputFecha){
      if(!inputFecha.value) inputFecha.value = defaultAyerISO();
      inputFecha.addEventListener('change', window.filtrarPorFecha);
    }
    if(selectEquipoList){
      selectEquipoList.addEventListener('change', window.filtrarPorFecha);
    }
    // ❌ ELIMINAMOS el listener para selectTipoOperacion
    /*
    if(selectTipoOperacion){
        selectTipoOperacion.addEventListener('change', window.filtrarPorFecha);
    }
    */

    // Inicialización
    loadEquiposList();
    window.filtrarPorFecha();

    // --- LISTENER GLOBAL PARA EDICIÓN EN LÍNEA ---
    contenedorListado.addEventListener('click', function(e) {
      const targetCell = e.target.closest('td.editable-validada, td.editable-sap');

      if (targetCell && !targetCell.classList.contains('editing')) {
          startInlineEdit(targetCell);
      }
    });

});
</script>


@*Cerrar Reporte*@

<script>
function cerrarReporte() {
    // 1. Obtener la fecha y el ID del equipo usando la función que ya existe
    // Esta función maneja si el valor es el ID específico o 0/null para 'Todos'
    const { fechaISO, equipoId } = window.getCurrentParams();

    const boton = document.getElementById('btnCerrarReporte');
    const alerta = document.getElementById("alertsuccesclose");

    // 2. Solo validar que la FECHA exista, permitiendo que equipoId sea 0 o null
    if (!fechaISO) {
        alert("Por favor selecciona una fecha.");
        return;
    }

    // Desactivar el botón para evitar múltiples clics
    boton.disabled = true;

    const url = '@Url.Action("CerrarReporteEnergia", "OperationDataToReport")';

    fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        // 3. Enviar el Body con las propiedades que espera el ViewModel de C#
        body: JSON.stringify({
            _fechaReporte: fechaISO,
            _equipoId: equipoId // Se envía 0 o null si es 'Todos', o el ID específico
        })
    })
    .then(response => {
        // Manejo de errores HTTP
        if (!response.ok) {
            return response.json().then(error => {
                throw new Error(error.message || `Error HTTP: ${response.status}`);
            }).catch(() => {
                throw new Error(`Error HTTP: ${response.status} ${response.statusText}`);
            });
        }
        return response.json();
    })
    .then(data => {
        if (data.success) {
            // Lógica de éxito: mostrar alerta, guardar bandera, y recargar
            alerta.style.display = "block";
            localStorage.setItem('mostrarFlecha', 'true');

            setTimeout(() => {
                alerta.style.display = "none";
                location.reload();
            }, 3000);
        } else {
            // Lógica de fallo del servidor
            alert(data.message || "No se pudo cerrar el reporte.");
            boton.disabled = false;
        }
    })
    .catch(error => {
        // Lógica de error de red o fetch
        console.error('Error:', error);
        alert("Ocurrió un error al intentar cerrar el reporte: " + error.message);
        boton.disabled = false;
    });
}

</script>



@*Fecha*@

<script>
        document.addEventListener("DOMContentLoaded", function () {
            const inputFecha = document.getElementById("fechaReporte");

            // Obtener la fecha de ayer
            const hoy = new Date();
            hoy.setDate(hoy.getDate() - 1); // resta un día

            // Formatear a yyyy-mm-dd
            const año = hoy.getFullYear();
            const mes = String(hoy.getMonth() + 1).padStart(2, "0");
            const dia = String(hoy.getDate()).padStart(2, "0");
            const fechaFormateada = `${año}-${mes}-${dia}`;

            // Asignar la fecha al input
            inputFecha.value = fechaFormateada;

            // Ejecutar fetch automáticamente al cargar con la fecha de ayer
            filtrarPorFecha();
        });

        function filtrarPorFecha() {
            const fecha = document.getElementById("fechaReporte").value;

            fetch(`/TuControlador/GetCapturasHumedad?fecha=${encodeURIComponent(fecha)}`)
                .then(response => {
                    if (!response.ok) throw new Error("Error al obtener datos");
                    return response.json();
                })
                .then(data => {
                    console.log("Datos recibidos:", data);
                    // aquí puedes llenar tu tabla o contenedor con los datos
                })
                .catch(error => {
                    console.error("Error en la solicitud:", error);
                });
        }
</script>

@*Loading*@

<script>

        (function () {
            function showLoading() {
                var m = document.getElementById('loadingModal');
                if (m) m.style.display = 'block';
            }
            function hideLoading() {
                var m = document.getElementById('loadingModal');
                if (m) m.style.display = 'none';
            }
            // expone helpers por si quieres usarlos en otros fetch
            window.showLoading = showLoading;
            window.hideLoading = hideLoading;

            // muestra lo antes posible (cuando el DOM ya esta parseado)
            document.addEventListener('readystatechange', function () {
                if (document.readyState === 'interactive') showLoading();
            });

            // oculta cuando ya cargo todo (assets incluidos)
            window.addEventListener('load', function () {
                setTimeout(hideLoading, 200);
            });

            // muestra al navegar/recargar (cuando cambias de pagina)
            window.addEventListener('beforeunload', function () {
                showLoading();
            });
        })();

</script>






