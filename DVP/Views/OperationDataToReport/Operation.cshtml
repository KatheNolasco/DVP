@model DVP.Models.OperationDataToReportViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Downtime Page";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<style>
    /* Estilo para el contenedor de la fecha y hora */
    .container {
        font-family: Arial, sans-serif;
        display: flex; /* Usamos flex para alinearlos horizontalmente */
        justify-content: center; /* Centra los elementos horizontalmente */
        align-items: center; /* Centra los elementos verticalmente */
        gap: 20px; /* Espacio entre los divs */
        margin-top: 20px;
    }
    /* Estilo para los divs de fecha y hora */
    .input-container {
        font-size: 18px;
        display: flex;
        flex-direction: column; /* Los inputs se alinean de arriba hacia abajo */
        align-items: center;
    }

    input {
        padding: 10px;
        font-size: 16px;
        margin-top: 10px;
        border: 2px solid #ccc;
        border-radius: 8px;
        background-color: #f0f0f0;
    }

    .scrollable-table {
        max-height: 400px;
        overflow-y: auto;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa; /* color fondo header */
        z-index: 2;
        text-align: center;
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
        text-align: center;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 45px;
        height: 24px;
        margin-right: 8px;
        vertical-align: middle;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .switch .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 34px;
        }

            .switch .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 3px;
                bottom: 3px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

    .table-success-light {
        --bs-table-bg: #e6ffec; /* Un verde muy claro, casi blanco verdoso */
        --bs-table-accent-bg: var(--bs-table-bg);
    }


    .produccion-row td {
        color: #008f39 !important; /* verde oscuro para el texto */
        font-weight: 700 !important; /* negrita */
    }
</style>


<body>
    <div class="container-fluid" style="padding-left: 200px;">
        <div class="card">
            <div class="container-fluid">
                <div class="container-fluid">
                    <div class="card">
                        <div class="card-body">
                            <div id="alertsuccesclose" class="alert alert-success" role="alert" style="display: none;">
                                Agregado correctamente!
                            </div>
                            <!-- Fecha de validación -->
                            <br />
                            <h5 class="card-title fw-semibold mb-4">
                                <div class="d-flex flex-column align-items-end gap-2">
                                    <br />
                                    <select class="form-select" id="_plantaAsignada" style="width: auto; min-width: 200px;">
                                        <option value="">Seleccione una planta</option>
                                    </select>
                                    <div class="d-flex align-items-center gap-2">
                                        <button onclick="" id="btnDescargar" class="btn btn-link p-0 m-0 align-baseline" title="Download energy">
                                            <i class="bi bi-arrow-down-circle-fill text-success ms-2"></i>
                                        </button>
                                        <span>Operation Validation Date:</span>
                                        <button onclick="cerrarReporte()" id="btnCerrarReporte" class="btn btn-link p-0 m-0 align-baseline" title="Close report">
                                            <i class="bi bi-unlock-fill text-warning ms-2"></i>
                                        </button>
                                        <input type="date" id="fechaReporte" onchange="">
                                        <a id="btnenergy" onclick="sendtoenergyvalidation()"
                                           class="btn btn-link p-0 m-0 align-baseline"
                                           style="display: none;" role="button">
                                            <i class="bi bi-arrow-right-circle-fill text-danger"></i>
                                        </a>
                                    </div>
                                </div>
                            </h5>
                        </div>
                        <div id="filtrosListado" class="row g-3 mb-2"></div>
                        <!-- ✅ MENÚ DE COLUMNAS -->
                        <div id="columnMenu" class="mb-2 p-2 border rounded bg-light">
                            <strong>Mostrar / Ocultar columnas:</strong><br>
                            <label><input type="checkbox" class="col-toggle" data-col="equipo" checked> Equipo</label>
                            <label><input type="checkbox" class="col-toggle" data-col="close" checked> Close</label>
                            <label><input type="checkbox" class="col-toggle" data-col="validate" checked> Validate</label>
                            <label><input type="checkbox" class="col-toggle" data-col="humedad" checked> Humedad</label>
                            <label><input type="checkbox" class="col-toggle" data-col="poder" checked> Poder Calorífico</label>
                            <label><input type="checkbox" class="col-toggle" data-col="consumo-calor" checked> Consumo Calorífico</label>
                            <label><input type="checkbox" class="col-toggle" data-col="material" checked> Material</label>
                            <label><input type="checkbox" class="col-toggle" data-col="pims" checked> Cant PIMS</label>
                            <label><input type="checkbox" class="col-toggle" data-col="validada" checked> Cant Validada</label>
                            <label><input type="checkbox" class="col-toggle" data-col="unidad" checked> Unidad</label>
                            <label><input type="checkbox" class="col-toggle" data-col="sap" checked> Tipo Mov. SAP</label>
                            <label><input type="checkbox" class="col-toggle" data-col="orden-sap" checked> Orden SAP</label>
                        </div>

                        <div id="contenedorListado" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*___________________________________________________________________Modal Cargando__________________________________________________*@
    <div id="loadingModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; background-color: rgba(0, 0, 0, 0.5);">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background-color: white; padding: 25px 35px; border-radius: 10px; box-shadow: 0 0 15px rgba(0,0,0,0.3); min-width: 250px;">
            <div style="display: flex; align-items: center; justify-content: center;">
                <img src="/Content/loading-green-loading.gif" alt="Cargando..." style="width: 40px; height: 40px; margin-right: 15px;" />
                <span style="color: black; font-size: 16px;">Cargando...</span>
            </div>
        </div>
    </div>

</body>



@*List*@

<script>
document.addEventListener('DOMContentLoaded', function () {
    'use strict';

    const MAX_QUANTITY = 100000;

    // Referencias a los elementos del DOM (SIN CAMBIOS)
    const contenedorListado = document.getElementById('contenedorListado');
    const inputFecha        = document.getElementById('fechaReporte');
    const selectEquipoList  = document.getElementById('selectEquipoList');

    // URLS DE ACCIÓN: (SIN CAMBIOS)
    const URL_GET_OPERATION = '@Url.Action("GetOperation", "OperationDataToReport")';
    const URL_EQUIPOS       = '@Url.Action("GetEquiposporPaislogguedUser", "Equipo")';
    const URL_SAVE_VALIDATED_QTY = '@Url.Action("UpdateEnergy", "OperationDataToReport")';
    const URL_SAVE_SAP_ORDER = '@Url.Action("UpdateSapOrder", "OperationDataToReport")';

    function fmtFechaHora(d){
        if(!d) return '';
        const m=/\/Date\((\d+)\)\//.exec(String(d));
        let dt=null;
        if(m){ const ms=parseInt(m[1],10); if(!Number.isNaN(ms)) dt=new Date(ms); }
        else dt=new Date(d);
        if(!dt || Number.isNaN(dt.getTime())) return '';
        const yyyy=dt.getFullYear();
        const mm=String(dt.getMonth()+1).padStart(2,'0');
        const dd=String(dt.getDate()).padStart(2,'0');
        const hh=String(dt.getHours()).padStart(2,'0');
        const mi=String(dt.getMinutes()).padStart(2,'0');
        return `${yyyy}-${mm}-${dd} ${hh}:${mi}`;
    }
    function option(el, value, text){ const o=document.createElement('option'); o.value=value; o.textContent=text; el.appendChild(o); }
    function fillSelect(selectEl, list, valueKey, textKey, placeholder){
      if(!selectEl) return;
      selectEl.innerHTML=''; option(selectEl,'',placeholder);
      (list||[]).forEach(x=>{
        const v=x?.[valueKey], t=x?.[textKey];
        if(v!==undefined && t!==undefined) option(selectEl,String(v),String(t));
      });
    }
    function escapeHtml(str){
        return String(str).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }
    function showMsg(msg,type='info'){
        if (!msg || msg.includes('Cargando datos') || type === 'secondary' || type === 'success') {
            contenedorListado.innerHTML = '';
            return;
        }
        if (type === 'danger' || type === 'warning') {
            contenedorListado.innerHTML = `<div class="alert alert-${type}" role="alert" style="margin-top:8px;">${escapeHtml(msg)}</div>`;
        }
        if (type === 'danger') {
            setTimeout(() => { window.location.reload(); }, 2000);
        }
    }
    function renderCheck(v){ return v ? '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-x-circle-fill text-danger"></i>'; }
    function renderCloseStatus(v){ return v ? '<i class="bi bi-lock-fill text-warning"></i>' : '<i class="bi bi-unlock-fill text-warning"></i>'; }
    function getPimsRaw(r){ return r.hasOwnProperty('CantidadPIMS') ? r.CantidadPIMS : (r.hasOwnProperty('CantidadPims') ? r.CantidadPims : null); }
    function defaultAyerISO(){
      const hoy = new Date();
      const ayer = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() - 1);
      return ayer.toISOString().split('T')[0];
    }
    function fmtNumero(val, decimals = 3) {
        if (val === null || val === undefined || val === '') return '';
        const num = Number(val);
        if (!Number.isFinite(num)) return '';
        return num.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: decimals, useGrouping: true });
    }

    // --- FUNCIÓN DE AGRUPACIÓN CLAVE (SIN CAMBIOS FUNCIONALES) ---
    function groupDataByEquipo(rows) {
        if (!Array.isArray(rows) || rows.length === 0) return [];
        const groups = new Map();
        const finalRows = [];

        rows.forEach(r => {
            const key = `${r.EquipoID}`;
            if (!groups.has(key)) {
                groups.set(key, {
                    EquipoID: r.EquipoID,
                    Equipo: r.Equipo,
                    Detalles: [r]
                });
            } else {
                groups.get(key).Detalles.push(r);
            }
        });

        const orderedGroups = Array.from(groups.values())
            .sort((a, b) => a.EquipoID - b.EquipoID);

        orderedGroups.forEach(group => {
            const detalles = group.Detalles;
            const produccion = detalles
                .filter(r => r.TipoMaterial === "PRODUCCION")
                .sort((a, b) => a.Material.localeCompare(b.Material));
            const consumo = detalles
                .filter(r => r.TipoMaterial === "CONSUMO")
                .sort((a, b) => {
                    const order = {
                        "MATERIAL": 1,
                        "COMBUSTIBLE": 2,
                        "KWH": 3,
                        "HORAS": 4,
                        "SACOS": 5
                    };

                    const aOrder = order[a.Clasificacion?.toUpperCase()] ?? 99;
                    const bOrder = order[b.Clasificacion?.toUpperCase()] ?? 99;

                    if (aOrder !== bOrder) return aOrder - bOrder;
                    return a.Material.localeCompare(b.Material);
                });
            const consumoEquipo = detalles
                .filter(r => r.TipoMaterial === "CONSUMO_EQUIPO")
                .sort((a, b) => a.Material.localeCompare(b.Material));
            const orderedDetails = [];

            produccion.forEach(prodItem => {
                orderedDetails.push(prodItem);
                const relatedConsumo = consumo
                    .filter(c => c.MaterialProduccionPadreID === prodItem.MaterialID)
                    .sort((a, b) => {
                        const order = {
                            "MATERIAL": 1,
                            "COMBUSTIBLE": 2,
                            "KWH": 3,
                            "HORAS": 4,
                            "OTROS": 5
                        };
                        const aOrder = order[a.Clasificacion?.toUpperCase()] ?? 99;
                        const bOrder = order[b.Clasificacion?.toUpperCase()] ?? 99;

                        if (aOrder !== bOrder) return aOrder - bOrder;
                        return a.Material.localeCompare(b.Material);
                    });
                orderedDetails.push(...relatedConsumo);
            });

            consumoEquipo.forEach(item => {
                orderedDetails.push({ ...item, TipoMaterial: "CONSUMO_EQUIPO" });
            });

            const rowCount = orderedDetails.length;
            orderedDetails.forEach((detail, index) => {
                finalRows.push({
                    ...detail,
                    RowCount: rowCount,
                    IsFirstRow: index === 0
                });
            });
        });

        return finalRows;
    }

    const getCurrentParams = function(){
      const fechaISO  = (inputFecha && inputFecha.value) ? inputFecha.value : defaultAyerISO();
      const equipoId  = selectEquipoList && selectEquipoList.value ? Number(selectEquipoList.value) : null;
      return { fechaISO, equipoId };
    };
    function buildTheadHtml() {
        return `<thead><tr>
        <th class="text-center" data-col="equipo">Equipo</th>
        <th class="text-center" data-col="close">Close</th>
        <th class="text-center" data-col="validate">Validate</th>
        <th class="text-center" data-col="humedad">Humedad (%)</th>
        <th class="text-center" data-col="poder">Poder Calorífico (KJ/KG)</th>
        <th class="text-center" data-col="consumo-calor">Consumo Calorífico</th> <!-- NUEVA -->
        <th class="text-center" data-col="material">Material Consumido</th>
        <th class="text-center" data-col="pims">Cant PIMS</th>
        <th class="text-center" data-col="validada">Cant Validada</th>
        <th class="text-center" data-col="unidad">Unidad</th>
        <th class="text-center" data-col="sap">Tipo Mov. SAP</th>
        <th class="text-center" data-col="orden-sap">Orden Proceso SAP</th>
    </tr></thead>`;
    }



    /** ✅ AQUI ESTA LA MODIFICACIÓN */
    function renderTabla(rows) {
        const data = Array.isArray(rows) ? rows : [];

        if (!data.length) { showMsg('No hay registros para los filtros aplicados', 'warning'); return; }

        contenedorListado.innerHTML = '';
        let tbody = '<tbody>';
        let currentEquipoID = null;
        const colorClasses = ['table-success', 'table-success-light'];
        let alternateColorIndex = 0;

        data.forEach(r => {
            let pimsRaw = getPimsRaw(r);
            const isEditable = !!r.DataOperacionID;
            const valRaw = r.DataOperacionID !== null ? (r.CantidadValidada ?? null) : null;

            // ✅ Si la unidad es de tipo KJ (igual que poder calorífico), mostrar 0 en Cant PIMS
            let pimsTxt;
            if (r.UnidadMedida && r.UnidadMedida.toUpperCase().includes('KJ')) {
                pimsTxt = '0';
            } else {
                pimsTxt = (pimsRaw === null || pimsRaw === undefined) ? '—' : fmtNumero(pimsRaw, 3);
            }

            // === CANT VALIDADA → MISMA LÓGICA DE VISUALIZACIÓN QUE CANT PIMS ===
            let valTxt;

            if (r.UnidadMedida && r.UnidadMedida.toUpperCase().includes('KJ')) {
                // Poder calorífico → se visualiza como 0 (aunque valRaw tenga otro valor)
                valTxt = '0';
            }
            else if (valRaw === null || valRaw === undefined) {
                valTxt = '—';
            }
            else {
                // Mostrar exactamente el valor de BD pero con el mismo formateo
                valTxt = fmtNumero(valRaw, 3);
            }

            const humedadTxt = fmtNumero(r.Humedad ?? 0, 2);
            const poderTxt = fmtNumero(r.PoderCalorifico ?? 0, 2);
            const materialDesc = r.Material ?? '—';
            const sapMovShown = r.TipoMovimientoSAP || (r.TipoMovimientoSAPID ?? '—');
            const ordenSap = r.OrdenProcesoSAP ?? '';
            const dataOpId = r.DataOperacionID ?? null;
            const editableValidadaClass = isEditable ? 'editable-validada' : '';
            const editableSapClass = isEditable ? 'editable-sap' : '';

            if (r.EquipoID !== currentEquipoID) {
                alternateColorIndex = (alternateColorIndex + 1) % colorClasses.length;
                currentEquipoID = r.EquipoID;
            }

            const equipoColorClass = colorClasses[alternateColorIndex];
            let rowClass = '';
            let materialDisplay = escapeHtml(materialDesc);

            if (r.TipoMaterial === "PRODUCCION") {
                rowClass = 'produccion-row';
                materialDisplay = `<span style="font-weight:bold;">${materialDisplay}</span>`;
            } else if (r.TipoMaterial === "CONSUMO") {
                materialDisplay = `<span style="padding-left: 20px;">↳ ${materialDisplay}</span>`;
            } else if (r.TipoMaterial === "CONSUMO_EQUIPO") {
                materialDisplay = `<span style="font-weight:bold;">${materialDisplay}</span>`;
            }

            let rowHtml = `<tr class="${rowClass}">`;
            if (r.IsFirstRow) {
                rowHtml += `<td class="text-center ${equipoColorClass} font-weight-bold"
                        rowspan="${r.RowCount}">${escapeHtml(r.Equipo || '—')}</td>`;
            }

            rowHtml += `
        <td class="text-center" data-col="close">${renderCloseStatus(!!r.StatusClose)}</td>
        <td class="text-center" data-col="validate">${renderCheck(!!r.StatusValidate)}</td>
        <td class="text-end" data-col="humedad">${humedadTxt}%</td>
        <td class="text-end" data-col="poder">${poderTxt}</td>
        <td class="text-end" data-col="consumo-calor">${fmtNumero(r.ConsumoCalorifico ?? 0, 2)}</td>
        <td class="text-start" data-col="material">${materialDisplay}</td>
        <td class="text-end" data-col="pims">${pimsTxt}</td>
        <td class="text-end ${editableValidadaClass}" data-col="validada"
            data-col="validada" data-id="${dataOpId}"
            data-value="${valRaw ?? ''}">${valTxt}</td>
        <td class="text-center" data-col="unidad">${escapeHtml(r.UnidadMedida || 'N/A')}</td>
        <td class="text-center" data-col="sap">${escapeHtml(sapMovShown)}</td>
        <td class="text-center ${editableSapClass}" data-col="orden-sap"
            data-col="orden-sap" data-id="${dataOpId}"
            data-value="${escapeHtml(ordenSap)}">${escapeHtml(ordenSap || '—')}</td>
    </tr>`;

            tbody += rowHtml;
        });

        tbody += '</tbody>';
        contenedorListado.innerHTML = `
<div class="table-responsive w-100" style="max-height:560px; overflow-y:auto; background-color:#fff; padding:10px; border-radius:10px;">
  <table class="table table-bordered table-sm table-striped mb-0" style="background-color:#fff;">
    ${buildTheadHtml()}${tbody}
  </table>
</div>`;
    }


    // === FUNCIONALIDAD PARA MOSTRAR / OCULTAR COLUMNAS ===
    function initColumnVisibilityMenu() {
        const checkboxes = document.querySelectorAll('.col-toggle');
        checkboxes.forEach(chk => {
            chk.addEventListener('change', () => {
                const colName = chk.dataset.col;
                const visible = chk.checked;
                toggleColumn(colName, visible);
            });
        });
    }

    // Oculta o muestra todas las celdas (th y td) con data-col="X"
    function toggleColumn(colName, visible) {
        const cells = document.querySelectorAll(`th[data-col="${colName}"], td[data-col="${colName}"]`);
        cells.forEach(cell => {
            cell.style.display = visible ? '' : 'none';
        });
    }


    // --- Funciones de edición, guardado, fetch e inicialización sin cambios ---
    const restoreCellContent = function(cell, val, type = 'number') {
        cell.classList.remove('editing');
        if (type === 'number') {
            const txt = (val === null || val === undefined || val === '') ? '—' : fmtNumero(val, 3);
            cell.textContent = txt;
        } else if (type === 'text') {
            cell.textContent = val || '—';
        }
    };
    function startInlineEdit(tdCell) {
        const dataOpId = tdCell.dataset.id;
        const col = tdCell.dataset.col;
        const originalValue = tdCell.dataset.value;
        if (!dataOpId) return;
        tdCell.classList.add('editing');
        tdCell.textContent = '';
        const isQuantity = col === 'validada';
        const isSapOrder = col === 'orden-sap';
        const input = document.createElement('input');
        input.type = isQuantity ? 'number' : 'text';
        input.value = originalValue;
        input.classList.add('form-control', 'form-control-sm');
        if (isQuantity) {
            input.step = '0.001';
            input.min = '0';
            input.max = String(MAX_QUANTITY);
        }
        tdCell.appendChild(input);
        input.focus();

        const handleSave = () => {
            const newValue = input.value.trim();
            if (isQuantity) {
                const numericValue = Number(newValue) || 0.0;
                if (numericValue < 0 || numericValue > MAX_QUANTITY) {
                    restoreCellContent(tdCell, originalValue, 'number');
                    return;
                }
                saveValidatedQuantity(dataOpId, numericValue, tdCell);
            } else if (isSapOrder) {
                saveSapOrder(dataOpId, newValue, tdCell);
            }
        };

        const handleCancel = () => {
            restoreCellContent(tdCell, originalValue, isQuantity ? 'number' : 'text');
        };
        input.addEventListener('blur', handleSave);
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                input.removeEventListener('blur', handleSave);
                handleSave();
            } else if (e.key === 'Escape') {
                input.removeEventListener('blur', handleSave);
                handleCancel();
            }
        });
    }

    function saveValidatedQuantity(dataOpId, newQuantity, tdCell) {
        if (window.showLoading) window.showLoading();
        fetch(URL_SAVE_VALIDATED_QTY, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ DataOperacionID: dataOpId, CantidadValidada: newQuantity })
        })
        .then(r => {
            if (!r.ok) throw new Error('Error al guardar la cantidad validada.');
            return r.json();
        })
        .then(response => {
            if (response.success) {
                filtrarPorFecha();
            } else {
                showMsg('Error al actualizar: ' + (response.message || 'Desconocido'), 'danger');
                restoreCellContent(tdCell, tdCell.dataset.value, 'number');
            }
        })
        .catch(err => {
            console.error(err);
            showMsg('Fallo en la comunicación con el servidor al guardar la cantidad. ' + err.message, 'danger');
            restoreCellContent(tdCell, tdCell.dataset.value, 'number');
        })
        .finally(() => {
            if (window.hideLoading) window.hideLoading();
        });
    }

    function saveSapOrder(dataOpId, newSapOrder, tdCell) {
        if (window.showLoading) window.showLoading();
        fetch(URL_SAVE_SAP_ORDER, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ DataOperacionID: dataOpId, OrdenProcesoSAP: newSapOrder })
        })
        .then(r => {
            if (!r.ok) throw new Error('Error al guardar la orden SAP.');
            return r.json();
        })
        .then(response => {
            if (response.success) {
                filtrarPorFecha();
            } else {
                showMsg('Error al actualizar: ' + (response.message || 'Desconocido'), 'danger');
                restoreCellContent(tdCell, tdCell.dataset.value, 'text');
            }
        })
        .catch(err => {
            console.error(err);
            showMsg('Fallo en la comunicación con el servidor al guardar la Orden SAP. ' + err.message, 'danger');
            restoreCellContent(tdCell, tdCell.dataset.value, 'text');
        })
        .finally(() => {
            if (window.hideLoading) window.hideLoading();
        });
    }

    function cargarCapturas(params){
      const { fechaISO, equipoId } = params;
      showMsg('Cargando datos...', 'secondary');
      if (window.showLoading) window.showLoading();
      let url = `${URL_GET_OPERATION}?_fecha=${encodeURIComponent(fechaISO)}`;
      if(equipoId !== null && equipoId > 0){
          url += `&_equipoId=${encodeURIComponent(equipoId)}`;
      }
      fetch(url, { headers:{'Accept':'application/json'} })
        .then(r=>{
            if(!r.ok) throw new Error('HTTP ' + r.status + (r.statusText ? ': ' + r.statusText : ''));
            return r.json();
        })
        .then(arr => {
            const groupedAndFlattenedData = groupDataByEquipo(arr);
            renderTabla(groupedAndFlattenedData);
        })
        .catch(err=>{
            console.error(err);
            showMsg('No se pudo cargar la data de Operación. ' + err.message,'danger');
        })
        .finally(() => {
            if (window.hideLoading) window.hideLoading();
        });
    }

    const filtrarPorFecha = function(){
      cargarCapturas(getCurrentParams());
    };
    function loadEquiposList() {
        fetch(URL_EQUIPOS, { headers:{'Accept':'application/json'} })
            .then(r => r.json())
            .then(list => {
                fillSelect(selectEquipoList, list, 'EquipoID', 'Descripcion', 'Todos los Equipos');
                filtrarPorFecha();
            })
            .catch(err => {
                 console.error("Error al cargar equipos:", err);
                 filtrarPorFecha();
            });
    }

    if(inputFecha){
      if(!inputFecha.value) inputFecha.value = defaultAyerISO();
      inputFecha.addEventListener('change', filtrarPorFecha);
    }
    if(selectEquipoList){
      selectEquipoList.addEventListener('change', filtrarPorFecha);
    }

    loadEquiposList();
    initColumnVisibilityMenu();

    contenedorListado.addEventListener('click', function(e) {
      const targetCell = e.target.closest('td.editable-validada, td.editable-sap');
      if (targetCell && !targetCell.classList.contains('editing')) {
          startInlineEdit(targetCell);
      }
    });

});
</script>




@*Cerrar Reporte*@

<script>
function cerrarReporte() {
    // 1. Obtener la fecha y el ID del equipo usando la función que ya existe
    // Esta función maneja si el valor es el ID específico o 0/null para 'Todos'
    const { fechaISO, equipoId } = window.getCurrentParams();

    const boton = document.getElementById('btnCerrarReporte');
    const alerta = document.getElementById("alertsuccesclose");

    // 2. Solo validar que la FECHA exista, permitiendo que equipoId sea 0 o null
    if (!fechaISO) {
        alert("Por favor selecciona una fecha.");
        return;
    }

    // Desactivar el botón para evitar múltiples clics
    boton.disabled = true;

    const url = '@Url.Action("CerrarReporteEnergia", "OperationDataToReport")';

    fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        // 3. Enviar el Body con las propiedades que espera el ViewModel de C#
        body: JSON.stringify({
            _fechaReporte: fechaISO,
            _equipoId: equipoId // Se envía 0 o null si es 'Todos', o el ID específico
        })
    })
    .then(response => {
        // Manejo de errores HTTP
        if (!response.ok) {
            return response.json().then(error => {
                throw new Error(error.message || `Error HTTP: ${response.status}`);
            }).catch(() => {
                throw new Error(`Error HTTP: ${response.status} ${response.statusText}`);
            });
        }
        return response.json();
    })
    .then(data => {
        if (data.success) {
            // Lógica de éxito: mostrar alerta, guardar bandera, y recargar
            alerta.style.display = "block";
            localStorage.setItem('mostrarFlecha', 'true');

            setTimeout(() => {
                alerta.style.display = "none";
                location.reload();
            }, 3000);
        } else {
            // Lógica de fallo del servidor
            alert(data.message || "No se pudo cerrar el reporte.");
            boton.disabled = false;
        }
    })
    .catch(error => {
        // Lógica de error de red o fetch
        console.error('Error:', error);
        alert("Ocurrió un error al intentar cerrar el reporte: " + error.message);
        boton.disabled = false;
    });
}

</script>



@*Fecha*@

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const inputFecha = document.getElementById("fechaReporte");

        // Obtener la fecha de ayer
        const hoy = new Date();
        hoy.setDate(hoy.getDate() - 1); // resta un día

        // Formatear a yyyy-mm-dd
        const año = hoy.getFullYear();
        const mes = String(hoy.getMonth() + 1).padStart(2, "0");
        const dia = String(hoy.getDate()).padStart(2, "0");
        const fechaFormateada = `${año}-${mes}-${dia}`;

        // Asignar la fecha al input
        inputFecha.value = fechaFormateada;

    });


</script>

@*Loading*@

<script>

    (function () {
        function showLoading() {
            var m = document.getElementById('loadingModal');
            if (m) m.style.display = 'block';
        }
        function hideLoading() {
            var m = document.getElementById('loadingModal');
            if (m) m.style.display = 'none';
        }
        // expone helpers por si quieres usarlos en otros fetch
        window.showLoading = showLoading;
        window.hideLoading = hideLoading;

        // muestra lo antes posible (cuando el DOM ya esta parseado)
        document.addEventListener('readystatechange', function () {
            if (document.readyState === 'interactive') showLoading();
        });

        // oculta cuando ya cargo todo (assets incluidos)
        window.addEventListener('load', function () {
            setTimeout(hideLoading, 200);
        });

        // muestra al navegar/recargar (cuando cambias de pagina)
        window.addEventListener('beforeunload', function () {
            showLoading();
        });
    })();

</script>


@*Descargar data operaciones *@

<script>
    function cargando() {
        document.getElementById("loadingModal").style.display = "block";
    }

    document.addEventListener("DOMContentLoaded", function () {
        const btn = document.getElementById("btnDescargar");
        const fechaInput = document.getElementById("fechaReporte");
        const alertaOk = document.getElementById("alertsuccesclose");

        btn.addEventListener("click", async function () {

            let fecha = fechaInput?.value;
            if (!fecha) {
                const hoy = new Date();
                fecha = `${hoy.getFullYear()}-${String(hoy.getMonth() + 1).padStart(2, '0')}-${String(hoy.getDate()).padStart(2, '0')}`;
            }

            const url = `/OperationDataToReport/EjecutarScriptProd?fecha=${encodeURIComponent(fecha)}`;

            cargando();
            btn.disabled = true; // se deshabilita y NO se vuelve a habilitar antes del reload

            try {
                const resp = await fetch(url, {
                    method: "GET",
                    headers: { "Accept": "application/json" }
                });

                const data = await resp.json();

                if (!resp.ok || !data?.success) {
                    throw new Error(data?.message || "Error al iniciar script.");
                }

                alertaOk.innerText = "Script iniciado y ejecutándose en el servidor...";
                alertaOk.style.display = "block";
                alertaOk.style.marginTop = "40px";

                // Cerrar modal después de 2.5s (botón sigue deshabilitado)
                setTimeout(() => {
                    document.getElementById("loadingModal").style.display = "none";
                }, 2500);

                // 🔄 Recargar página después de 5 minutos (300,000 ms)
                setTimeout(() => {
                    location.reload();
                }, 300000);

            } catch (err) {
                console.error(err);
                alert(err?.message || "Ocurrió un error.");
                document.getElementById("loadingModal").style.display = "none";
                btn.disabled = false; // en error sí se habilita de nuevo
            }
        });
    });
</script>







