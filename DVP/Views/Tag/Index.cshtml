
@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

@model DVP.Models.TagViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Downtime Page";

}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<style>
    /* Estilo para el contenedor de la fecha y hora */
    .container {
        font-family: Arial, sans-serif;
        display: flex; /* Usamos flex para alinearlos horizontalmente */
        justify-content: center; /* Centra los elementos horizontalmente */
        align-items: center; /* Centra los elementos verticalmente */
        gap: 20px; /* Espacio entre los divs */
        margin-top: 20px;
    }
    /* Estilo para los divs de fecha y hora */
    .input-container {
        font-size: 18px;
        display: flex;
        flex-direction: column; /* Los inputs se alinean de arriba hacia abajo */
        align-items: center;
    }

    input {
        padding: 10px;
        font-size: 16px;
        margin-top: 10px;
        border: 2px solid #ccc;
        border-radius: 8px;
        background-color: #f0f0f0;
    }

    .scrollable-table {
        max-height: 400px;
        overflow-y: auto;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa; /* color fondo header */
        z-index: 2;
        text-align: center;
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
        text-align: center;
    }

    .form-check-input:checked {
        background-color: #13DEB9 !important; /* bg-success */
        border-color: #13DEB9 !important;
    }

    /* Opcional: cambiar el texto también */
    .form-check-label {
        font-weight: 500;
    }
</style>

<body>
    <div class="container-fluid" style="padding-left: 200px;">
        <br />
        <br />
        <br />
        <div class="card">
            <div class="container-fluid">
                <div class="container-fluid">
                    <div class="card">
                        <div class="card-body">
                            <!-- Fecha de validación -->
                            <h5 class="card-title fw-semibold mb-4 text-end">
                            </h5>
                            <div id="alertsuccesnewequipment" class="alert alert-success" role="alert" style="display: none;">
                                Equipo agregado correctamente!
                            </div>
                            <!-- Equipos -->
                            <h5 class="card-title fw-semibold mb-4">Tags Configuration</h5>
                        </div>
                        <!-- Sección de Listas -->
                        <div class="card w-100">
                            <div class="card-body p-4">
                                <div class="text-end mb-3">
                                    <div class="d-flex justify-content-end align-items-center gap-2 mb-3">
                                        Total Tags: <strong id="countdata">0</strong>
                                        <i class="bi bi-binoculars-fill text-success"></i>
                                        <input type="text" class="form-control form-control-sm w-25" id="_buscar" placeholder="Buscar...">
                                        <button type="button" onclick="newEquipment()" class="btn btn-outline-dark btn-sm">
                                            Add new
                                        </button>
                                    </div>
                                    <div class="d-flex justify-content-end align-items-center gap-2 mb-3">
                                        <select id="selectFiltroEquipo" class="form-select" style="max-width: 420px;">
                                            <option value="">Equipment filter</option>
                                        </select>
                                        <select id="selectFiltroTipoOperacion" class="form-select" style="max-width: 420px;">
                                            <option value="">Operation type filter</option>
                                        </select>
                                        <select id="selectFiltroMaterialProducido" class="form-select" style="max-width: 420px;">
                                            <option value="">Material type filter</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="d-flex gap-3">
                                    <!-- Tabla más ancha (downtimes activos) -->
                                    <div class="table-responsive w-100" style="max-height: 400px; overflow-y: auto; background-color: #ffffff; padding: 10px; border-radius: 10px;">
                                        <table class="table table-bordered mb-0" style="background-color: #ffffff;">
                                            <thead style="position: sticky; top: 0; background-color: #ffffff; z-index: 2;">
                                                <tr>
                                                    <th class="text-center">Status</th>
                                                    <th class="text-center">Tag Code</th>
                                                    <th class="text-center">Name</th>
                                                    <th class="text-center">Operation Type</th>
                                                    <th class="text-center">Material Consumido</th>
                                                    <th class="text-center">Equpment</th>
                                                    <th class="text-center">Material Producido</th>
                                                    <th class="text-center">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="downtimeTableBody">
                                                <tr>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>



        @*___________________________________________________________________Modal Cargando__________________________________________________*@
        <div id="loadingModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; background-color: rgba(0, 0, 0, 0.5);">
            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background-color: white; padding: 25px 35px; border-radius: 10px; box-shadow: 0 0 15px rgba(0,0,0,0.3); min-width: 250px;">
                <div style="display: flex; align-items: center; justify-content: center;">
                    <img src="/Content/loading-green-loading.gif" alt="Cargando..." style="width: 40px; height: 40px; margin-right: 15px;" />
                    <span style="color: black; font-size: 16px;">Cargando...</span>
                </div>
            </div>
        </div>


        @*______________________________________________________________________Modal crear tag _________________________________________________________________________*@

        <div class="modal fade" id="newTag" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="card-body">
                            <div class="card">
                                <form>
                                    <div class="card-body">
                                        <h4 class="card-title fw-semibold mb-2">Add New Tag</h4>
                                        <br />
                                    </div>
                                    <div class="row">
                                        <!-- Columna izquierda -->
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label class="form-label">Descripción</label>
                                                <input type="text" class="form-control" id="_descripcion" required>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Tag Code</label>
                                                <input type="text" class="form-control" id="_tagCode" required>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Tag Name</label>
                                                <input type="text" class="form-control" id="_tagName" required>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Tipo de Operación</label>
                                                <select class="form-select" id="_tipoOperacionId">
                                                    <option value="">Seleccione un tipo de operación</option>
                                                </select>
                                            </div>
                                        </div>

                                        <!-- Columna derecha -->
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label class="form-label">Equipo</label>
                                                <select class="form-select" id="_equipoId">
                                                    <option value="">Seleccione un equipo</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Material Consumido</label>
                                                <select class="form-select" id="_materialId">
                                                    <option value="">Seleccione un material</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Material Producido</label>
                                                <select class="form-select" id="_materialProducidoId">
                                                    <option value="">Seleccione un material</option>
                                                </select>
                                            </div>
                                            <div class="form-check form-switch mb-3">
                                                <input class="form-check-input" type="checkbox" id="_activo">
                                                <label class="form-check-label" for="_activo">Activo</label>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Botón y alerta -->
                                    <div class="text-end mt-3">
                                        <button type="button" id="creartag" class="btn btn-outline-success m-1"
                                                data-url="@Url.Action("CreateTag", "Tag")">
                                            Crear <span class="text-success ms-2">&#10004;</span>
                                        </button>
                                    </div>
                                    <div id="alertSuccess" class="alert alert-success mt-3" role="alert" style="display: none;">
                                        ¡Creado exitosamente!
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @*_____________________________________________________________________________ Modal para Editar equipo ___________________________________________________________________*@


        <div class="modal fade" id="editTag" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalLabel">Downtime Validation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="card-body">
                            <div class="card">
                                <div class="card-body">
                                    <form>
                                        <div class="card-body">
                                            <h4 class="card-title fw-semibold mb-2">Edit Tag</h4>
                                            <br />
                                            <input type="hidden" id="tagIdhidden" value="" />
                                        </div>
                                        <div class="row">
                                            <!-- Columna izquierda -->
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label class="form-label">Descripción</label>
                                                    <input type="text" class="form-control" id="_descripcioneditar" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Tag Name</label>
                                                    <input type="text" class="form-control" id="_tagNameeditar" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Tag Code</label>
                                                    <input type="text" class="form-control" id="_tagCodeeditar" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Tipo de Operación</label>
                                                    <select class="form-select" id="_tipoOperacionIdeditar">
                                                        <option value="">Seleccione un tipo de operación</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <!-- Columna derecha -->
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label class="form-label">Equipo</label>
                                                    <select class="form-select" id="_equipoIdeditar">
                                                        <option value="">Seleccione un equipo</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Materiales Consumido</label>
                                                    <select class="form-select" id="_materialIdeditar">
                                                        <option value="">Seleccione un Material</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Material Producido</label>
                                                    <select class="form-select" id="_materialProducidoIdeditar">
                                                        <option value="">Seleccione un Material</option>
                                                    </select>
                                                </div>
                                                <div class="form-check form-switch mb-3">
                                                    <input class="form-check-input" type="checkbox" id="_activoeditar">
                                                    <label class="form-check-label" for="_activoeditar">Activo</label>
                                                </div>
                                            </div>
                                        </div>


                                        <!-- Botón y alerta -->
                                        <div class="text-end mt-3">
                                            <button type="button" id="editartag"
                                                    class="btn btn-outline-success m-1"
                                                    data-url="@Url.Action("EditTag", "Tag")"
                                                    onclick="submitEditEquipmentForm()">
                                                Editar <span class="text-success ms-2">&#10004;</span>
                                            </button>
                                        </div>
                                    </form>
                                    <div id="alertEditeSuccesseditar" class="alert alert-success" role="alert" style="display: none;">
                                        ¡Editado!
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</body>


@section scripts{
    <script src="~/Content/Modernize-1.0.0/src/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/js/sidebarmenu.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/js/app.min.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/libs/simplebar/dist/simplebar.js"></script>
}




<script>

    //________________________________________________________________________________________________New Tag___________________________________
    function cargando() {
        document.getElementById("loadingModal").style.display = "block";
    }

    function limpiarSelect(selectId, placeholder = "Seleccione una opción") {
        const select = document.getElementById(selectId);
        select.innerHTML = `<option value="">${placeholder}</option>`;
    }

    function llenarSelect(selectId, items, valueProp, textProp) {
        const select = document.getElementById(selectId);
        const data = items.data || items;
        if (!Array.isArray(data) || data.length === 0) return;

        data.forEach(item => {
            if (item[valueProp] != null) {
                const opt = document.createElement("option");
                opt.value = String(item[valueProp]);
                opt.textContent = item[textProp];
                select.appendChild(opt);
            }
        });
    }

    const getSafeId = (id) => {
        if (id == null || id === 0 || id === "0") return '';
        let idStr = String(id).trim();
        if (idStr.endsWith('.0')) {
            idStr = idStr.substring(0, idStr.length - 2);
        }
        return idStr;
    };

    function newEquipment() {
        const modalElement = document.getElementById("newTag");
        const modal = new bootstrap.Modal(modalElement);
        modal.show();
        cargarCombosEquipo();

        const selectEquipo = document.getElementById("_equipoId");
        selectEquipo.onchange = null;
        selectEquipo.onchange = function() {
            const equipoId = this.value;
            cargarMaterialesProducidosCreate(equipoId);
            cargarMaterialesConsumidosCreate(equipoId);
        };
    }

    function cargarCombosEquipo() {
        limpiarSelect("_tipoOperacionId", "Seleccione un tipo de operacion");
        limpiarSelect("_equipoId", "Seleccione un equipo");
        limpiarSelect("_materialId", "Seleccione un Equipo primero");
        limpiarSelect("_materialProducidoId", "Seleccione un Equipo primero");

        fetch('@Url.Action("GetEquiposporPlantalogguedUser", "Equipo")')
            .then(r => r.json())
            .then(data => llenarSelect("_equipoId", data, "EquipoID", "Descripcion"));

        fetch('@Url.Action("GetTipoOperacion", "Tag")')
            .then(r => r.json())
            .then(data => llenarSelect("_tipoOperacionId", data, "TipoOperacionID", "Descripcion"));
    }

    function cargarMaterialesConsumidosCreate(equipoId) {
        const selectId = '_materialId';
        const select = document.getElementById(selectId);
        if (!equipoId) {
            limpiarSelect(selectId, "Seleccione un Equipo primero");
            return;
        }
        select.innerHTML = '<option value="">Cargando materiales...</option>';
        const url = '@Url.Action("GetMaterialesConsumidosByEquipo", "Material")' + '?equipoId=' + equipoId;
        fetch(url)
            .then(res => res.json())
            .then(result => {
                const materialesConsumo = result.data || result;
                const placeholderText = Array.isArray(materialesConsumo) && materialesConsumo.length > 0 ? "Seleccione un material (opcional)" : "No hay materiales de consumo disponibles";
                limpiarSelect(selectId, placeholderText);
                llenarSelect(selectId, materialesConsumo, 'MaterialID', 'Descripcion');
            })
            .catch(error => {
                console.error("Error al cargar materiales consumidos:", error);
                select.innerHTML = '<option value="">Error al cargar materiales</option>';
            });
    }

    function cargarMaterialesProducidosCreate(equipoId) {
        const selectId = '_materialProducidoId';
        const select = document.getElementById(selectId);
        if (!equipoId) {
            limpiarSelect(selectId, "Seleccione un Equipo primero");
            return;
        }
        select.innerHTML = '<option value="">Cargando materiales...</option>';
        const url = '@Url.Action("GetMaterialesProducidosByEquipo", "Material")' + '?equipoId=' + equipoId;
        fetch(url)
            .then(res => res.json())
            .then(result => {
                const materialesProducidos = result.data || result;
                const placeholderText = Array.isArray(materialesProducidos) && materialesProducidos.length > 0 ? "Seleccione una opción" : "No hay materiales disponibles";
                limpiarSelect(selectId, placeholderText);
                llenarSelect(selectId, materialesProducidos, 'MaterialID', 'Descripcion');
            })
            .catch(error => {
                console.error("Error al cargar materiales producidos:", error);
                select.innerHTML = '<option value="">Error al cargar materiales</option>';
            });
    }

    document.getElementById("creartag")?.addEventListener("click", crearEquipoNuevo);

    function crearEquipoNuevo() {
        const descripcion = document.getElementById("_descripcion")?.value.trim();
        const tagName = document.getElementById("_tagName")?.value.trim();
        const tagCode = document.getElementById("_tagCode")?.value.trim();
        const tipoOperacionVal = document.getElementById("_tipoOperacionId")?.value;
        const equipoVal = document.getElementById("_equipoId")?.value;
        const materialVal = document.getElementById("_materialId")?.value;
        const materialProducidoVal = document.getElementById("_materialProducidoId")?.value;
        const tipoOperacionId = tipoOperacionVal ? parseInt(tipoOperacionVal) : null;
        const equipoId = equipoVal ? parseInt(equipoVal) : null;
        const materialId = materialVal ? parseInt(materialVal) : null;
        const materialProducidoId = materialProducidoVal ? parseInt(materialProducidoVal) : null;
        const activo = document.getElementById("_activo")?.checked;
        const url = document.getElementById("creartag")?.getAttribute("data-url");

        if (!descripcion || !tagName || !tagCode || !tipoOperacionId || !equipoId) {
            alert("Complete los campos requeridos.");
            return;
        }

        const data = {
            _descripcion: descripcion,
            _tagName: tagName,
            _tagCode: tagCode,
            _tipoOperacionId: tipoOperacionId,
            _equipoId: equipoId,
            _materialId: materialId,
            _activo: activo,
            _materialProducidoId: materialProducidoId
        };

        fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json; charset=utf-8" },
            body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                const alertEl = document.getElementById("alertSuccess");
                if (alertEl) alertEl.style.display = "block";
                setTimeout(() => {
                    if (alertEl) alertEl.style.display = "none";
                    const modal = bootstrap.Modal.getInstance(document.getElementById("newTag"));
                    if (modal) modal.hide();
                    document.querySelector("#newTag form")?.reset();
                    if (typeof loadEquipmentTable === "function") loadEquipmentTable();
                }, 1500);
            } else {
                alert(result.message || "Ocurrio un error al crear el tag.");
            }
        })
        .catch(err => {
            console.error("Error:", err);
            alert("Ocurrio un error al enviar los datos.");
        });
    }


    //______________________________________________________________________________________Tag List_______________________________________________

    function guardarFiltros() {
        const equipoId = document.getElementById('selectFiltroEquipo')?.value;
        const tipoId = document.getElementById('selectFiltroTipoOperacion')?.value;
        const materialProducidoId = document.getElementById('selectFiltroMaterialProducido')?.value;
        localStorage.setItem('filtroEquipoId', equipoId || '');
        localStorage.setItem('filtroTipoOperacionId', tipoId || '');
        localStorage.setItem('filtroMaterialProducidoId', materialProducidoId || '');
    }

    function cargarSelectFiltroEquipos() {
        const sel = document.getElementById('selectFiltroEquipo');
        if (!sel) return Promise.resolve();
        limpiarSelect('selectFiltroEquipo', 'Equipment filter');
        const savedEquipoId = localStorage.getItem('filtroEquipoId');
        return fetch('@Url.Action("GetEquiposporPlantalogguedUser", "Equipo")')
            .then(r => r.json())
            .then(data => {
                llenarSelect('selectFiltroEquipo', data, "EquipoID", "Descripcion");
                if (savedEquipoId) {
                    sel.value = savedEquipoId;
                }
            })
            .catch(err => console.error('Error cargando equipos filtro:', err));
    }

    function cargarSelectFiltroTipoOperacion() {
        const sel = document.getElementById('selectFiltroTipoOperacion');
        if (!sel) return Promise.resolve();
        limpiarSelect('selectFiltroTipoOperacion', 'Operation type filter');
        const savedTipoId = localStorage.getItem('filtroTipoOperacionId');
        return fetch('@Url.Action("GetTipoOperacion", "Tag")')
            .then(r => r.json())
            .then(data => {
                llenarSelect('selectFiltroTipoOperacion', data, "TipoOperacionID", "Descripcion");
                if (savedTipoId) {
                    sel.value = savedTipoId;
                }
            })
            .catch(err => console.error('Error cargando tipos operacion:', err));
    }

    function cargarSelectFiltroMaterialProducidoDinamico(equipoId) {
        const selectId = 'selectFiltroMaterialProducido';
        const sel = document.getElementById(selectId);
        if (!sel) return Promise.resolve();
        const savedMaterialId = localStorage.getItem('filtroMaterialProducidoId') || "";

        limpiarSelect(selectId, "Material type filter");

        if (!equipoId) {
            return Promise.resolve();
        }

        sel.innerHTML = '<option value="">Cargando materiales...</option>';
        const url = '@Url.Action("GetMaterialesProducidosByEquipo", "Material")' + '?equipoId=' + equipoId;
        return fetch(url)
            .then(res => res.json())
            .then(result => {
                const materialesProducidos = result.data || result;
                limpiarSelect(selectId, "Material type filter");
                llenarSelect(selectId, materialesProducidos, 'MaterialID', 'Descripcion');

                if (savedMaterialId) {
                    const opciones = Array.from(sel.options).map(opt => opt.value);
                    if (opciones.includes(savedMaterialId)) {
                        sel.value = savedMaterialId;
                    } else {
                        sel.value = "";
                    }
                } else {
                    sel.value = "";
                }

                localStorage.removeItem('filtroMaterialProducidoId');
            })
            .catch(error => {
                console.error("Error al cargar materiales producidos para el filtro:", error);
                limpiarSelect(selectId, "Error al cargar");
            });
    }

    function loadEquipmentTable() {
        const tbody = document.getElementById('downtimeTableBody');
        if (!tbody) return;
        tbody.innerHTML = '';
        const countElement = document.getElementById('countdata');
        if (countElement) {
             countElement.textContent = '0';
        }
        cargando();

        const equipoId = getSafeId(document.getElementById('selectFiltroEquipo')?.value);
        const tipoId = getSafeId(document.getElementById('selectFiltroTipoOperacion')?.value);
        const materialProducidoId = getSafeId(document.getElementById('selectFiltroMaterialProducido')?.value);

        let url = '@Url.Action("GetTagsByPlantAndEquipment", "Tag")' +
                  `?equipoId=${equipoId}&tipoOperacionId=${tipoId}&materialProducidoId=${materialProducidoId}`;

        fetch(url, { credentials: 'include' })
            .then(async (response) => {
                if (!response.ok) throw new Error('HTTP ' + response.status);
                return await response.json();
            })
            .then(payload => {
                if (payload.success && Array.isArray(payload.data) && payload.data.length > 0) {
                    payload.data.forEach(item => {
                        const row = document.createElement('tr');

                        row.setAttribute('data-equipo-id', getSafeId(item._equipoId));
                        row.setAttribute('data-tipo-id', getSafeId(item._tipoOperacionId));
                        row.setAttribute('data-material-producido-id', getSafeId(item._materialProducidoId));

                        row.innerHTML = `
                            <td class="text-center">
                                ${item._activo ? '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-x-circle-fill text-danger"></i>'}
                            </td>
                            <td class="text-center">${item._tagCode || ''}</td>
                            <td class="text-center">${item._descripcion || ''}</td>
                            <td class="text-center">${item._tipoOperacionDescripcion || ''}</td>
                            <td class="text-center">${item._materialDescripcion || ''}</td>
                            <td class="text-center">${item._equipoDescripcion || ''}</td>
                            <td class="text-center">${item._materialProducidoDescripcion || ''}</td>
                            <td class="text-center bg-white">
                                <a class="dropdown-item" href="javascript:void(0)" onclick="abrirModalEditarTag(${item._tagEquipoId})">
                                    <i class="bi bi-pencil me-2"></i>
                                </a>
                            </td>
                        `;
                        tbody.appendChild(row);
                    });

                    if (countElement) {
                        countElement.textContent = payload.data.length;
                    }
                } else {
                    if (!payload.success && payload.message) {
                        console.warn("Filtro sin resultados:", payload.message);
                    }
                }
                guardarFiltros();
            })
            .catch(error => {
                console.error('Error cargando la tabla de equipos:', error);
            })
            .finally(() => {
                document.getElementById('loadingModal').style.display = 'none';
            });
    }


    //____________________________________________________________________________________________Edit Tags_______________________________________________________


    function abrirModalEditarTag(tagId) {
        document.getElementById("loadingModal").style.display = "block";

        Promise.all([
            fetch('@Url.Action("GetEquiposporPlantalogguedUser", "Equipo")').then(res => res.json()),
            fetch('@Url.Action("GetTipoOperacion", "Tag")').then(res => res.json()),
        ])
        .then(([resultEquipos, resultTiposOperacion]) => {
            const equipos = resultEquipos.data || resultEquipos;
            const tiposOperacion = resultTiposOperacion.data || resultTiposOperacion;

            limpiarSelect('_equipoIdeditar', 'Seleccione un equipo');
            llenarSelect('_equipoIdeditar', equipos, 'EquipoID', 'Descripcion');

            limpiarSelect('_tipoOperacionIdeditar', 'Seleccione un tipo de operacion');
            llenarSelect('_tipoOperacionIdeditar', tiposOperacion, 'TipoOperacionID', 'Descripcion');

            limpiarSelect('_materialIdeditar', 'Seleccione un Equipo primero');
            limpiarSelect('_materialProducidoIdeditar', 'Seleccione un Equipo primero');

            return fetch('@Url.Action("GetTagId", "Tag")' + '?tagId=' + tagId);
        })
        .then(res => res.json())
        .then(result => {
            if (result.success) {
                const data = result.data;
                const equipoId = data._equipoId;
                const materialProducidoId = data._materialProducidoId;
                const materialConsumoId = data._materialId;

                document.getElementById("tagIdhidden").value = data._tagEquipoId;
                document.getElementById("_descripcioneditar").value = data._descripcion;
                document.getElementById("_tagNameeditar").value = data._tagName;
                document.getElementById("_tagCodeeditar").value = data._tagCode;
                document.getElementById("_activoeditar").checked = data._activo;

                document.getElementById("_tipoOperacionIdeditar").value = data._tipoOperacionId?.toString() || '';
                document.getElementById("_equipoIdeditar").value = equipoId?.toString() || '';

                if (equipoId) {
                    cargarMaterialesProducidos(equipoId, materialProducidoId);
                    cargarMaterialesConsumidos(equipoId, materialConsumoId);
                }

                const selectEquipo = document.getElementById("_equipoIdeditar");
                selectEquipo.onchange = null;
                selectEquipo.onchange = function() {
                    const nuevoEquipoId = this.value;
                    cargarMaterialesProducidos(nuevoEquipoId);
                    cargarMaterialesConsumidos(nuevoEquipoId);
                };

                const modalElement = document.getElementById("editTag");
                const modal = new bootstrap.Modal(modalElement);
                modal.show();
            } else {
                alert("Error al obtener datos del tag: " + result.message);
            }
        })
        .catch(error => {
            console.error("Error:", error);
            alert("Error al cargar el formulario de edicion.");
        })
        .finally(() => {
            document.getElementById("loadingModal").style.display = "none";
        });
    }


    function cargarMaterialesConsumidos(equipoId, materialConsumoIdToSelect = null) {
        const selectId = '_materialIdeditar';
        const select = document.getElementById(selectId);
        if (!equipoId) {
            limpiarSelect(selectId, 'Seleccione un Equipo primero');
            return;
        }
        select.innerHTML = '<option value="">Cargando materiales...</option>';
        const url = '@Url.Action("GetMaterialesConsumidosByEquipo", "Material")' + '?equipoId=' + equipoId;
        fetch(url)
            .then(res => res.json())
            .then(result => {
                const materialesConsumo = result.data || result;
                const placeholderText = Array.isArray(materialesConsumo) && materialesConsumo.length > 0 ? "Seleccione un material (opcional)" : "No hay materiales de consumo disponibles";
                limpiarSelect(selectId, placeholderText);
                llenarSelect(selectId, materialesConsumo, 'MaterialID', 'Descripcion');
                if (materialConsumoIdToSelect) {
                    select.value = materialConsumoIdToSelect.toString();
                }
            })
            .catch(error => {
                console.error("Error al cargar materiales consumidos:", error);
                select.innerHTML = '<option value="">Error al cargar materiales</option>';
            });
    }

    function cargarMaterialesProducidos(equipoId, materialProducidoIdToSelect = null) {
        const selectId = '_materialProducidoIdeditar';
        const select = document.getElementById(selectId);
        if (!equipoId) {
            limpiarSelect(selectId, 'Seleccione un Equipo primero');
            return;
        }
        select.innerHTML = '<option value="">Cargando materiales...</option>';
        const url = '@Url.Action("GetMaterialesProducidosByEquipo", "Material")' + '?equipoId=' + equipoId;
        fetch(url)
            .then(res => res.json())
            .then(result => {
                const materialesProducidos = result.data || result;
                limpiarSelect(selectId, 'Seleccione una opción');
                llenarSelect(selectId, materialesProducidos, 'MaterialID', 'Descripcion');
                if (materialProducidoIdToSelect) {
                    select.value = materialProducidoIdToSelect.toString();
                }
            })
            .catch(error => {
                console.error("Error al cargar materiales producidos:", error);
                select.innerHTML = '<option value="">Error al cargar materiales</option>';
            });
    }

    function submitEditEquipmentForm() {
        cargando();
        const data = {
            _tagEquipoId: document.getElementById("tagIdhidden")?.value,
            _descripcion: document.getElementById("_descripcioneditar")?.value,
            _tagName: document.getElementById("_tagNameeditar")?.value,
            _tagCode: document.getElementById("_tagCodeeditar")?.value,
            _tipoOperacionId: document.getElementById("_tipoOperacionIdeditar")?.value,
            _equipoId: document.getElementById("_equipoIdeditar")?.value,
            _activo: document.getElementById("_activoeditar")?.checked,
            _materialId: document.getElementById("_materialIdeditar")?.value,
            _materialProducidoId: document.getElementById("_materialProducidoIdeditar")?.value,
        };

        fetch('@Url.Action("EditTag", "Tag")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(res => res.json())
        .then(response => {
            if (response.success) {
                document.getElementById("alertEditeSuccesseditar").style.display = "block";
                setTimeout(() => {
                    document.getElementById("alertEditeSuccesseditar").style.display = "none";
                    const modal = bootstrap.Modal.getInstance(document.getElementById("editTag"));
                    modal.hide();
                    loadEquipmentTable();
                }, 2000);
            } else {
                alert("Error: " + response.message);
            }
        })
        .catch(error => {
            console.error("Error al enviar datos:", error);
            alert("Ocurrió un error al enviar los datos.");
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        const selectEquipo = document.getElementById('selectFiltroEquipo');

        if (!selectEquipo) {
            loadEquipmentTable();
            return;
        }

        selectEquipo.addEventListener('change', function() {
            const equipoId = this.value;
            cargarSelectFiltroMaterialProducidoDinamico(equipoId)
                .then(() => {
                    loadEquipmentTable();
                })
                .catch(() => {
                    loadEquipmentTable();
                });
        });

        document.getElementById('selectFiltroTipoOperacion')
            ?.addEventListener('change', loadEquipmentTable);

        document.getElementById('selectFiltroMaterialProducido')
            ?.addEventListener('change', loadEquipmentTable);

        Promise.all([
            cargarSelectFiltroEquipos(),
            cargarSelectFiltroTipoOperacion()
        ])
        .then(() => {
            const equipoIdPreseleccionado = selectEquipo.value;
            return cargarSelectFiltroMaterialProducidoDinamico(equipoIdPreseleccionado);
        })
        .then(() => {
            loadEquipmentTable();
        })
        .catch(error => {
            console.error("Error al inicializar filtros, cargando la tabla sin persistencia de filtros.", error);
            loadEquipmentTable();
        });
    });

    document.getElementById("_buscar")?.addEventListener("keyup", function () {
        const filtro = this.value.toLowerCase();
        const filas = document.querySelectorAll("#downtimeTableBody tr");
        let visibles = 0;

        const equipoId = getSafeId(document.getElementById('selectFiltroEquipo')?.value);
        const tipoId = getSafeId(document.getElementById('selectFiltroTipoOperacion')?.value);
        const materialProducidoId = getSafeId(document.getElementById('selectFiltroMaterialProducido')?.value);

        filas.forEach(fila => {
            const textoFila = fila.textContent.toLowerCase();
            const esVisiblePorTexto = textoFila.includes(filtro);

            if (esVisiblePorTexto) {
                const filaEquipoId = fila.getAttribute('data-equipo-id') || '';
                const filaTipoId = fila.getAttribute('data-tipo-id') || '';
                const filaMaterialProducidoId = fila.getAttribute('data-material-producido-id') || '';

                const coincideEquipo = !equipoId || filaEquipoId === equipoId;
                const coincideTipo = !tipoId || filaTipoId === tipoId;

                let coincideMaterialProducido;
                if (!materialProducidoId) {
                    coincideMaterialProducido = true;
                } else {
                    coincideMaterialProducido = filaMaterialProducidoId === materialProducidoId;
                }

                const mostrar = coincideEquipo && coincideTipo && coincideMaterialProducido;

                fila.style.display = mostrar ? "" : "none";
                if (mostrar) visibles++;
            } else {
                fila.style.display = "none";
            }
        });
        const countElement = document.getElementById('countdata');
        if (countElement) {
            countElement.textContent = visibles;
        }
    });
</script>   


        