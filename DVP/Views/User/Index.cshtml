    //____________________________________________________________________ Asignar planta ____________________________________________________________//


    document.addEventListener("DOMContentLoaded", function () {
        const $ = (s) => document.querySelector(s);
        const $$ = (s) => Array.from(document.querySelectorAll(s));

        const showLoading = () => {
            const el = document.getElementById("loadingModal");
            if (el) el.style.display = "block";
        };
        const hideLoading = () => {
            const el = document.getElementById("loadingModal");
            if (el) el.style.display = "none";
        };

        const getToken = () => {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : null;
        };

        const showOK = (msg) => {
            const ok = $("#alertOK");
            ok.textContent = msg || "Operacion exitosa";
            ok.classList.remove("d-none");
            $("#alertERR").classList.add("d-none");
        };

        const showERR = (msg) => {
            const er = $("#alertERR");
            er.textContent = msg || "Ocurrio un error";
            er.classList.remove("d-none");
            $("#alertOK").classList.add("d-none");
        };

        const renderPlantas = (items) => {
            const cont = $("#listaPlantas");
            cont.innerHTML = "";
            (items || []).forEach(p => {
                const id = `pl_${p.PlantaID}`;
                const row = document.createElement("div");
                row.className = "form-check";
                row.dataset.nombre = (p.Descripcion || "").toLowerCase();

                const input = document.createElement("input");
                input.className = "form-check-input chk-planta";
                input.type = "checkbox";
                input.value = p.PlantaID;
                input.id = id;

                const label = document.createElement("label");
                label.className = "form-check-label";
                label.htmlFor = id;
                label.textContent = p.Descripcion;

                row.appendChild(input);
                row.appendChild(label);
                cont.appendChild(row);
            });
            updateSelCount();
        };

        const updateSelCount = () => {
            const n = $$(".chk-planta:checked").length;
            $("#selCount").textContent = `${n} seleccionadas`;
            const all = $("#chkAll");
            all.checked = n > 0 && n === $$(".chk-planta").length;
        };

        // Llena el <select id="_plantaAsignada"> con las asignadas
        const fillSelectAsignadas = (asignadasIds, plantas) => {
            const sel = document.getElementById("_plantaAsignada");
            if (!sel) return;

            sel.innerHTML = '<option value="">Seleccione una planta</option>';

            const dic = new Map((plantas || []).map(p => [Number(p.PlantaID), p.Descripcion]));

            (asignadasIds || []).forEach(id => {
                const opt = document.createElement("option");
                opt.value = id;
                opt.textContent = dic.get(Number(id)) || `Planta ${id}`;
                sel.appendChild(opt);
            });
        };

        // === abrir modal (muestra loading antes y lo oculta al final) ===
        window.abrirModalAsignar = async function (usuarioId, usuarioNombre) {
            showLoading();
            try {
                if (typeof bootstrap === "undefined" || !bootstrap.Modal) {
                    showERR("Bootstrap JS no está cargado");
                    return;
                }

                // Guarda usuario
                $("#hiddenUsuarioId").value = usuarioId;
                $("#txtUsuarioNombre").textContent = usuarioNombre;

                const modalEl = document.getElementById("asignarPlanta");
                const urlPlantas = modalEl.getAttribute("data-url-plantas");
                const urlAsignadas = modalEl.getAttribute("data-url-asignadas");

                // 1) Cargar listas en paralelo
                const [rPlantas, rAsignadas] = await Promise.all([
                    fetch(urlPlantas, { credentials: "same-origin" }),
                    fetch(`${urlAsignadas}?userId=${encodeURIComponent(usuarioId)}`, { credentials: "same-origin" })
                ]);

                if (!rPlantas.ok) throw new Error("No se pudo obtener plantas");

                const plantas = await rPlantas.json();
                let asignadasRaw = [];
                try { asignadasRaw = rAsignadas.ok ? await rAsignadas.json() : []; } catch { asignadasRaw = []; }

                // 2) Renderizar plantas
                renderPlantas(plantas);

                // 3) Normalizar IDs asignados
                const asignadasIds = (asignadasRaw || []).map(x => {
                    if (typeof x === "number") return x;
                    if (x && typeof x === "object") return x.PlantaID ?? x.Id ?? x.plantaId ?? x.plantaID;
                    return null;
                }).filter(v => Number.isInteger(v));

                // 4) Pre-marcar checkboxes
                if (asignadasIds.length > 0) {
                    document.querySelectorAll(".chk-planta").forEach(chk => {
                        const id = parseInt(chk.value, 10);
                        chk.checked = asignadasIds.includes(id);
                    });
                }

                // 5) Llenar select de asignadas
                fillSelectAsignadas(asignadasIds, plantas);

                // 6) Actualizar contador
                updateSelCount();

                // 7) Mostrar modal
                new bootstrap.Modal(modalEl).show();

            } catch (e) {
                console.error(e);
                showERR("No se pudieron cargar las plantas");
            } finally {
                hideLoading(); // ocultar siempre al final
            }
        };

        // seleccionar todo
        $("#chkAll").addEventListener("change", function () {
            const checked = this.checked;
            $$(".chk-planta").forEach(chk => chk.checked = checked);
            updateSelCount();
        });

        // contador por selección individual
        $("#listaPlantas").addEventListener("change", function (e) {
            if (e.target && e.target.classList.contains("chk-planta")) {
                updateSelCount();
            }
        });

        // filtro de plantas
        $("#filtroPlantas").addEventListener("input", function () {
            const q = this.value.trim().toLowerCase();
            $$("#listaPlantas .form-check").forEach(row => {
                const nombre = row.dataset.nombre || "";
                row.style.display = nombre.includes(q) ? "" : "none";
            });
        });

        // enviar asignaciones (muestra loading durante el POST)
        $("#btnAsignarPlantas").addEventListener("click", async function () {
            const usuarioId = parseInt($("#hiddenUsuarioId").value || "0", 10);
            const plantaIds = $$(".chk-planta:checked").map(chk => parseInt(chk.value, 10));

            if (!usuarioId) { showERR("Usuario no válido"); return; }

            const token = getToken();
            const modalEl = document.getElementById("asignarPlanta");
            const urlPost = modalEl.getAttribute("data-url-post");

            const payload = { _usuarioId: usuarioId, _plantaIds: plantaIds };

            this.disabled = true;
            const oldTxt = this.textContent;
            this.textContent = "Asignando...";
            showLoading();

            try {
                const res = await fetch(urlPost, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        ...(token ? { "RequestVerificationToken": token } : {})
                    },
                    body: JSON.stringify(payload),
                    credentials: "same-origin"
                });

                const data = await res.json();

                if (data?.success) {
                    showOK(data.message || "Asignaciones sincronizadas");
                    setTimeout(() => location.reload(), 1200);
                } else {
                    showERR(data?.message || "No se pudo sincronizar");
                }
            } catch (err) {
                console.error(err);
                showERR("Error de red o servidor");
            } finally {
                this.disabled = false;
                this.textContent = oldTxt;
                hideLoading();
            }
        });

    });




</script>
