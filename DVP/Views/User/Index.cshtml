@section scripts{
    <script src="~/Content/Modernize-1.0.0/src/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/js/sidebarmenu.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/js/app.min.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/Modernize-1.0.0/src/assets/libs/simplebar/dist/simplebar.js"></script>



}


<script>



    document.addEventListener("DOMContentLoaded", function () {
        loadTable();
    });

    function cargando() {
        document.getElementById("loadingModal").style.display = "block";
    }

    //______________________________________________________________ Crear usuario ________________________________________________________________//


    function newUser() {
    // Mostrar el modal
    const modalElement = document.getElementById("newUser");
    const modal = new bootstrap.Modal(modalElement);
    modal.show();

    // Cargar los combos al abrir
    cargarCombos();
    }

    function cargarCombos() {
    // Limpiar selects
    limpiarSelect("_rolId");
    limpiarSelect("_gerenciaId");
    limpiarSelect("_plantaId");
    limpiarSelect("_unidadOperativaId");
    limpiarSelect("_paisId");

        // Llamadas AJAX a cada endpoint
    fetch('@Url.Action("GetRol", "User")')
        .then(response => response.json())
        .then(data => llenarSelect("_rolId", data, "RolID", "Descripcion"));

    fetch('@Url.Action("GetGerencia", "User")')
        .then(response => response.json())
        .then(data => llenarSelect("_gerenciaId", data, "GerenciaID", "Descripcion"));

    fetch('@Url.Action("GetPlanta", "Equipo")')
        .then(response => response.json())
        .then(data => llenarSelect("_plantaId", data, "PlantaID", "Descripcion"));

    fetch('@Url.Action("GetUnidadOperativa", "Equipo")')
        .then(response => response.json())
        .then(data => llenarSelect("_unidadOperativaId", data, "UnidadOperativaID", "Descripcion"));

    fetch('@Url.Action("GetPais", "Equipo")')
        .then(response => response.json())
        .then(data => llenarSelect("_paisId", data, "PaisID", "Descripcion"));
}

    function llenarSelect(selectId, data, valueField, textField) {
    const select = document.getElementById(selectId);
    data.forEach(item => {
        const option = document.createElement("option");
        option.value = item[valueField];
        option.text = item[textField];
        select.appendChild(option);
    });
}

    function limpiarSelect(selectId) {
    const select = document.getElementById(selectId);
    select.innerHTML = '<option value="">Seleccione una opción</option>';
}



    document.getElementById("crear").addEventListener("click", crearEquipoNuevo);

    function crearEquipoNuevo() {
        // Mostrar modal de carga antes de iniciar el proceso
        cargando();

        // Obtener valores del formulario
        const descripcion = document.getElementById("_descripcion").value.trim();
        const email = document.getElementById("_email").value.trim();
        const nombre = document.getElementById("_nombre").value.trim();
        const contraseñaHash = document.getElementById("_contraseñaHash").value.trim();
        const aDUsername = document.getElementById("_aDUsername").value.trim();
        const esAD = document.getElementById("_esAD").checked;
        const numeroEmpleado = document.getElementById("_numeroEmpleado").value.trim();
        const plantaId = document.getElementById("_plantaId").value;
        const unidadOperativaId = document.getElementById("_unidadOperativaId").value;
        const paisId = document.getElementById("_paisId").value;
        const gerenciaId = document.getElementById("_gerenciaId").value;
        const active = document.getElementById("_active").checked;
        const rolId = document.getElementById("_rolId").value;
        const userIdProgreso = document.getElementById("_userIdProgreso").value;

        const url = document.getElementById("crear").getAttribute("data-url");

        // Construir el objeto que será enviado al controlador
        const data = {
            _descripcion: descripcion,
            _email: email,
            _nombre: nombre,
            _contraseñaHash: contraseñaHash,
            _aDUsername: aDUsername,
            _esAD: esAD,
            _numeroEmpleado: numeroEmpleado,
            _plantaId: parseInt(plantaId),
            _unidadOperativaId: parseInt(unidadOperativaId),
            _paisId: parseInt(paisId),
            _gerenciaId: parseInt(gerenciaId),
            _active: active,
            _rolId: parseInt(rolId),
            _userIdProgreso: userIdProgreso
        };

        // Enviar al backend vía fetch
        fetch(url, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(data)
        })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    document.getElementById("alertSuccess").style.display = "block";

                    // Esperar un poco antes de recargar la página
                    setTimeout(() => {
                        location.reload();
                    }, 1500);
                } else {
                    alert(result.message || "Ocurrió un error al crear el equipo.");
                    document.getElementById("loadingModal").style.display = "none"; // Ocultar carga si falla
                }
            })
            .catch(error => {
                console.error("Error al enviar el formulario:", error);
                alert("Ocurrió un error al enviar los datos.");
                document.getElementById("loadingModal").style.display = "none"; // Ocultar carga si falla
            });
    }



    //______________________________________________________________ Validación de contraseña desde el frontend ____________________________________//


    async function estaComprometida(password) {
        const sha1 = await crypto.subtle.digest("SHA-1", new TextEncoder().encode(password));
        const hash = Array.from(new Uint8Array(sha1)).map(b => b.toString(16).padStart(2, '0')).join('').toUpperCase();
        const prefix = hash.substring(0, 5);
        const suffix = hash.substring(5);

        const response = await fetch(`https://api.pwnedpasswords.com/range/${prefix}`);
        const text = await response.text();
        return text.includes(suffix);
    }
    const input = document.getElementById("_contraseñaHash");
    const msg = document.getElementById("msgInsegura");
    input.addEventListener("blur", async function () {
        const password = input.value.trim();

        // Validaciones frontend
        const tieneLongitudSuficiente = password.length >= 8;
        const tieneMayuscula = /[A-Z]/.test(password);
        const tieneCaracterEspecial = /[^a-zA-Z0-9]/.test(password);

        if (!tieneLongitudSuficiente || !tieneMayuscula || !tieneCaracterEspecial) {
            msg.style.display = "block";
            msg.innerText = "⚠️ Esta contraseña es débil. Usa al menos 8 caracteres, una mayúscula y un carácter especial.";
            input.classList.add("is-invalid");
            return;
        }

        // Si pasa las validaciones básicas, verificar si está comprometida
        const comprometida = await estaComprometida(password);

        if (comprometida) {
            msg.style.display = "block";
            msg.innerText = "⚠️ Esta contraseña ha sido comprometida en una filtración. Elige otra.";
            input.classList.add("is-invalid");
        } else {
            msg.style.display = "none";
            input.classList.remove("is-invalid");
        }
    });
    const togglePassword = document.getElementById("togglePassword");
    const passwordInput = document.getElementById("_contraseñaHash");
    togglePassword.addEventListener("click", function () {
        const isPassword = passwordInput.getAttribute("type") === "password";
        passwordInput.setAttribute("type", isPassword ? "text" : "password");

        // Cambiar icono
        this.classList.toggle("bi-eye");
        this.classList.toggle("bi-eye-slash");
    });


    //______________________________________________________________ Relleno del datatable ____________________________________//

       function loadTable() {
        const tbody = document.getElementById('downtimeTableBody');
        tbody.innerHTML = '';

        cargando();

        fetch('@Url.Action("GetUsuarios", "User")')
            .then(response => {
                if (!response.ok) throw new Error("Error al obtener los datos.");
                return response.json();
            })
            .then(result => {
                // ✅ Asegurar estructura esperada
                if (!result.success || !Array.isArray(result.data)) {
                    alert("La respuesta del servidor no es válida.");
                    return;
                }

                const usuariosActivos = result.data.filter(user => user._active === true);

                usuariosActivos.forEach(user => {
                    const row = document.createElement('tr');

                    row.innerHTML = `
                        <td class="text-center">
                            ${user._active ? '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-x-circle-fill text-danger"></i>'}
                        </td>
                        <td class="text-center">${user._descripcion || ''}</td>
                        <td class="text-center">${user._userIdProgreso || ''}</td>
                        <td class="text-center">${user._plantaDescripcion || ''}</td>
                        <td class="text-center">${user._email || ''}</td>
                        <td class="text-center bg-white">
                            <a class="dropdown-item" href="javascript:void(0)" onclick="abrirModalEditar(${user._usuarioId})">
                                <i class="bi bi-pencil me-2"></i>
                            </a>
                        </td>
                        <td class="text-center bg-white">
                            <a class="dropdown-item" href="javascript:void(0)" onclick="abrirModalAsignar(${user._usuarioId},'${user._nombre}')">
                                <i class="bi bi-pencil me-2"></i>
                            </a>
                        </td>
                    `;

                    tbody.appendChild(row);
                });
            })
            .catch(error => {
                console.error("Error cargando la tabla de usuarios:", error);
                alert("Ocurrió un error al cargar los usuarios.");
            })
            .finally(() => {
                document.getElementById("loadingModal").style.display = "none";
            });
        }


    //______________________________________________________________ Editar usuario ___________________________________________//



    function abrirModalEditar(userId) {
    cargando(); // ✅ Mostrar el loading modal al hacer clic

    Promise.all([
        fetch('@Url.Action("GetRol", "User")').then(res => res.json()),
        fetch('@Url.Action("GetGerencia", "User")').then(res => res.json()),
        fetch('@Url.Action("GetPlanta", "Equipo")').then(res => res.json()),
        fetch('@Url.Action("GetUnidadOperativa", "Equipo")').then(res => res.json()),
        fetch('@Url.Action("GetPais", "Equipo")').then(res => res.json())
    ])
    .then(([roles, gerencias, plantas, unidades, paises]) => {
        llenarSelect('_rolIdedit', roles, 'RolID', 'Descripcion');
        llenarSelect('_gerenciaIdedit', gerencias, 'GerenciaID', 'Descripcion');
        llenarSelect('_plantaIdedit', plantas, 'PlantaID', 'Descripcion');
        llenarSelect('_unidadOperativaIdedit', unidades, 'UnidadOperativaID', 'Descripcion');
        llenarSelect('_paisIdedit', paises, 'PaisID', 'Descripcion');

        return fetch('@Url.Action("GetuserbyId", "User")' + '?userId=' + userId);
    })
    .then(res => res.json())
    .then(result => {
        if (result.success) {
            const data = result.data;

            document.getElementById("userid").value = data._usuarioId;
            document.getElementById("_descripcionedit").value = data._descripcion;
            document.getElementById("_emailedit").value = data._email;
            document.getElementById("_nombreedit").value = data._nombre;
            document.getElementById("_userIdProgresoedit").value = data._userIdProgreso;
            document.getElementById("_aDUsernameedit").value = data._aDUsername;
            document.getElementById("_numeroEmpleadoedit").value = data._numeroEmpleado;
            document.getElementById("_esADedit").checked = data._esAD;
            document.getElementById("_activeedit").checked = data._active;

            setTimeout(() => {
                document.getElementById("_rolIdedit").value = data._rolId?.toString();
                document.getElementById("_gerenciaIdedit").value = data._gerenciaId?.toString();
                document.getElementById("_plantaIdedit").value = data._plantaId?.toString();
                document.getElementById("_unidadOperativaIdedit").value = data._unidadOperativaId?.toString();
                document.getElementById("_paisIdedit").value = data._paisId?.toString();
            }, 100);

            const modalElement = document.getElementById("editar");
            const modal = new bootstrap.Modal(modalElement);
            modal.show();
        } else {
            alert("Error al obtener datos del equipo: " + result.message);
        }
    })
    .catch(error => {
        console.error("Error:", error);
        alert("Error al cargar el formulario de edición.");
    })
    .finally(() => {
        document.getElementById("loadingModal").style.display = "none";
    });
}


    function llenarSelect(selectId, items, valueProp, textProp) {
        const select = document.getElementById(selectId);
        select.innerHTML = '<option value="">Seleccione una opción</option>';

        items.forEach(item => {
            const option = document.createElement("option");
            option.value = item[valueProp];
            option.textContent = item[textProp];
            select.appendChild(option);
        });
    }



