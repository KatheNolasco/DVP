                                            <div class="mb-3">
                                                <label class="form-label">Nombre Completo</label>
                                                <input type="text" class="form-control" id="_nombre" required>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">User Id Progreso</label>
