@model DVP.Models.UserViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Downtime Page";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<style>
    /* Estilo para el contenedor de la fecha y hora */
    .container {
        font-family: Arial, sans-serif;
        display: flex; /* Usamos flex para alinearlos horizontalmente */
        justify-content: center; /* Centra los elementos horizontalmente */
        align-items: center; /* Centra los elementos verticalmente */
        gap: 20px; /* Espacio entre los divs */
        margin-top: 20px;
    }
    /* Estilo para los divs de fecha y hora */
    .input-container {
        font-size: 18px;
        display: flex;
        flex-direction: column; /* Los inputs se alinean de arriba hacia abajo */
        align-items: center;
    }

    input {
        padding: 10px;
        font-size: 16px;
        margin-top: 10px;
        border: 2px solid #ccc;
        border-radius: 8px;
        background-color: #f0f0f0;
    }

    .scrollable-table {
        max-height: 400px;
        overflow-y: auto;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa; /* color fondo header */
        z-index: 2;
        text-align: center;
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
        text-align: center;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 45px;
        height: 24px;
        margin-right: 8px;
        vertical-align: middle;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .switch .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 34px;
        }

            .switch .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 3px;
                bottom: 3px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        .switch input:checked + .slider {
            background-color: #13DEB9; /* Verde menta */
        }

            .switch input:checked + .slider:before {
                transform: translateX(21px);
            }

    .switch-label {
        font-size: 14px;
        color: #555;
        vertical-align: middle;
    }
</style>


<body>
    <div class="container-fluid" style="padding-left: 200px;">
        <br />
        <br />
        <br />
        <div class="card">
            <div class="container-fluid">
                <div class="container-fluid">
                    <div class="card">
                        <div class="card-body">
                            <div id="alertsuccesclose" class="alert alert-success" role="alert" style="display: none;">
                                Agregado correctamente!
                            </div>
                            <!-- Configuracion -->
                            <h5 class="card-title fw-semibold mb-4">Configuration user</h5>
                        </div>
                        <div class="mb-3">
                            <form id="formElemento">
                                <label class="form-label">Add</label>
                                <select class="form-select" id="_elememnto">
                                    <option value="">Select what you want to add</option>
                                    <option value="1">Planta</option>
                                    <option value="2">Unidad Operativa</option>
                                    <option value="3">País</option>
                                    <option value="4">Gerencia</option>
                                    <option value="5">Proceso</option>
                                </select>

                                <div id="camposContainer" class="mt-3"></div>

                                <button type="submit" id="btnGuardar" class="btn btn-primary mt-2">Guardar</button>
                            </form>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ver elementos por tipo</label>
                        <select class="form-select" id="selectListado">
                            <option value="">Select a type</option>
                            <option value="Planta">Planta</option>
                            <option value="UnidadOperativa">Unidad Operativa</option>
                            <option value="Pais">País</option>
                            <option value="Gerencia">Gerencia</option>
                            <option value="Proceso">Proceso</option>

                        </select>
                    </div>

                    <div id="contenedorListado" class="mt-3"></div>

                </div>
            </div>
        </div>
    </div>

    @*___________________________________________________________________Modal Cargando__________________________________________________*@
    <div id="loadingModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; background-color: rgba(0, 0, 0, 0.5);">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background-color: white; padding: 25px 35px; border-radius: 10px; box-shadow: 0 0 15px rgba(0,0,0,0.3); min-width: 250px;">
            <div style="display: flex; align-items: center; justify-content: center;">
                <img src="/Content/loading-green-loading.gif" alt="Cargando..." style="width: 40px; height: 40px; margin-right: 15px;" />
                <span style="color: black; font-size: 16px;">Cargando...</span>
            </div>
        </div>
    </div>
</body>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const select = document.getElementById('_elememnto');
        const contenedor = document.getElementById('camposContainer');
        const form = document.getElementById('formElemento');
        const successAlert = document.getElementById('alertsuccesclose');

        select.addEventListener('change', function () {
            const valor = this.value;
            contenedor.innerHTML = '';

            switch (valor) {
                case '1':
                    contenedor.innerHTML = `
                <div class="mb-3">
                    <label class="form-label">Nombre de la planta</label>
                    <input type="text" class="form-control" id="_descripcion" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Codigo de planta</label>
                    <input type="text" class="form-control" id="_codigoSAPProgreso" required />
                </div>`;
                    break;

                case '2':
                    contenedor.innerHTML = `
                <div class="mb-3">
                    <label class="form-label">Nombre unidad operativa</label>
                    <input type="text" class="form-control" id="_descripcion" required />
                </div>`;
                    break;

                case '3':
                    contenedor.innerHTML = `
                <div class="mb-3">
                    <label class="form-label">Nombre del pais</label>
                    <input type="text" class="form-control" id="_descripcion" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Codigo</label>
                    <input type="text" class="form-control" id="_codigoSAPProgreso" required />
                </div>`;
                    break;

                case '4':
                    contenedor.innerHTML = `
                <div class="mb-3">
                    <label class="form-label">Nombre de la gerencia</label>
                    <input type="text" class="form-control" id="_descripcion" required />
                </div>`;
                    break;

                case '5': // Proceso
                    contenedor.innerHTML = `
                <div class="mb-3">
                    <label class="form-label">Nombre del proceso</label>
                    <input type="text" class="form-control" id="_descripcion" required />
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="_active" checked>
                    <label class="form-check-label visually-hidden" for="_active">Activo</label>
                </div>`;
                    break;
            }
        });

        form.addEventListener('submit', function (e) {
            e.preventDefault();

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const _tipo = select.value;
            let data = {};

            switch (_tipo) {
                case '1':
                    data = {
                        _tipo: 'Planta',
                        _descripcion: document.getElementById('_descripcion').value,
                        _codigoSAPProgreso: document.getElementById('_codigoSAPProgreso').value
                    };
                    break;

                case '2':
                    data = {
                        _tipo: 'UnidadOperativa',
                        _descripcion: document.getElementById('_descripcion').value
                    };
                    break;

                case '3':
                    data = {
                        _tipo: 'Pais',
                        _descripcion: document.getElementById('_descripcion').value,
                        _codigoSAPProgreso: document.getElementById('_codigoSAPProgreso').value
                    };
                    break;

                case '4':
                    data = {
                        _tipo: 'Gerencia',
                        _descripcion: document.getElementById('_descripcion').value
                    };
                    break;

                case '5': // Proceso
                    data = {
                        _tipo: 'Proceso',
                        _descripcion: document.getElementById('_descripcion').value,
                        _active: (document.getElementById('_active')?.checked ?? true)
                    };
                    break;

                default:
                    alert('Seleccione una opcion valida');
                    return;
            }

            fetch('/User/GuardarElementoConfiguracion', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
                .then(res => res.json())
                .then(res => {
                    if (res.success) {
                        if (successAlert) {
                            successAlert.textContent = 'Agregado correctamente!';
                            successAlert.style.display = 'block';
                            setTimeout(() => { successAlert.style.display = 'none'; }, 2000);
                        } else {
                            alert('Guardado exitosamente');
                        }
                        form.reset();
                        contenedor.innerHTML = '';
                        select.value = '';
                    } else {
                        alert('Error al guardar: ' + (res.message || ''));
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('Error en la peticion');
                });
        });
    });


    document.addEventListener('DOMContentLoaded', function () {
        const selectListado = document.getElementById('selectListado');
        const contenedorListado = document.getElementById('contenedorListado');
        const successAlert = document.getElementById('alertsuccesclose');

        // Mapa: tipo -> nombre de propiedad de ID que espera el backend
        const idPayloadKeyByTipo = {
            'Planta': '_plantaId',
            'UnidadOperativa': '_unidadOperativaId',
            'Pais': '_paisId',
            'Gerencia': '_gerenciaId',
            'Proceso': '_procesoId'
            // 'Rol': '_rolId' // si luego agregas soporte en backend
        };

        selectListado.addEventListener('change', function () {
            const _tipo = this.value;

            contenedorListado.innerHTML = '';
            if (!_tipo) return;

            fetch(`/User/GetListadoConfiguracion?_tipo=${encodeURIComponent(_tipo)}`)
                .then(res => res.json())
                .then(data => {
                    if (!data?.success || !Array.isArray(data.items) || data.items.length === 0) {
                        contenedorListado.innerHTML = '<div class="alert alert-warning">No hay registros disponibles.</div>';
                        return;
                    }

                    const showCodigoColumn = (_tipo === 'Planta' || _tipo === 'Pais');
                    const codigoEditable = (_tipo === 'Planta'); // solo Planta actualiza codigo
                    const idPayloadKey = idPayloadKeyByTipo[_tipo];

                    let html = `
                    <table class="table table-bordered table-sm table-striped">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Descripción</th>
                                ${showCodigoColumn ? '<th>Código</th>' : ''}
                                <th>Activo</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                `;

                    data.items.forEach((item, index) => {
                        const entityId = item[idPayloadKey]; // ya viene con el nombre correcto
                        const descripcion = (item._descripcion ?? '').toString();
                        // _codigoSAPProgreso puede venir vacio segun tipo
                        const codigo = (item._codigoSAPProgreso ?? '');
                        const activo = !!(item._active);

                        html += `
                        <tr data-index="${index}"
                            data-entity-id="${escapeAttr(entityId ?? '')}"
                            data-id-prop="${escapeAttr(idPayloadKey)}">
                            <td>${index + 1}</td>
                            <td class="descripcion">${escapeHtml(descripcion)}</td>
                            ${showCodigoColumn ? `<td class="codigo">${codigo ? escapeHtml(codigo) : '-'}</td>` : ''}
                            <td class="activo">${activo ? 'Sí' : 'No'}</td>
                            <td>
                                <button class="btn btn-sm btn-primary btn-editar">Editar</button>
                            </td>
                        </tr>
                    `;
                    });

                    html += '</tbody></table>';
                    contenedorListado.innerHTML = html;

                    // Eventos Editar
                    contenedorListado.querySelectorAll('.btn-editar').forEach(btn => {
                        btn.addEventListener('click', function () {
                            const fila = this.closest('tr');
                            const descCell = fila.querySelector('.descripcion');
                            const activoCell = fila.querySelector('.activo');
                            const codCell = showCodigoColumn ? fila.querySelector('.codigo') : null;

                            const descripcion = descCell.textContent.trim();
                            const activo = activoCell.textContent.trim().toLowerCase().startsWith('s'); // "Sí"
                            const codigo = codCell ? (codCell.textContent.trim() === '-' ? '' : codCell.textContent.trim()) : '';

                            // Inputs inline
                            descCell.innerHTML = `<input type="text" class="form-control form-control-sm" value="${escapeAttr(descripcion)}">`;
                            if (showCodigoColumn && codCell) {
                                if (codigoEditable) {
                                    codCell.innerHTML = `<input type="text" class="form-control form-control-sm" value="${escapeAttr(codigo)}">`;
                                } else {
                                    codCell.innerHTML = `<input type="text" class="form-control form-control-sm" value="${escapeAttr(codigo)}" disabled>`;
                                }
                            }
                            activoCell.innerHTML = `
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" id="activoCheckbox" ${activo ? 'checked' : ''}>
                                <label class="visually-hidden" for="activoCheckbox">Activo</label>
                            </div>
                        `;

                            // Acciones Guardar/Cancelar
                            this.parentElement.innerHTML = `
                            <button class="btn btn-sm btn-success btn-guardar">Guardar</button>
                            <button class="btn btn-sm btn-secondary btn-cancelar">Cancelar</button>
                        `;

                            // Guardar
                            fila.querySelector('.btn-guardar').addEventListener('click', function () {
                                const nuevaDescripcion = (descCell.querySelector('input')?.value || '').trim();
                                const nuevoActivo = !!activoCell.querySelector('input[type="checkbox"]')?.checked;
                                const nuevoCodigo = (codigoEditable && codCell) ? (codCell.querySelector('input')?.value || '').trim() : undefined;

                                const entityId = fila.dataset.entityId;
                                const idProp = fila.dataset.idProp;

                                if (!entityId || !idProp) {
                                    alert('No se pudo determinar el ID del registro.');
                                    return;
                                }

                                const payload = {
                                    _tipo: selectListado.value,
                                    _descripcion: nuevaDescripcion,
                                    _active: nuevoActivo
                                };
                                // clave de ID que el backend espera, tal cual
                                payload[idProp] = toNumberIfPossible(entityId);

                                // Solo Planta envia _codigoSAPProgreso
                                if (codigoEditable) {
                                    payload._codigoSAPProgreso = nuevoCodigo ?? '';
                                }

                                fetch('/User/ActualizarElementoConfiguracion', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify(payload)
                                })
                                    .then(res => res.json())
                                    .then(res => {
                                        if (res.success) {
                                            if (successAlert) {
                                                successAlert.textContent = 'Actualizado correctamente';
                                                successAlert.style.display = 'block';
                                                setTimeout(() => { successAlert.style.display = 'none'; }, 2000);
                                            } else {
                                                alert('Actualizado correctamente');
                                            }
                                            selectListado.dispatchEvent(new Event('change'));
                                        } else {
                                            alert('Error al actualizar: ' + (res.message || ''));
                                        }
                                    })
                                    .catch(err => {
                                        console.error(err);
                                        alert('Error en la petición');
                                    });
                            });

                            // Cancelar
                            fila.querySelector('.btn-cancelar').addEventListener('click', function () {
                                selectListado.dispatchEvent(new Event('change'));
                            });
                        });
                    });
                })
                .catch(err => {
                    console.error(err);
                    contenedorListado.innerHTML = '<div class="text-danger">Error al cargar los datos.</div>';
                });
        });

        // Helpers
        function toNumberIfPossible(v) {
            const n = Number(v);
            return Number.isFinite(n) ? n : v;
        }
        function escapeHtml(str) {
            return String(str).replace(/[&<>"']/g, m => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[m]));
        }
        function escapeAttr(str) {
            return escapeHtml(str).replace(/`/g, '&#96;');
        }
    });


    (function () {
        function showLoading() {
            var m = document.getElementById('loadingModal');
            if (m) m.style.display = 'block';
        }
        function hideLoading() {
            var m = document.getElementById('loadingModal');
            if (m) m.style.display = 'none';
        }
        // expone helpers por si quieres usarlos en otros fetch
        window.showLoading = showLoading;
        window.hideLoading = hideLoading;

        // muestra lo antes posible (cuando el DOM ya esta parseado)
        document.addEventListener('readystatechange', function () {
            if (document.readyState === 'interactive') showLoading();
        });

        // oculta cuando ya cargo todo (assets incluidos)
        window.addEventListener('load', function () {
            setTimeout(hideLoading, 200);
        });

        // muestra al navegar/recargar (cuando cambias de pagina)
        window.addEventListener('beforeunload', function () {
            showLoading();
        });
    })();



</script>


